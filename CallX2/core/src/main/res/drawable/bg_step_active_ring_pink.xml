<?xml version="1.0" encoding="utf-8"?>
<!-- Spinning "in use" ring for a wizard step dot — Reel Photo Editor variant
     (vibrant magenta/pink). Same shape/thickness as bg_step_active_ring
     (green, Reel Upload) — only the sweep-gradient color differs. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="ring"
    android:innerRadiusRatio="2.9"
    android:thicknessRatio="10"
    android:useLevel="false">
    <gradient
        android:type="sweep"
        android:startColor="#00D500F9"
        android:centerColor="#80D500F9"
        android:endColor="#FFD500F9"/>
</shape>
