<?xml version="1.0" encoding="utf-8"?>
<!-- Spinning "in use" ring for a wizard step dot — Add Status variant (blue).
     Same shape/thickness as bg_step_active_ring (green, Reel Upload) — only
     the sweep-gradient color differs, so each wizard screen reads as its
     own screen at a glance. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="ring"
    android:innerRadiusRatio="2.9"
    android:thicknessRatio="10"
    android:useLevel="false">
    <gradient
        android:type="sweep"
        android:startColor="#002979FF"
        android:centerColor="#802979FF"
        android:endColor="#FF2979FF"/>
</shape>
