<?xml version="1.0" encoding="utf-8"?>
<!-- Advance Editing CTA — same pill shape/corner-radius as
     bg_trim_gradient_button (Continue/Post) so size and UI match exactly,
     but with a distinct blue→teal gradient so it never reads as the same
     action as Continue. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@color/advance_edit_gradient_start"
        android:endColor="@color/advance_edit_gradient_end"/>
    <corners android:radius="28dp"/>
</shape>
