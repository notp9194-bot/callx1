<?xml version="1.0" encoding="utf-8"?>
<!-- v951: flattened — 7 views / 3 levels (was 13 views / 4 levels).
     - story ring = background of the avatar host (no ring ImageView overlay, no overdraw)
     - direction icon = start compound drawable of tv_meta (no ImageView + row LinearLayout)
     - verified badge = end compound drawable of tv_name (no ImageView + row LinearLayout)
     - dead 0dp btn_video_call removed -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_call_row"
    android:clickable="true"
    android:focusable="true">

    <!-- Avatar (+ story ring as host background, set only when the ring state changes) -->
    <FrameLayout
        android:id="@+id/avatar_host"
        android:layout_width="50dp"
        android:layout_height="50dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_avatar"
            android:layout_width="43dp"
            android:layout_height="43dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_person"
            android:clickable="true"
            android:focusable="true"
            app:civ_border_width="0dp"/>
    </FrameLayout>

    <!-- Name + meta -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="13dp">

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:drawablePadding="3dp"/>

        <TextView
            android:id="@+id/tv_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:drawablePadding="4dp"/>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_call_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_phone"
        android:tint="@color/text_secondary"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:contentDescription="Voice call"/>

</LinearLayout>
