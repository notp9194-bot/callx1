<?xml version="1.0" encoding="utf-8"?>
<!-- v950: header slimmed. Selection bar / online panel / empty state are ViewStubs (inflated on first use),
     chips use one state-list bg + text colour (setSelected), dead tv_no_online removed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <ViewStub
        android:id="@+id/stub_selection_bar"
        android:inflatedId="@+id/ll_selection_bar"
        android:layout="@layout/calls_selection_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Search bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_search_bar"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            android:alpha="0.45"
            android:layout_marginEnd="10dp"/>

        <EditText
            android:id="@+id/et_search_calls"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="Search contacts"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:background="@null"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"/>

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_mic"
            android:alpha="0.5"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Filter chips: All / Missed / Contacts / Non-spam / Spam -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="All"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_calls_chip"
                android:textColor="@color/calls_chip_text"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/chip_missed"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Missed"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_calls_chip"
                android:textColor="@color/calls_chip_text"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/chip_contacts"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Contacts"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_calls_chip"
                android:textColor="@color/calls_chip_text"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/chip_nonspam"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Non-spam"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_calls_chip"
                android:textColor="@color/calls_chip_text"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/chip_spam"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Spam"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_calls_chip"
                android:textColor="@color/calls_chip_text"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Favorites + View contacts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Favorites ▾"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tv_view_contacts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View contacts"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:background="@drawable/chip_unselected"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <ViewStub
        android:id="@+id/stub_online_panel"
        android:inflatedId="@+id/ll_online_panel"
        android:layout="@layout/calls_online_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Divider above list -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider"/>

    <!-- Calls RecyclerView -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_calls"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="12dp"
            android:clipToPadding="false"/>

        <ViewStub
            android:id="@+id/stub_empty_calls"
            android:inflatedId="@+id/empty_calls"
            android:layout="@layout/calls_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>

</LinearLayout>
