<?xml version="1.0" encoding="utf-8"?>
<!-- v951: row bg = ripple normally, tint when activated (selection). setActivated() flips it —
     no setBackgroundColor (which replaced the ripple + allocated a ColorDrawable on every bind). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#335B5BF6"/>
        </shape>
    </item>
    <item android:drawable="?attr/selectableItemBackground"/>
</selector>
