<?xml version="1.0" encoding="utf-8"?>
<!-- Night counterpart of bg_follow_btn_adaptive — identical to the
     shared bg_follow_btn_premium_dark (translucent-white border), since
     that drawable was already tuned for a dark background. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="1.2dp" android:color="#B3FFFFFF"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="1.2dp" android:color="#80FFFFFF"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</selector>
