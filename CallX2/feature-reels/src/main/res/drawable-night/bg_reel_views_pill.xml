<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_reel_views_pill.xml — DARK MODE
    Light mode keeps the pill a dark translucent chip (bg_reel_views_pill.xml
    in drawable/, works over any thumbnail). In dark mode the pill flips to a
    frosted light chip instead, with tv_reel_views_overlay's text/icon
    (@color/reel_grid_views_text) switching to a dark tone to match.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E6F1F1F1"/>
    <corners android:radius="10dp"/>
    <stroke
        android:width="1dp"
        android:color="#33000000"/>
</shape>
