<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_reel_views_pill.xml — DARK MODE
    Light mode keeps the pill a white chip (bg_reel_views_pill.xml in
    drawable/) with dark icon/number text. In dark mode the pill flips to a
    black chip instead, with tv_reel_views_overlay's text/icon
    (@color/reel_grid_views_text) switching to white to match.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E6000000"/>
    <corners android:radius="6dp"/>
    <stroke
        android:width="1dp"
        android:color="#1AFFFFFF"/>
</shape>
