<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_bio_chip.xml — DARK MODE
    Mirrors bg_bio_chip.xml (light).
    ✅ CHANGED: fill is now transparent so each chip's background matches
    the screen's own dark background exactly — previously had a faint
    #0FFFFFFF tint. Hairline border kept so the chip stays visible against
    the dark surface.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent"/>
    <stroke android:width="0.75dp" android:color="#26FFFFFF"/>
    <corners android:radius="16dp"/>
</shape>
