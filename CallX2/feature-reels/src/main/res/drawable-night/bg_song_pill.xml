<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_song_pill.xml — DARK MODE
    Same premium thin-pill treatment as the light variant.
    ✅ CHANGED: fill is now transparent so the pill's background is exactly
    the screen's own background (?attr/colorSurface, dark) showing through
    — previously had a faint #0FFFFFFF tint. Hairline border kept so the
    pill shape stays visible against the dark surface.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent"/>
    <stroke android:width="0.75dp" android:color="#26FFFFFF"/>
    <corners android:radius="20dp"/>
</shape>
