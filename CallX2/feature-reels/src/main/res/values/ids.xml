<?xml version="1.0" encoding="utf-8"?>
<!--
    Explicit ID declarations for IDs referenced in Java code but defined
    only on views that may not always be inflated (e.g. optional overlays,
    close-friends UI, etc.).  Adding them here ensures R.id.xxx compiles
    even when the view is absent from the current layout.
-->
<resources>
    <!-- Close-friends ring / label — used by ReelUiController -->
    <item name="avatar_container"        type="id"/>
    <item name="tv_close_friends_label"  type="id"/>

    <!-- Collab user search row — used by CollabPostInviteActivity search adapter -->
    <item name="iv_collab_user_avatar"   type="id"/>
    <item name="tv_collab_user_name"     type="id"/>
    <item name="tv_collab_user_handle"   type="id"/>

    <!-- Sound detail bottom sheet — "See full page" button -->
    <item name="btn_see_full_page"       type="id"/>

    <!-- Reel player top-bar speed badge — removed from fragment_reel_player.xml
         (Speed action lives only in the 3-dot "More" menu now), but
         ReelPlayerController still holds a nullable reference to it. -->
    <item name="btn_speed"               type="id"/>

    <!-- ReelGridAdapter long-press "peek" gesture — tag key used to stash the
         pending peek-trigger Runnable on the grid cell's itemView so it can
         be cancelled from onViewRecycled() if the cell is recycled mid-touch
         (fast fling while a finger is still down elsewhere, multi-touch). -->
    <item name="tag_peek_runnable"        type="id"/>

    <!-- ReelCommentsAdapter avatar binding — two independent tag keys on the
         same CircleImageView: which uid the row's avatar is currently FOR
         (stale-async-callback guard when a row gets recycled mid-fetch) and
         which URL is already loaded/loading (skip redundant Glide calls on
         an unchanged rebind). -->
    <item name="tag_avatar_uid"           type="id"/>
    <item name="tag_avatar_url"           type="id"/>

    <!-- ReelUiController owner story ring — tag key to stash the already-
         built StoryRingGradientDrawable on iv_owner_story_ring so a rebind
         of the same view reuses the existing Drawable/Paint objects instead
         of allocating fresh ones (v43 perf pass). -->
    <item name="tag_story_ring_drawable"  type="id"/>
</resources>
