<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ReelMoreBottomSheet theme — dark #121212 bg, rounded top corners, dim overlay -->
    <style name="ReelMoreBottomSheetTheme" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/ReelMoreBottomSheetStyle</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>

    <style name="ReelMoreBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="shapeAppearanceOverlay">@style/ReelMoreShapeOverlay</item>
    </style>

    <style name="ReelMoreShapeOverlay">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <!-- ReelSoundQuickActionSheet theme — unlike ReelMoreBottomSheetTheme
         above (forced Light, hardcoded #121212 sheet bg — fine for the
         always-dark video player chrome it's used for), this sheet's own
         request was to follow the device/app day-night setting instead of
         being pinned dark. Parent is Theme.Material3.DayNight.BottomSheetDialog
         (not .Light) so it resolves against whichever mode is active, and
         bg_reel_sound_quick_sheet.xml (the sheet's root background) reads
         @color/surface_card, which already has a values-night override —
         no separate dark/light branching needed here beyond that. -->
    <style name="ReelSoundQuickActionSheetTheme" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/ReelSoundQuickActionSheetStyle</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>

    <style name="ReelSoundQuickActionSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="shapeAppearanceOverlay">@style/ReelMoreShapeOverlay</item>
    </style>

</resources>
