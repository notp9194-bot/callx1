    <!-- Reel grid gutter (the 1dp padding gap between grid thumbnails on
         UserReelsActivity) — white in light mode, black in dark mode
         (values-night/colors.xml), Instagram-style. Was hardcoded #FFFFFF
         before, which stayed white even in dark mode. -->
    <color name="reel_grid_gutter">#FFFFFF</color>

    <!-- "View All Reels" pill button (UserReelsActivity) — solid black
         pill with bright green text/icon, same in light & dark mode by
         design (it floats over the reel thumbnails, not app chrome).
         view_all_reels_bg darkened slightly off pure black + a thin
         translucent green stroke for a "premium" outlined-chip look. -->
    <color name="view_all_reels_bg">#0D0D0D</color>
    <color name="view_all_reels_ripple">#3300F260</color>
    <color name="view_all_reels_stroke">#4D00F260</color>

    <!-- ── Modern Reels bottom nav (see bg_reel_bottom_nav.xml / shape_reel_nav.xml) ── -->
    <!-- Translucent brand-tinted pill behind the selected tab's icon. -->
    <color name="reel_nav_indicator">#3D5B5BF6</color>
    <!-- Full-opacity icon color for the selected tab. -->
    <color name="reel_nav_icon_selected">#FFFFFFFF</color>
    <!-- Dimmed icon color for unselected tabs — the "modern" muted-vs-highlighted
         contrast in place of every icon being the same flat white. -->
    <color name="reel_nav_icon_unselected">#8CFFFFFF</color>

    <!-- ── ReelPhotoMusicTrimActivity ("Adjust Music") — Light Mode ── -->
    <!-- Brand gradient used for the trim handles / selected waveform range /
         "Use this audio" CTA — same two accent colors already used elsewhere
         in this screen (FF3B5C pink → A855F7 purple), same in both modes. -->
    <color name="trim_gradient_start">#FF3B5C</color>
    <color name="trim_gradient_end">#A855F7</color>
    <color name="trim_screen_bg">#FFFFFF</color>
    <color name="trim_card_bg">#F6F6F9</color>
    <color name="trim_subcard_bg">#FFFFFF</color>
    <color name="trim_divider">#E3E3EA</color>
    <color name="trim_text_primary">#14141A</color>
    <color name="trim_text_secondary">#6B6B76</color>
    <color name="trim_text_muted">#9A9AA4</color>
    <color name="trim_photo_placeholder">#ECECF1</color>
    <color name="trim_waveform_dim">#D6D6DE</color>
    <color name="trim_chip_bg">#FFFFFF</color>
    <color name="trim_chip_stroke">#DCDCE4</color>
    <color name="trim_chip_selected_bg">#1AFF3B5C</color>
    <color name="trim_circle_btn_bg">#14000000</color>
    <color name="trim_circle_btn_bg_on_photo">#4D000000</color>
    <color name="trim_tooltip_bg">#E6141420</color>
    <color name="trim_tooltip_text">#FFFFFF</color>

    <!-- X (Twitter) badge glyph — dark on the light-mode surface fill,
         white on the night solid-black badge (see bg_social_x_btn_adaptive). -->
    <color name="x_logo_tint">#0F1419</color>
