<?xml version="1.0" encoding="utf-8"?>
  <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
      xmlns:tools="http://schemas.android.com/tools"
      android:layout_width="match_parent" android:layout_height="64dp"
      android:orientation="horizontal" android:gravity="center_vertical"
      android:paddingHorizontal="16dp" android:paddingVertical="8dp">

      <!-- Avatar + story ring (same gradient/seen/hidden ring HomeFragment's
           feed post avatar and Stories tray already use — see StoryRingApplier) -->
      <FrameLayout
          android:layout_width="48dp"
          android:layout_height="48dp">

          <ImageView
              android:id="@+id/iv_story_ring"
              android:layout_width="48dp"
              android:layout_height="48dp"
              android:visibility="gone"
              tools:ignore="ContentDescription"/>

          <ImageView android:id="@+id/iv_invite_avatar"
              android:layout_width="44dp" android:layout_height="44dp"
              android:layout_gravity="center"
              android:src="@drawable/ic_person"/>
      </FrameLayout>

      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
          <TextView android:id="@+id/tv_invite_name"
              android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
          <TextView android:id="@+id/tv_invite_username"
              android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:textColor="#888888" android:textSize="13sp"/>
      </LinearLayout>

      <Button android:id="@+id/btn_send_invite"
          android:layout_width="80dp" android:layout_height="34dp"
          android:text="Invite" android:textColor="#000000"
          android:backgroundTint="#FFD700" android:textSize="13sp"/>
  </LinearLayout>