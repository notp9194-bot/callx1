<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <ImageView
        android:id="@+id/iv_thumb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/rc_bg_tile"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="4:5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <View
        android:id="@+id/v_scrim"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/rc_bg_scrim_bottom"
        app:layout_constraintBottom_toBottomOf="@id/iv_thumb"
        app:layout_constraintEnd_toEndOf="@id/iv_thumb"
        app:layout_constraintStart_toStartOf="@id/iv_thumb"/>

    <TextView
        android:id="@+id/tv_likes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:drawableStart="@drawable/ic_heart"
        android:drawablePadding="4dp"
        android:drawableTint="#FFFFFF"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/iv_thumb"
        app:layout_constraintStart_toStartOf="@id/iv_thumb"/>

    <TextView
        android:id="@+id/tv_owner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_thumb"
        app:layout_constraintEnd_toEndOf="@id/iv_thumb"
        app:layout_constraintStart_toEndOf="@id/tv_likes"
        android:gravity="end"/>

    <ImageView
        android:id="@+id/iv_check"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_margin="8dp"
        android:background="@drawable/rc_bg_check_on"
        android:padding="5dp"
        android:src="@drawable/rc_ic_check"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/iv_thumb"
        app:layout_constraintTop_toTopOf="@id/iv_thumb"/>

    <View
        android:id="@+id/v_selected_ring"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/rc_bg_ring"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/iv_thumb"
        app:layout_constraintEnd_toEndOf="@id/iv_thumb"
        app:layout_constraintStart_toStartOf="@id/iv_thumb"
        app:layout_constraintTop_toTopOf="@id/iv_thumb"/>
</androidx.constraintlayout.widget.ConstraintLayout>
