<?xml version="1.0" encoding="utf-8"?>
<!--
  Related-sounds row for SoundDetailActivity.RelatedAdapter.

  Mirrors, dp-for-dp, what onCreateViewHolder() used to build in code:
  120x80 vertical LinearLayout -> 80x80 ImageView (centerCrop) -> single
  -line 11sp TextView. Inflating this once per view-type is faster than
  constructing three View objects (with manual density math) on every
  onCreateViewHolder() call, and it's a lot easier to tweak/skin later.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="120dp"
    android:layout_height="80dp"
    android:paddingLeft="4px"
    android:paddingTop="2px"
    android:paddingRight="4px"
    android:paddingBottom="2px">

    <ImageView
        android:id="@+id/iv_related_row_cover"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"/>

    <TextView
        android:id="@+id/tv_related_row_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"/>

</LinearLayout>
