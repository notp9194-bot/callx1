<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/trim_screen_bg">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btn_editor_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/trim_text_primary"
            android:contentDescription="Back"/>

        <TextView
            android:id="@+id/tv_editor_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit Reel"
            android:textColor="@color/trim_text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"/>

        <TextView
            android:id="@+id/btn_editor_next"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Done"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="@drawable/bg_trim_gradient_button_ripple"/>
    </LinearLayout>

    <!-- Video Preview (9:16 aspect) -->
    <!-- ✅ FIX: rounded corners now hug the ACTUAL video rect instead of the whole
         placeholder box. Previously the outer FrameLayout always filled the full
         weighted area, so a video whose aspect ratio didn't match that area (e.g.
         a non-9:16 clip) showed rounded corners on empty black letterbox space
         while the video itself stayed square inside. Fix: an outer, unrounded
         FrameLayout now just centers the content; the rounded/clipped inner
         FrameLayout (video_preview_container) is resized in Java at runtime —
         once the real video width/height is known from the player — to exactly
         match the video's own aspect ratio, so the rounded corners sit directly
         on the video's edges in whatever ratio the video actually is. -->
    <FrameLayout
        android:id="@+id/video_preview_outer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

    <FrameLayout
        android:id="@+id/video_preview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_margin="10dp"
        android:background="@drawable/bg_reel_preview_rounded"
        android:clipToOutline="true">

        <!-- ✅ FIX: surface_type="texture_view" — SurfaceView (the media3 default)
             renders on its own hardware layer and ignores the parent's
             clipToOutline/rounded background, so the video itself stayed
             square even though the container behind it was rounded.
             TextureView draws as a normal view in the hierarchy, so the
             rounded corners now actually clip the video content. -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/editor_player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:resize_mode="fit"
            app:surface_type="texture_view"/>

        <!-- Buffering -->
        <ProgressBar
            android:id="@+id/editor_progress_buffering"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFF"
            android:visibility="gone"/>

        <!-- Play/Pause — upgraded to the shared premium gradient circle
             (@drawable/bg_premium_circle_button, now in :core so other
             screens can reuse the same CTA), with elevation for a real
             drop shadow and full-opacity white icon so it reads clearly
             on the gradient. -->
        <ImageButton
            android:id="@+id/btn_editor_play_pause"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_pause"
            android:background="@drawable/bg_premium_circle_button"
            android:tint="#FFFFFFFF"
            android:elevation="6dp"
            android:padding="16dp"
            android:contentDescription="Play/Pause"/>

        <!-- ✅ ADVANCED: the old single static tv_text_preview is gone — Step 2
             now supports any number of draggable/pinch-to-scale/rotate text
             overlays, added dynamically as styled TextViews onto this same
             FrameLayout (see ReelEditorActivity#createAdvancedTextOverlay). -->

        <!-- Drag-to-delete zone shown only while a text overlay is being dragged. -->
        <TextView
            android:id="@+id/tv_text_trash_zone"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:text="🗑"
            android:textSize="24sp"
            android:gravity="center"
            android:background="@drawable/bg_premium_circle_button"
            android:visibility="gone"
            android:elevation="8dp"/>
    </FrameLayout>
    </FrameLayout>


    <!-- ── Card panel (reused from ReelAudioMixerActivity's bg_trim_card —
         rounded-top-corner bottom panel, now shared via :core) — wraps the
         step indicator + editing-tools ViewFlipper + step-nav bar so the
         whole editing-tools area below the preview reads as one card,
         same visual language as the Audio Mixer screen. ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_trim_card">

    <!-- ── Editing-tools step indicator ──────────────────────────────────
         Reused from the Add Status / Reel Upload screens' dot-stepper UI
         (same bg_trim_gradient_button / bg_trim_circle_btn drawables from
         :core, same active/inactive coloring logic) instead of the old
         thin horizontal pb_editor_step ProgressBar — same numbered-circle +
         connecting-line look, just 5 dots here (this wizard has 5 steps:
         Trim → Text → Look → Motion & Sound → Finishing). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- ✅ "Step X of Y" strip: shared premium gradient pill
             (@drawable/bg_step_indicator_pill, in :core) + an uppercase step-name
             label (tv_editor_step_name) shown after the pill, no background of its
             own, sized bigger than the (now smaller) pill text so it reads as the
             headline and the pill reads as a small status chip. Pill padding/text
             size come from @dimen/step_pill_* in :core, so resizing the pill here
             applies to Reel Upload / Add Status / Photo Editor too. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_editor_step_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 1 of 5"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/step_pill_text_size"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:background="@drawable/bg_step_indicator_pill"
                android:paddingStart="@dimen/step_pill_padding_h"
                android:paddingEnd="@dimen/step_pill_padding_h"
                android:paddingTop="@dimen/step_pill_padding_v"
                android:paddingBottom="@dimen/step_pill_padding_v"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tv_editor_step_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Trim and Crop"
                android:textAllCaps="true"
                android:textColor="@color/trim_text_primary"
                android:textSize="@dimen/step_name_text_size"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/editor_stepper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageView
                    android:id="@+id/step_ring_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_step_active_ring_orange"
                    android:contentDescription="@null"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/step_dot_1"
                    android:layout_gravity="center"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:text="1"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:background="@drawable/bg_trim_gradient_button"/>
            </FrameLayout>
            <View
                android:id="@+id/step_line_1"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@color/trim_divider"/>
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageView
                    android:id="@+id/step_ring_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_step_active_ring_orange"
                    android:contentDescription="@null"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/step_dot_2"
                    android:layout_gravity="center"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:text="2"
                    android:textSize="11sp"
                    android:textColor="@color/trim_text_secondary"
                    android:textStyle="bold"
                    android:background="@drawable/bg_trim_circle_btn"/>
            </FrameLayout>
            <View
                android:id="@+id/step_line_2"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@color/trim_divider"/>
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageView
                    android:id="@+id/step_ring_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_step_active_ring_orange"
                    android:contentDescription="@null"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/step_dot_3"
                    android:layout_gravity="center"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:text="3"
                    android:textSize="11sp"
                    android:textColor="@color/trim_text_secondary"
                    android:textStyle="bold"
                    android:background="@drawable/bg_trim_circle_btn"/>
            </FrameLayout>
            <View
                android:id="@+id/step_line_3"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@color/trim_divider"/>
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageView
                    android:id="@+id/step_ring_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_step_active_ring_orange"
                    android:contentDescription="@null"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/step_dot_4"
                    android:layout_gravity="center"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:text="4"
                    android:textSize="11sp"
                    android:textColor="@color/trim_text_secondary"
                    android:textStyle="bold"
                    android:background="@drawable/bg_trim_circle_btn"/>
            </FrameLayout>
            <View
                android:id="@+id/step_line_4"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@color/trim_divider"/>
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageView
                    android:id="@+id/step_ring_5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_step_active_ring_orange"
                    android:contentDescription="@null"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/step_dot_5"
                    android:layout_gravity="center"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:text="5"
                    android:textSize="11sp"
                    android:textColor="@color/trim_text_secondary"
                    android:textStyle="bold"
                    android:background="@drawable/bg_trim_circle_btn"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Editor controls -->
    <ViewFlipper
        android:id="@+id/editor_step_flipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ═══════ STEP 1 · TRIM ═══════ -->
        <LinearLayout
            android:id="@+id/editor_step_trim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Trim & Crop section header + Crop button
             ✅ NEW: Crop button reuses Chat's Media Editing screen crop feature
             (core's MediaCropActivity — same crop screen, aspect chips, and
             drag handles as btnEditCrop in MediaEditActivity) so Step 1 now
             covers both trimming the clip and cropping its framing. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TRIM AND CROP"
                android:textColor="@color/trim_text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"/>

            <LinearLayout
                android:id="@+id/btn_editor_crop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_reel_editor_tool_chip"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_editor_crop"
                    android:contentDescription="@null"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Crop"
                    android:textColor="@color/trim_text_primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_editor_trim_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="@color/trim_text_secondary"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tv_editor_trim_end"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:30"
                android:textColor="@color/trim_text_secondary"
                android:textSize="12sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/tv_editor_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:30"
                android:textColor="@color/trim_text_secondary"
                android:textSize="12sp"
                android:gravity="end"/>
        </LinearLayout>

        <com.callx.app.views.VideoTrimFilmstripView
            android:id="@+id/trim_filmstrip_view"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"/>

        </LinearLayout>
        <!-- ═══════ /STEP 1 ═══════ -->

        <!-- ═══════ STEP 2 · TEXT OVERLAY (ULTRA ADVANCED) ═══════ -->
        <LinearLayout
            android:id="@+id/editor_step_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Text overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/trim_divider"
            android:layout_marginVertical="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TEXT OVERLAY"
                android:textColor="@color/trim_text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"/>

            <TextView
                android:id="@+id/btn_delete_text_overlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗑 Delete"
                android:textColor="#FF6B6B"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"
                android:padding="4dp"/>
        </LinearLayout>

        <!-- Text input row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/et_text_overlay"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="Add text to video..."
                android:textColorHint="@color/trim_text_muted"
                android:textColor="@color/trim_text_primary"
                android:background="@drawable/bg_comment_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"/>

            <!-- ✅ NEW: Settings button — moves the font / style / align / bg /
                 colour / size controls out of this card into a bottom sheet
                 (see bottom_sheet_text_overlay_style.xml + openTextOverlayStyleSheet()),
                 reusing the same BottomSheetDialog mechanism the sticker picker
                 sheet is built on. Keeps Step 2's card panel the same compact
                 height as every other step, instead of growing tall and
                 shrinking the video preview. -->
            <ImageButton
                android:id="@+id/btn_text_overlay_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_editor_text_settings"
                android:scaleType="center"
                android:padding="9dp"
                android:background="@drawable/bg_reel_editor_tool_chip"
                android:contentDescription="Text style settings"/>

            <TextView
                android:id="@+id/btn_add_text"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:text="Add"
                android:gravity="center"
                android:textColor="@color/brand_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pinch to resize &amp; rotate  •  Drag to move  •  Drag to 🗑 to delete"
            android:textColor="@color/trim_text_muted"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginTop="10dp"/>

        </LinearLayout>
        <!-- ═══════ /STEP 2 ═══════ -->

        <!-- ═══════ STEP 3 · TOOLS · Filters / Stickers / Subtitles ═══════ -->
        <LinearLayout
            android:id="@+id/editor_step_tools_a"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="EDITING TOOLS · Look" android:textColor="@color/trim_text_secondary" android:textSize="11sp"
                android:fontFamily="sans-serif-medium" android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center" android:weightSum="3">

                <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                    <ImageButton android:id="@+id/btn_tool_filters" android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_filter"
            android:tint="#A855F7" android:background="@drawable/bg_reel_editor_tool_chip" android:contentDescription="Filters"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Filters" android:textColor="@color/trim_text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                    <ImageButton android:id="@+id/btn_tool_stickers" android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_sparkle"
            android:tint="#FFD700" android:background="@drawable/bg_reel_editor_tool_chip" android:contentDescription="Stickers"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Stickers" android:textColor="@color/trim_text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                    <ImageButton android:id="@+id/btn_tool_subtitles" android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_caption" android:background="@drawable/bg_reel_editor_tool_chip"
                        android:tint="@color/trim_text_primary" android:contentDescription="Subtitles"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Subtitles" android:textColor="@color/trim_text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
        <!-- ═══════ /STEP 3 ═══════ -->

        <!-- ═══════ STEP 4 · TOOLS · Transitions / Voice FX / Audio Mixer ═══════ -->
        <LinearLayout
            android:id="@+id/editor_step_tools_b"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="EDITING TOOLS · Motion &amp; Sound" android:textColor="@color/trim_text_secondary" android:textSize="11sp"
                android:fontFamily="sans-serif-medium" android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center" android:weightSum="3">

                <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                    <ImageButton android:id="@+id/btn_tool_transitions" android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_swap"
            android:tint="#A855F7" android:background="@drawable/bg_reel_editor_tool_chip" android:contentDescription="Transitions"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Transitions" android:textColor="@color/trim_text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                    <ImageButton android:id="@+id/btn_tool_voice" android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_mic" android:background="@drawable/bg_reel_editor_tool_chip"
                        android:tint="@color/trim_text_primary" android:contentDescription="Voice FX"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Voice FX" android:textColor="@color/trim_text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                    <ImageButton android:id="@+id/btn_tool_audio_mixer" android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_music"
            android:tint="#00E5FF" android:background="@drawable/bg_reel_editor_tool_chip" android:contentDescription="Audio Mixer"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Audio Mix" android:textColor="@color/trim_text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
        <!-- ═══════ /STEP 4 ═══════ -->

        <!-- ═══════ STEP 5 · TOOLS · Thumbnail / Music ═══════ -->
        <LinearLayout
            android:id="@+id/editor_step_tools_c"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="EDITING TOOLS · Finishing" android:textColor="@color/trim_text_secondary" android:textSize="11sp"
                android:fontFamily="sans-serif-medium" android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center" android:weightSum="3">

                <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center">
                    <ImageButton android:id="@+id/btn_tool_thumbnail" android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_gallery" android:background="@drawable/bg_reel_editor_tool_chip"
                        android:tint="@color/trim_text_primary" android:contentDescription="Thumbnail"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Thumbnail" android:textColor="@color/trim_text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:layout_marginStart="8dp">
                    <ImageButton android:id="@+id/btn_tool_music" android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_music" android:background="@drawable/bg_reel_editor_tool_chip"
                        android:tint="#FF3B5C" android:contentDescription="Music"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Music" android:textColor="@color/trim_text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
        <!-- ═══════ /STEP 5 ═══════ -->

    </ViewFlipper>

    <!-- ── Fixed bottom step-nav bar for the editing-tools wizard (separate
         from the top-right "Next" which moves on to Upload) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="14dp">

        <Button
            android:id="@+id/btn_editor_step_back"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Back"
            android:textColor="@color/trim_text_primary"
            android:backgroundTint="@color/trim_chip_bg"
            android:visibility="invisible"/>

        <Button
            android:id="@+id/btn_editor_step_next"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Next"
            android:textColor="#FFFFFF"
            android:drawableEnd="@drawable/ic_arrow_forward"
            android:drawableTint="#FFFFFF"
            android:drawablePadding="6dp"
            android:backgroundTint="@color/brand_primary"/>
    </LinearLayout>

    </LinearLayout>

</LinearLayout>
