<?xml version="1.0" encoding="utf-8"?>
<!-- ✅ INSTAGRAM-STYLE REDESIGN: the old version of this screen was a single
     vertical column — a fixed-height video box on top, then a numbered
     "Step 1 of 5 / Trim → Text → Look → Motion & Sound → Finishing" wizard
     card below it, with its own Back/Next buttons and a dot-stepper. New
     testers found that wizard confusing (it reads like a form, and hides
     most of the video while editing). This screen now follows the same
     pattern Instagram/Reels-style editors use:
       • the video preview runs edge-to-edge, full screen, at all times —
         so every tool's effect is visible live, in place, immediately
       • the 5 tool groups (still the same underlying steps — trim, text,
         look, motion & sound, finishing) are exposed as a single column of
         round icon buttons fixed to the right edge, instead of a linear
         Back/Next wizard — tap any icon to jump straight to that tool
       • that tool's controls slide up as a compact panel anchored to the
         bottom edge, over the video, instead of pushing the video into a
         small box
     All of the underlying step content (trim filmstrip, text input, filter/
     sticker/subtitle chips, transitions/voice/audio-mix chips, thumbnail/
     music chips) is unchanged — same views, same ids — only the surrounding
     chrome (stepper dots, Back/Next bar, fixed-height video box) is gone,
     since the rail on the right replaces it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/trim_screen_bg">

    <!-- ══════════════════ Full-screen live video preview ══════════════════ -->
    <FrameLayout
        android:id="@+id/video_preview_outer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">

    <FrameLayout
        android:id="@+id/video_preview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_margin="10dp"
        android:background="@drawable/bg_reel_preview_rounded"
        android:clipToOutline="true">

        <!-- ✅ FIX: surface_type="texture_view" — SurfaceView (the media3 default)
             renders on its own hardware layer and ignores the parent's
             clipToOutline/rounded background, so the video itself stayed
             square even though the container behind it was rounded.
             TextureView draws as a normal view in the hierarchy, so the
             rounded corners now actually clip the video content. -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/editor_player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:resize_mode="fit"
            app:surface_type="texture_view"/>

        <!-- Buffering -->
        <ProgressBar
            android:id="@+id/editor_progress_buffering"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFF"
            android:visibility="gone"/>

        <!-- Play/Pause — upgraded to the shared premium gradient circle
             (@drawable/bg_premium_circle_button, now in :core so other
             screens can reuse the same CTA), with elevation for a real
             drop shadow and full-opacity white icon so it reads clearly
             on the gradient. -->
        <ImageButton
            android:id="@+id/btn_editor_play_pause"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_pause"
            android:background="@drawable/bg_premium_circle_button"
            android:tint="#FFFFFFFF"
            android:elevation="6dp"
            android:padding="16dp"
            android:contentDescription="Play/Pause"/>

        <!-- ✅ ADVANCED: the old single static tv_text_preview is gone — Step 2
             now supports any number of draggable/pinch-to-scale/rotate text
             overlays, added dynamically as styled TextViews onto this same
             FrameLayout (see ReelEditorActivity#createAdvancedTextOverlay). -->

        <!-- Drag-to-delete zone shown only while a text overlay is being dragged. -->
        <TextView
            android:id="@+id/tv_text_trash_zone"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:text="🗑"
            android:textSize="24sp"
            android:gravity="center"
            android:background="@drawable/bg_premium_circle_button"
            android:visibility="gone"
            android:elevation="8dp"/>
    </FrameLayout>
    </FrameLayout>

    <!-- ══════════════════ Top overlay bar (back / Done) ══════════════════ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_editor_top_scrim"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btn_editor_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF"
            android:contentDescription="Back"/>

        <!-- ✅ Title is kept (Java still sets "Edit Reel" / "Edit Status" /
             "Edit video" on it via tv_editor_title) but hidden — Instagram's
             own editor doesn't show a title bar, just back + Done, now that
             the current tool is already named on the bottom panel. -->
        <TextView
            android:id="@+id/tv_editor_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone"
            android:text="Edit Reel"
            android:textColor="#FFFFFF"
            android:textSize="18sp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/btn_editor_next"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Done"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="@drawable/bg_trim_gradient_button_ripple"/>
    </LinearLayout>

    <!-- ══════════════════ Right-edge vertical tool rail ══════════════════
         Instagram-style: one column of round icon buttons, vertically
         centered on the right edge, floating directly over the live video.
         Tapping an icon opens that tool's panel at the bottom (see
         goToEditorStep() / updateEditorRailUi() in ReelEditorActivity) —
         the currently-open tool's icon is filled with the brand gradient
         (bg_editor_rail_icon_active), every other icon stays a plain
         translucent disc (bg_editor_rail_icon). -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="22dp">
            <ImageButton
                android:id="@+id/rail_icon_trim"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_editor_crop"
                android:scaleType="center"
                android:padding="12dp"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_editor_rail_icon"
                android:contentDescription="Trim and crop"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Trim"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#B0000000"
                android:shadowRadius="4"
                android:shadowDx="0"
                android:shadowDy="0"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="22dp">
            <ImageButton
                android:id="@+id/rail_icon_text"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_status_btn_text"
                android:scaleType="center"
                android:padding="12dp"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_editor_rail_icon"
                android:contentDescription="Text overlay"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Text"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#B0000000"
                android:shadowRadius="4"
                android:shadowDx="0"
                android:shadowDy="0"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="22dp">
            <ImageButton
                android:id="@+id/rail_icon_look"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_filter"
                android:scaleType="center"
                android:padding="12dp"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_editor_rail_icon"
                android:contentDescription="Filters, stickers and subtitles"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Look"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#B0000000"
                android:shadowRadius="4"
                android:shadowDx="0"
                android:shadowDy="0"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="22dp">
            <ImageButton
                android:id="@+id/rail_icon_sound"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_music"
                android:scaleType="center"
                android:padding="12dp"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_editor_rail_icon"
                android:contentDescription="Transitions, voice effects and audio mix"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sound"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#B0000000"
                android:shadowRadius="4"
                android:shadowDx="0"
                android:shadowDy="0"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <ImageButton
                android:id="@+id/rail_icon_finish"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_gallery"
                android:scaleType="center"
                android:padding="12dp"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_editor_rail_icon"
                android:contentDescription="Thumbnail and music"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Finish"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#B0000000"
                android:shadowRadius="4"
                android:shadowDx="0"
                android:shadowDy="0"/>
        </LinearLayout>

    </LinearLayout>

    <!-- ══════════════════ Bottom tool panel (floats over the video) ══════════════════
         Compact card anchored to the bottom edge instead of a fixed-height
         section that pushes the video preview up — the video stays visible
         and live everywhere above/around this panel while a tool is open. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_trim_card">

        <!-- Drag-handle affordance (decorative) -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@color/trim_divider"/>

        <!-- ✅ Kept as hidden 0dp views purely so their R.id constants still
             exist (Java's setupEditorStepWizard()/onCreate() still call
             findViewById(R.id...) on these — always null-checked before use,
             so they're harmless no-ops now, but the symbols must exist for
             the module to compile). The rail + this panel's own tool-name
             label replace what these used to show. -->
        <TextView
            android:id="@+id/tv_editor_step_title"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>
        <Button
            android:id="@+id/btn_editor_step_back"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>
        <Button
            android:id="@+id/btn_editor_step_next"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>

        <!-- Current tool name — same tv_editor_step_name Java already updates
             on every goToEditorStep() call (see updateEditorStepUi()); the
             numbered "Step X of 5" pill is gone since the rail on the right
             is now the primary navigation, not a linear sequence. -->
        <TextView
            android:id="@+id/tv_editor_step_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="Trim and Crop"
            android:textAllCaps="true"
            android:textColor="@color/trim_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:fontFamily="sans-serif-medium"/>

    <ViewFlipper
        android:id="@+id/editor_step_flipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ═══════ STEP 1 · TRIM ═══════ -->
        <LinearLayout
            android:id="@+id/editor_step_trim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Trim & Crop section header + Crop button
             ✅ NEW: Crop button reuses Chat's Media Editing screen crop feature
             (core's MediaCropActivity — same crop screen, aspect chips, and
             drag handles as btnEditCrop in MediaEditActivity) so Step 1 now
             covers both trimming the clip and cropping its framing. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TRIM AND CROP"
                android:textColor="@color/trim_text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"/>

            <LinearLayout
                android:id="@+id/btn_editor_crop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_reel_editor_crop_chip"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_editor_crop"
                    android:contentDescription="@null"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Crop"
                    android:textColor="@color/trim_text_primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_editor_trim_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="@color/trim_text_secondary"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tv_editor_trim_end"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:30"
                android:textColor="@color/trim_text_secondary"
                android:textSize="12sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/tv_editor_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:30"
                android:textColor="@color/trim_text_secondary"
                android:textSize="12sp"
                android:gravity="end"/>
        </LinearLayout>

        <com.callx.app.views.VideoTrimFilmstripView
            android:id="@+id/trim_filmstrip_view"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"/>

        </LinearLayout>
        <!-- ═══════ /STEP 1 ═══════ -->

        <!-- ═══════ STEP 2 · TEXT OVERLAY (ULTRA ADVANCED) ═══════ -->
        <LinearLayout
            android:id="@+id/editor_step_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Text overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/trim_divider"
            android:layout_marginVertical="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TEXT OVERLAY"
                android:textColor="@color/trim_text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"/>

            <TextView
                android:id="@+id/btn_delete_text_overlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗑 Delete"
                android:textColor="#FF6B6B"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"
                android:padding="4dp"/>
        </LinearLayout>

        <!-- Text input row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/et_text_overlay"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="Add text to video..."
                android:textColorHint="@color/trim_text_muted"
                android:textColor="@color/trim_text_primary"
                android:background="@drawable/bg_comment_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"/>

            <!-- ✅ NEW: Settings button — moves the font / style / align / bg /
                 colour / size controls out of this card into a bottom sheet
                 (see bottom_sheet_text_overlay_style.xml + openTextOverlayStyleSheet()),
                 reusing the same BottomSheetDialog mechanism the sticker picker
                 sheet is built on. Keeps Step 2's card panel the same compact
                 height as every other step, instead of growing tall and
                 shrinking the video preview. -->
            <ImageButton
                android:id="@+id/btn_text_overlay_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_editor_text_settings"
                android:scaleType="center"
                android:padding="9dp"
                android:background="@drawable/bg_reel_editor_tool_chip"
                android:contentDescription="Text style settings"/>

            <TextView
                android:id="@+id/btn_add_text"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:text="Add"
                android:gravity="center"
                android:textColor="@color/brand_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pinch to resize &amp; rotate  •  Drag to move  •  Drag to 🗑 to delete"
            android:textColor="@color/trim_text_muted"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginTop="10dp"/>

        </LinearLayout>
        <!-- ═══════ /STEP 2 ═══════ -->

        <!-- ═══════ STEP 3 · TOOLS · Filters / Stickers / Subtitles ═══════ -->
        <LinearLayout
            android:id="@+id/editor_step_tools_a"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="EDITING TOOLS · Look" android:textColor="@color/trim_text_secondary" android:textSize="11sp"
                android:fontFamily="sans-serif-medium" android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center" android:weightSum="3">

                <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                    <ImageButton android:id="@+id/btn_tool_filters" android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_filter"
            android:tint="#A855F7" android:background="@drawable/bg_reel_editor_tool_chip" android:contentDescription="Filters"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Filters" android:textColor="@color/trim_text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                    <ImageButton android:id="@+id/btn_tool_stickers" android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_sparkle"
            android:tint="#FFD700" android:background="@drawable/bg_reel_editor_tool_chip" android:contentDescription="Stickers"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Stickers" android:textColor="@color/trim_text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                    <ImageButton android:id="@+id/btn_tool_subtitles" android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_caption" android:background="@drawable/bg_reel_editor_tool_chip"
                        android:tint="@color/trim_text_primary" android:contentDescription="Subtitles"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Subtitles" android:textColor="@color/trim_text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
        <!-- ═══════ /STEP 3 ═══════ -->

        <!-- ═══════ STEP 4 · TOOLS · Transitions / Voice FX / Audio Mixer ═══════ -->
        <LinearLayout
            android:id="@+id/editor_step_tools_b"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="EDITING TOOLS · Motion &amp; Sound" android:textColor="@color/trim_text_secondary" android:textSize="11sp"
                android:fontFamily="sans-serif-medium" android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center" android:weightSum="3">

                <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                    <ImageButton android:id="@+id/btn_tool_transitions" android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_swap"
            android:tint="#A855F7" android:background="@drawable/bg_reel_editor_tool_chip" android:contentDescription="Transitions"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Transitions" android:textColor="@color/trim_text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                    <ImageButton android:id="@+id/btn_tool_voice" android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_mic" android:background="@drawable/bg_reel_editor_tool_chip"
                        android:tint="@color/trim_text_primary" android:contentDescription="Voice FX"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Voice FX" android:textColor="@color/trim_text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                    <ImageButton android:id="@+id/btn_tool_audio_mixer" android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_music"
            android:tint="#00E5FF" android:background="@drawable/bg_reel_editor_tool_chip" android:contentDescription="Audio Mixer"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Audio Mix" android:textColor="@color/trim_text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
        <!-- ═══════ /STEP 4 ═══════ -->

        <!-- ═══════ STEP 5 · TOOLS · Thumbnail / Music ═══════ -->
        <LinearLayout
            android:id="@+id/editor_step_tools_c"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="EDITING TOOLS · Finishing" android:textColor="@color/trim_text_secondary" android:textSize="11sp"
                android:fontFamily="sans-serif-medium" android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center" android:weightSum="3">

                <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center">
                    <ImageButton android:id="@+id/btn_tool_thumbnail" android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_gallery" android:background="@drawable/bg_reel_editor_tool_chip"
                        android:tint="@color/trim_text_primary" android:contentDescription="Thumbnail"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Thumbnail" android:textColor="@color/trim_text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:layout_marginStart="8dp">
                    <ImageButton android:id="@+id/btn_tool_music" android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_music" android:background="@drawable/bg_reel_editor_tool_chip"
                        android:tint="#FF3B5C" android:contentDescription="Music"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Music" android:textColor="@color/trim_text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
        <!-- ═══════ /STEP 5 ═══════ -->

    </ViewFlipper>

    </LinearLayout>

</FrameLayout>
