<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp" android:background="@color/dialog_surface">
    <EditText android:id="@+id/et_collab_to_username" android:layout_width="match_parent"
        android:layout_height="48dp" android:hint="@username" android:textColor="@color/dialog_text_primary"
        android:textColorHint="@color/dialog_text_secondary" android:background="@drawable/bg_search_field"
        android:paddingHorizontal="12dp" android:inputType="text" android:layout_marginBottom="12dp"/>
    <Spinner android:id="@+id/sp_collab_type" android:layout_width="match_parent"
        android:layout_height="48dp" android:layout_marginBottom="12dp"/>
    <EditText android:id="@+id/et_collab_message" android:layout_width="match_parent"
        android:layout_height="88dp" android:hint="Personal message (optional)"
        android:textColor="@color/dialog_text_primary" android:textColorHint="@color/dialog_text_secondary"
        android:background="@drawable/bg_search_field" android:padding="12dp"
        android:inputType="textMultiLine" android:gravity="top"/>
</LinearLayout>
