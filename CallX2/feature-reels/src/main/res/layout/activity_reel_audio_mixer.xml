<?xml version="1.0" encoding="utf-8"?>
<!--
  ReelAudioMixerActivity — modern redesign, matching ReelPhotoMusicTrimActivity's
  visual language (rounded card panel, trim_* color tokens, trim_* drawables).
  All trim_* drawables/colors live in the shared `core` module and are reused
  here as-is — no new drawables were added, only reused from core.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/trim_screen_bg">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <ImageButton
            android:id="@+id/btn_mixer_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/bg_trim_circle_btn"
            android:padding="9dp"
            android:tint="@color/trim_text_primary"
            android:contentDescription="Back"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Audio Mixer"
                android:textColor="@color/trim_text_primary"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Balance original, music &amp; voiceover"
                android:textColor="@color/trim_text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- Spacer to keep the title visually centered against the back button
             now that Done has moved to the bottom action row. -->
        <View
            android:layout_width="40dp"
            android:layout_height="40dp"/>
    </LinearLayout>

    <!-- Video preview -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_trim_photo_rounded"
        android:clipToOutline="true">

        <androidx.media3.ui.PlayerView
            android:id="@+id/mixer_player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- ✅ FIX: shown instead of mixer_player_view for photo-reel mixing
             (no video file to preview — we show the selected/cover photo). -->
        <ImageView
            android:id="@+id/mixer_photo_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Photo preview"/>

        <ProgressBar
            android:id="@+id/mixer_progress_buf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:text="PREVIEW"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_trim_preview_badge"/>
    </FrameLayout>

    <!-- Bottom control panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_trim_card"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <!-- Music track info row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_trim_subcard"
            android:padding="10dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="center"
                android:background="@drawable/bg_trim_photo_rounded"
                android:src="@drawable/ic_music_note"
                android:contentDescription="Music"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:id="@+id/tv_mixer_music_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No music"
                    android:textColor="@color/trim_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tv_mixer_music_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/trim_text_secondary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_waveform_mini"
                android:contentDescription="Audio"/>

            <TextView
                android:id="@+id/btn_mixer_change_music"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Change"
                android:textColor="@color/trim_gradient_end"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_trim_duration_chip"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Change music"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Original Audio -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ORIGINAL AUDIO"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"
                    android:textColor="@color/trim_text_muted"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_trim_subcard"
                    android:padding="10dp"
                    android:layout_marginBottom="16dp">

                    <ImageButton
                        android:id="@+id/btn_mute_orig"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_volume_on"
                        android:tint="@color/trim_text_secondary"
                        android:background="@android:color/transparent"
                        android:contentDescription="Mute original"/>

                    <SeekBar
                        android:id="@+id/sb_orig_vol"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:progressTint="@color/trim_gradient_end"
                        android:thumbTint="@color/trim_gradient_end"/>

                    <TextView
                        android:id="@+id/tv_orig_vol_pct"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="@color/trim_text_primary"
                        android:textSize="13sp"
                        android:gravity="end"/>
                </LinearLayout>

                <!-- Background Music -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BACKGROUND MUSIC"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"
                    android:textColor="@color/trim_text_muted"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_trim_subcard"
                    android:padding="10dp"
                    android:layout_marginBottom="16dp">

                    <ImageButton
                        android:id="@+id/btn_mute_music"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_volume_on"
                        android:tint="@color/trim_text_secondary"
                        android:background="@android:color/transparent"
                        android:contentDescription="Mute music"/>

                    <SeekBar
                        android:id="@+id/sb_music_vol"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:progressTint="@color/trim_gradient_end"
                        android:thumbTint="@color/trim_gradient_end"/>

                    <TextView
                        android:id="@+id/tv_music_vol_pct"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="80%"
                        android:textColor="@color/trim_text_primary"
                        android:textSize="13sp"
                        android:gravity="end"/>
                </LinearLayout>

                <!-- Voiceover -->
                <LinearLayout
                    android:id="@+id/layout_voiceover_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VOICEOVER"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.1"
                        android:textColor="@color/trim_text_muted"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_trim_subcard"
                        android:padding="10dp"
                        android:layout_marginBottom="10dp">

                        <ImageButton
                            android:id="@+id/btn_voiceover_record"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_mic"
                            android:background="@drawable/circle_primary"
                            android:padding="10dp"
                            android:contentDescription="Record voiceover"/>

                        <TextView
                            android:id="@+id/tv_voiceover_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tap mic to record voiceover"
                            android:textSize="13sp"
                            android:paddingStart="12dp"
                            android:textColor="@color/trim_text_secondary"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_trim_subcard"
                        android:padding="10dp"
                        android:layout_marginBottom="16dp">

                        <ImageButton
                            android:id="@+id/btn_mute_voiceover"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_volume_on"
                            android:tint="@color/trim_text_secondary"
                            android:background="@android:color/transparent"
                            android:contentDescription="Mute voiceover"/>

                        <SeekBar
                            android:id="@+id/sb_voiceover_vol"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:progressTint="@color/trim_gradient_end"
                            android:thumbTint="@color/trim_gradient_end"/>

                        <TextView
                            android:id="@+id/tv_voiceover_vol_pct"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textColor="@color/trim_text_primary"
                            android:textSize="13sp"
                            android:gravity="end"/>
                    </LinearLayout>

                </LinearLayout>
                <!-- injectAdvancedControls() appends Fade In/Out, Normalize and
                     Pitch controls here at runtime, right after layout_voiceover_row. -->

            </LinearLayout>
        </ScrollView>

        <!-- Bottom action row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/btn_mixer_apply"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="Done"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_trim_gradient_button_ripple"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Apply mix"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
