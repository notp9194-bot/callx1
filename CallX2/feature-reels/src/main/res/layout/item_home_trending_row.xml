<?xml version="1.0" encoding="utf-8"?>
<!--
  item_home_trending_row.xml — HomeFragment feed RecyclerView, inline row
  (ROW_TRENDING_REELS). Extracted from the old item_home_footer.xml, where
  this block used to sit statically at the very bottom of the feed — now
  it's mixed into the scroll a few posts in, Instagram-style. See
  HomeFragment.ensureTrendingRowViewCreated()/FeedAdapter.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔥 Trending Reels"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:id="@+id/btn_see_all_trending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="See All"
            android:textColor="@color/brand_primary"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/container_trending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <ProgressBar
                android:id="@+id/pb_trending"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:indeterminateTint="@color/brand_primary"
                android:layout_gravity="center"
                android:visibility="visible"/>
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
