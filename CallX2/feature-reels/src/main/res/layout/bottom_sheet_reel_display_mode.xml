<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_more_sheet"
    android:paddingBottom="20dp">

    <!-- Drag Handle -->
    <FrameLayout
        android:id="@+id/fl_display_mode_drag_handle"
        android:layout_width="match_parent"
        android:layout_height="28dp">
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="#55FFFFFF"
            android:layout_marginTop="10dp"/>
    </FrameLayout>

    <TextView
        android:id="@+id/tv_display_mode_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:text="Reels Display Mode"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tv_display_mode_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="4dp"
        android:text="Choose how Reels should look. You can change this anytime from the ⋮ menu."
        android:textColor="#99FFFFFF"
        android:textSize="13sp"/>

    <LinearLayout
        android:id="@+id/ll_display_mode_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"/>

</LinearLayout>
