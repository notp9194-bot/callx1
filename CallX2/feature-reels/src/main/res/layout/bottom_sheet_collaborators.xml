<?xml version="1.0" encoding="utf-8"?>
<!-- bottom_sheet_collaborators.xml — Instagram-style "Collaborators" sheet.
     Lists the reel owner + every invited/accepted collaborator with a
     Follow/Following button, opened by tapping the avatar-stack row under
     the owner name on the reel player (ReelUiController). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_rounded">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_drag_handle"/>

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        android:text="Collaborators"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"/>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/divider"/>

    <!-- Collaborators list -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="380dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_collaborators"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="24dp"
            android:overScrollMode="never"/>

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/brand_primary"/>

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No collaborators"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone"/>
    </FrameLayout>

</LinearLayout>
