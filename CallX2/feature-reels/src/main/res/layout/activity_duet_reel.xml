<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- ── Split video area (original + camera) ─────────────────────────── -->
    <LinearLayout
        android:id="@+id/layout_duet_video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:showDividers="middle"
        android:divider="@drawable/divider_duet_gap_transparent">

        <!-- Original reel (left half in side-by-side, top half in top-bottom) -->
        <FrameLayout
            android:id="@+id/frame_original_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_duet_panel_rounded"
            android:clipToOutline="true">

            <androidx.media3.ui.PlayerView
                android:id="@+id/player_view_original"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false"
                app:resize_mode="zoom"/>

            <!-- ── Beat Sync Overlay ── -->
            <com.callx.app.views.BeatSyncOverlayView
                android:id="@+id/beat_sync_overlay"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_gravity="bottom"
                android:alpha="0.85"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:text="Original"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="#66000000"/>

            <!-- ── Caption / attribution overlay (bottom-left, screenshot style) ── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_caption_scrim"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_duet_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Duet"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <ImageView
                        android:id="@+id/iv_duet_verified"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_verified"
                        android:visibility="gone"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_duet_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:visibility="gone"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_music"
                        android:tint="#FFFFFFFF"/>

                    <TextView
                        android:id="@+id/tv_duet_sound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="original sound"
                        android:textColor="#FFFFFFFF"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Camera preview (right half in side-by-side, bottom half in top-bottom) -->
        <FrameLayout
            android:id="@+id/frame_camera_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_duet_panel_rounded"
            android:clipToOutline="true">

            <androidx.camera.view.PreviewView
                android:id="@+id/preview_view_camera"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <!-- Active filter badge (top-right of camera pane) -->
            <TextView
                android:id="@+id/tv_active_filter_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="#AA000000"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:visibility="gone"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:text="You"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="#66000000"/>
        </FrameLayout>
    </LinearLayout>

    <!-- ── Full-screen overlay container for draggable text + stickers ───── -->
    <FrameLayout
        android:id="@+id/frame_duet_overlays"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"/>

    <!-- ── Top bar: close · Add sound pill · view-duets ──────────────────── -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingTop="36dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageButton
            android:id="@+id/btn_duet_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF"
            android:contentDescription="Close"/>

        <ImageButton
            android:id="@+id/btn_view_duets"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_reels"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF"
            android:contentDescription="View Duets"/>

        <LinearLayout
            android:id="@+id/btn_duet_add_sound"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_centerInParent="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_dark_translucent"
            android:paddingStart="16dp"
            android:paddingEnd="18dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_music"
                android:tint="#FFFFFF"/>

            <TextView
                android:id="@+id/tv_add_sound_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Add sound"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:maxWidth="150dp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>
    </RelativeLayout>

    <!-- ── Right-side vertical tool column: Flip / Layout / Beauty / Filters / Timer ── -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Flip -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="18dp">

            <ImageButton
                android:id="@+id/btn_duet_flip"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_camera"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#FFFFFF"
                android:contentDescription="Flip camera"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Flip"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"/>
        </LinearLayout>

        <!-- Layout (screenshot "Speed" slot — cycles duet split layout) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="18dp">

            <ImageButton
                android:id="@+id/btn_tool_layout"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_flip"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#FFFFFF"
                android:contentDescription="Layout"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Layout"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"/>
        </LinearLayout>

        <!-- Beauty -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="18dp">

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp">

                <ImageButton
                    android:id="@+id/btn_tool_beauty"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_beauty"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="#FFFFFF"
                    android:contentDescription="Beauty"/>

                <View
                    android:id="@+id/view_beauty_badge"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_dot_red"
                    android:visibility="gone"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Beauty"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"/>
        </LinearLayout>

        <!-- Filters (reuses existing live-filter strip logic) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="18dp">

            <ImageButton
                android:id="@+id/btn_tool_filter"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_filters"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#FFFFFF"
                android:contentDescription="Live Filters"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Filters"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"/>
        </LinearLayout>

        <!-- Timer (pre-record countdown: 3s / 5s / 10s) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp">

                <ImageButton
                    android:id="@+id/btn_tool_timer"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_timer"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="#FFFFFF"
                    android:contentDescription="Timer"/>
            </FrameLayout>

            <TextView
                android:id="@+id/tv_timer_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="3s"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ── Layout-mode popup (Side-by-side / Top-bottom / PiP / Reaction bubble) ──
         Opened via the "Layout" button above; hidden by default. ── -->
    <LinearLayout
        android:id="@+id/layout_duet_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="vertical"
        android:layout_marginTop="108dp"
        android:layout_marginEnd="58dp"
        android:background="#DD000000"
        android:padding="6dp"
        android:elevation="16dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_layout_side_by_side"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_flip"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF"
            android:contentDescription="Side by Side"
            android:alpha="1.0"/>

        <ImageButton
            android:id="@+id/btn_layout_top_bottom"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_flip_camera"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF"
            android:contentDescription="Top Bottom"
            android:alpha="0.4"
            android:layout_marginTop="4dp"/>

        <ImageButton
            android:id="@+id/btn_layout_pip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_camera"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF"
            android:contentDescription="Picture in Picture"
            android:alpha="0.4"
            android:layout_marginTop="4dp"/>

        <ImageButton
            android:id="@+id/btn_layout_reaction_bubble"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_camera"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FF4081"
            android:contentDescription="Reaction Bubble"
            android:alpha="0.4"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- ── Secondary tools: Text + Sticker overlays (kept, tucked below main column) ── -->
    <LinearLayout
        android:id="@+id/panel_live_tools"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="140dp"
        android:orientation="vertical"
        android:background="#55000000"
        android:padding="5dp"
        android:elevation="12dp">

        <TextView
            android:id="@+id/btn_tool_text"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center_horizontal"
            android:text="T"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="sans-serif-black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Add Text"/>

        <TextView
            android:id="@+id/btn_tool_sticker"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center_horizontal"
            android:text="😊"
            android:gravity="center"
            android:textSize="18sp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Add Sticker"/>
    </LinearLayout>

    <!-- ── Reaction Bubble draggable overlay ─────────────────────────────── -->
    <FrameLayout
        android:id="@+id/view_bubble_overlay"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="230dp"
        android:background="@drawable/bg_bubble_circle"
        android:visibility="gone"
        android:clipToOutline="true"
        android:outlineProvider="background"
        android:elevation="8dp">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview_view_bubble"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="6dp"
            android:text="drag"
            android:textColor="#CCFFFFFF"
            android:textSize="9sp"/>
    </FrameLayout>

    <!-- ── Filter Strip Panel (slides up above bottom controls) ──────────── -->
    <HorizontalScrollView
        android:id="@+id/panel_filter_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="188dp"
        android:scrollbars="none"
        android:background="#DD000000"
        android:visibility="gone"
        android:elevation="14dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/container_filter_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical"/>
    </HorizontalScrollView>

    <!-- ── Bottom controls ───────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="18dp"
        android:paddingTop="10dp"
        android:background="#77000000">

        <!-- Compact audio-mix drawer: original volume + mic gain -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_volume_off"
                    android:tint="#CCFFFFFF"/>

                <SeekBar
                    android:id="@+id/seek_original_volume"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:progressTint="@color/brand_primary"
                    android:thumbTint="@color/brand_primary"/>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_volume_on"
                    android:tint="#CCFFFFFF"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_volume_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Original audio: 50%"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp"
                android:layout_marginBottom="2dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_mic_off"
                    android:tint="#CCFFFFFF"/>

                <SeekBar
                    android:id="@+id/seek_mic_gain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="100"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:progressTint="#FF4081"
                    android:thumbTint="#FF4081"/>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_mic"
                    android:tint="#CCFFFFFF"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_mic_gain_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mic: 100%"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_duet_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="6dp"/>

        <ProgressBar
            android:id="@+id/progress_duet"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:max="60"
            android:progress="0"
            android:progressTint="@color/brand_primary"
            android:progressBackgroundTint="#44FFFFFF"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"/>

        <!-- Effects · Record · Upload row (screenshot style) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageButton
                    android:id="@+id/btn_bottom_effects"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_reels"
                    android:scaleType="fitCenter"
                    android:padding="12dp"
                    android:background="@drawable/bg_pill_dark_translucent"
                    android:tint="#FFFFFF"
                    android:contentDescription="Effects"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Effects"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_duet_record"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_play"
                android:tint="#A855F7"
                android:background="@drawable/circle_primary"
                android:padding="14dp"
                android:contentDescription="Record duet"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageButton
                    android:id="@+id/btn_bottom_upload"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_gallery"
                    android:scaleType="fitCenter"
                    android:padding="12dp"
                    android:background="@drawable/bg_pill_dark_translucent"
                    android:tint="#FFFFFF"
                    android:contentDescription="Upload"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Upload"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- Cosmetic bottom mode strip -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="18dp"
                android:text="Camera"
                android:textColor="#88FFFFFF"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="18dp"
                android:text="Quick"
                android:textColor="#88FFFFFF"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="18dp"
                android:text="Templates"
                android:textColor="#88FFFFFF"
                android:textSize="13sp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DUET"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"/>

                <View
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_dark_tab_dot"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ── 3-2-1 Countdown overlay ───────────────────────────────────────── -->
    <TextView
        android:id="@+id/tv_duet_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="3"
        android:textColor="#FFFFFF"
        android:textSize="96sp"
        android:fontFamily="sans-serif-black"
        android:shadowColor="#AA000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="8"
        android:visibility="gone"/>

</FrameLayout>
