<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_more_sheet">

    <!-- Drag Handle -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="28dp">
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="#55FFFFFF"
            android:layout_marginTop="10dp"/>
    </FrameLayout>

    <!-- Scrollable Items
         FIX: plain ScrollView does NOT implement NestedScrollingChild, so
         BottomSheetBehavior (which lives on the parent CoordinatorLayout)
         can't tell the difference between "user is scrolling the list" and
         "user is dragging the sheet to dismiss it". Result: scroll down works
         fine (content just scrolls), but reversing direction to scroll back
         up gets intercepted by the sheet's own drag handling instead of the
         ScrollView, and since the sheet is already fully expanded that drag
         reads as a dismiss swipe — closing the whole sheet mid-scroll.
         NestedScrollView implements NestedScrollingChild2 and correctly
         hands scroll deltas to/from the CoordinatorLayout's nested scrolling
         parent, so BottomSheetBehavior only takes over for an actual
         drag-to-dismiss gesture once the list is scrolled to its top. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/ll_more_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp"/>

    </androidx.core.widget.NestedScrollView>
</LinearLayout>
