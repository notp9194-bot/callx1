<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- ── Header ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:background="?attr/colorSurface"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"/>

        <TextView
            android:id="@+id/tv_comment_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Comments"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginStart="2dp"/>

        <!-- Search toggle -->
        <ImageButton
            android:id="@+id/btn_search_toggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_search"
            android:tint="#6BCFEF"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Search comments"
            android:padding="8dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

    <!-- ── Search bar (collapsed by default) ── -->
    <LinearLayout
        android:id="@+id/layout_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:background="?attr/colorSurface"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            android:tint="#6BCFEF"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Search comments…"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:background="@android:color/transparent"
            android:inputType="text"
            android:singleLine="true"
            android:imeOptions="actionSearch"/>

        <ImageButton
            android:id="@+id/btn_close_search"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close search"
            android:padding="6dp"/>
    </LinearLayout>

    <!-- ── Sort chips row ── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_newest"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Newest"
                android:textSize="13sp"
                android:textColor="@color/brand_primary"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_sort_chip_selected"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chip_top"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Top Liked"
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_sort_chip"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ── Comments list (wrapped so a floating 'new comments' pill can sit on top) ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_comments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"/>

        <!-- Shown briefly while an older comments page is being fetched
             (triggered by scrolling near the BOTTOM of the list — newest
             comments are at the top, older ones page in further down). -->
        <TextView
            android:id="@+id/tv_loading_older"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:text="Loading earlier comments…"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/bg_sort_chip"
            android:elevation="4dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/pill_new_comments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:text="↑ New comments"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@drawable/bg_sort_chip_selected"
            android:elevation="4dp"
            android:visibility="gone"/>

        <!-- One-time "swipe to reply" affordance hint — shown only the very
             first time this device ever opens a reel's comment section (see
             maybeShowSwipeReplyHint()), never again after that. -->
        <LinearLayout
            android:id="@+id/layout_swipe_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_sort_chip_selected"
            android:elevation="6dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_reply"
                android:tint="#FFFFFF"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Swipe a comment right to reply"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </FrameLayout>

    <!-- ── Empty state ── -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No comments yet.\nBe the first to comment!"
        android:textColor="@color/text_muted"
        android:textSize="15sp"
        android:visibility="gone"/>

    <!-- ── @mention autocomplete strip (shown while typing "@name") ── -->
    <HorizontalScrollView
        android:id="@+id/layout_mention_suggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="?attr/colorSurface"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/container_mention_suggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <!-- ── Replying-to bar ── -->
    <LinearLayout
        android:id="@+id/bar_replying_to"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:background="#F5F5F5"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_replying_to"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Replying to @user"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"/>

        <ImageButton
            android:id="@+id/btn_cancel_reply"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cancel reply"
            android:padding="6dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

    <!-- ── Input row ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorSurface">

        <!-- Character counter -->
        <TextView
            android:id="@+id/tv_char_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:paddingEnd="16dp"
            android:paddingTop="2dp"
            android:text="0/300"
            android:textSize="10sp"
            android:textColor="@color/text_muted"
            android:visibility="gone"/>

        <!-- Selected-photo preview (Instagram-style — shown above the
             input row once the user picks an image, before sending) -->
        <FrameLayout
            android:id="@+id/layout_comment_image_preview"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_comment_image_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_comment_image_frame"
                android:clipToOutline="true"
                android:contentDescription="Selected photo"/>

            <ImageButton
                android:id="@+id/btn_remove_comment_image"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-6dp"
                android:layout_marginEnd="-6dp"
                android:src="@drawable/ic_close"
                android:background="@drawable/bg_sort_chip_selected"
                android:contentDescription="Remove photo"
                android:padding="4dp"/>

            <ProgressBar
                android:id="@+id/progress_comment_image"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:visibility="gone"/>
        </FrameLayout>

        <!-- Quick emoji reply row — Instagram-style: a horizontal strip of
             common emojis sitting right above the text field. Tapping one
             inserts it at the cursor (doesn't auto-send), so it's a
             shortcut for typing, not a separate reaction system — see
             ReelReactionEmojis.LIST / insertQuickEmoji(). -->
        <HorizontalScrollView
            android:id="@+id/scroll_quick_emojis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:paddingTop="4dp"
            android:paddingBottom="2dp">

            <LinearLayout
                android:id="@+id/container_quick_emojis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/btn_attach_photo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_gallery"
                android:tint="@color/text_muted"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Add photo"
                android:padding="8dp"/>

            <com.callx.app.comments.GifAwareCommentEditText
                android:id="@+id/et_comment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Write a comment…"
                android:textSize="14sp"
                android:maxLines="3"
                android:background="@drawable/bg_comment_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:inputType="textMultiLine|textCapSentences"
                android:imeOptions="actionSend"/>

            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_send_fill"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Send"
                android:padding="6dp"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
