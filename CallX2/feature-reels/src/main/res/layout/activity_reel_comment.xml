<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- ── Header ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:background="?attr/colorSurface"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reel_c_back"/>

        <TextView
            android:id="@+id/tv_comment_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/reel_c_comments"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginStart="2dp"/>

        <!-- Search toggle -->
        <ImageButton
            android:id="@+id/btn_search_toggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_search"
            android:tint="@color/reel_accent_cyan"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reel_c_search_comments"
            android:padding="8dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

    <!-- ── Search bar (collapsed by default) ── -->
    <LinearLayout
        android:id="@+id/layout_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:background="?attr/colorSurface"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            android:tint="@color/reel_accent_cyan"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/reel_c_search_hint"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:background="@android:color/transparent"
            android:inputType="text"
            android:singleLine="true"
            android:imeOptions="actionSearch"/>

        <ImageButton
            android:id="@+id/btn_close_search"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reel_c_close_search"
            android:padding="6dp"/>
    </LinearLayout>

    <!-- ── Reel caption/description row (Instagram-style: shown only when
         the comments sheet was opened by tapping the reel's caption/name,
         not when opened via the comment icon/count). ViewStub — costs
         nothing to inflate/measure until explicitly inflated from Java, so
         the far more common comment-icon/count sheet open never pays for
         this block's avatar view/text views/Glide setup at all. ── -->
    <ViewStub
        android:id="@+id/stub_reel_caption_header"
        android:layout="@layout/view_reel_caption_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- ── Sort chips row ── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_newest"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/reel_c_sort_newest"
                android:textSize="13sp"
                android:textColor="@color/brand_primary"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_sort_chip_selected"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chip_top"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/reel_c_sort_top_liked"
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_sort_chip"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ── Status banner: offline / "couldn't refresh" (non-blocking, list stays
         visible underneath). Tappable only in the refresh-failed mode. ── -->
    <TextView
        android:id="@+id/tv_status_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="sans-serif-medium"
        android:background="?attr/colorSurfaceVariant"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone"/>

    <!-- ── Comments list (wrapped so a floating 'new comments' pill can sit on top) ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_comments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"/>

        <!-- Skeleton — shown only while the FIRST page of comments is
             loading (never for "load older" pagination, that's
             tv_loading_older below). Single canvas-drawn View instead of a
             ShimmerFrameLayout + N inflated rows — see CommentSkeletonView
             for why. Hidden the moment the first page (or the empty state)
             resolves. -->
        <com.callx.app.comments.CommentSkeletonView
            android:id="@+id/skeleton_comments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>

        <!-- Shown briefly while an older comments page is being fetched
             (triggered by scrolling near the BOTTOM of the list — newest
             comments are at the top, older ones page in further down). -->
        <TextView
            android:id="@+id/tv_loading_older"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:text="@string/reel_c_loading_earlier"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/bg_sort_chip"
            android:elevation="4dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/pill_new_comments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/reel_c_new_comments_default"
            android:accessibilityLiveRegion="polite"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@drawable/bg_sort_chip_selected"
            android:elevation="4dp"
            android:visibility="gone"/>

        <!-- One-time "swipe to reply" affordance hint — shown only the very
             first time this device ever opens a reel's comment section (see
             maybeShowSwipeReplyHint()), never again after that. -->
        <LinearLayout
            android:id="@+id/layout_swipe_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_sort_chip_selected"
            android:elevation="6dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_reply"
                android:tint="@android:color/white"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/reel_c_swipe_hint"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </FrameLayout>

    <!-- ── Empty state ── -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/reel_c_empty"
        android:textColor="@color/text_muted"
        android:textSize="15sp"
        android:visibility="gone"/>

    <!-- ── Error / offline state (full-screen, only when there is nothing to
         show: first page failed or timed out). Retry re-attaches the listeners. ── -->
    <LinearLayout
        android:id="@+id/layout_error_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_error_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="40sp"
            android:importantForAccessibility="no"/>

        <TextView
            android:id="@+id/tv_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tv_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="@color/text_muted"
            android:gravity="center"/>

        <TextView
            android:id="@+id/btn_error_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:minWidth="120dp"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/reel_c_retry"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_sort_chip_selected"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- ── @mention autocomplete strip (shown while typing "@name") ── -->
    <!-- PERF: was a HorizontalScrollView + LinearLayout that had plain
         TextView chips manually inflated/removed on every keystroke (see
         MentionSuggestionAdapter). Now a real RecyclerView with a small
         dedicated adapter — recycles its (max ~8) rows and renders an
         avatar per suggestion instead of name-only text. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_mention_suggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:scrollbars="none"
        android:background="?attr/colorSurface"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:clipToPadding="false"
        android:visibility="gone"/>

    <!-- ── Replying-to bar ── -->
    <LinearLayout
        android:id="@+id/bar_replying_to"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:background="?attr/colorSurfaceVariant"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_replying_to"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Replying to @user"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"/>

        <ImageButton
            android:id="@+id/btn_cancel_reply"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reel_c_cancel_reply"
            android:padding="10dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

    <!-- ── Input row ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorSurface">

        <!-- Character counter -->
        <TextView
            android:id="@+id/tv_char_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            tools:text="0/300"
            android:accessibilityLiveRegion="polite"
            android:textSize="10sp"
            android:textColor="@color/text_muted"
            android:visibility="gone"/>

        <!-- Selected-photo preview (Instagram-style — shown above the
             input row once the user picks an image, before sending) -->
        <FrameLayout
            android:id="@+id/layout_comment_image_preview"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="2dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_comment_image_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_comment_image_frame"
                android:clipToOutline="true"
                android:contentDescription="@string/reel_c_selected_photo"/>

            <ImageButton
                android:id="@+id/btn_remove_comment_image"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-6dp"
                android:layout_marginEnd="-6dp"
                android:src="@drawable/ic_close"
                android:background="@drawable/bg_sort_chip_selected"
                android:contentDescription="@string/reel_c_remove_photo"
                android:padding="4dp"/>

            <ProgressBar
                android:id="@+id/progress_comment_image"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:visibility="gone"/>
        </FrameLayout>

        <!-- Quick emoji reply row — Instagram-style: a horizontal strip of
             common emojis sitting right above the text field. Tapping one
             inserts it at the cursor (doesn't auto-send), so it's a
             shortcut for typing, not a separate reaction system — see
             ReelReactionEmojis.LIST / insertQuickEmoji(). -->
        <HorizontalScrollView
            android:id="@+id/scroll_quick_emojis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/container_quick_emojis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
        </HorizontalScrollView>

        <!-- Bottom-aligned (not centred): when the field grows to 2-3 lines the
             avatar / photo / send buttons stay pinned next to the LAST line,
             like Instagram / WhatsApp. -->
        <LinearLayout
            android:id="@+id/row_comment_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="10dp">

            <!-- Own avatar (Instagram comment bar). 32dp = comment-row avatar size,
                 so ReelCommentAvatarBinder's TINY tier decodes it 1:1. -->
            <ImageView
                android:id="@+id/iv_my_avatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_comment_avatar_circle"
                android:clipToOutline="true"
                android:src="@drawable/ic_person"
                android:importantForAccessibility="no"/>

            <ImageButton
                android:id="@+id/btn_attach_photo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_comment_photo"
                android:tint="@color/comment_input_icon"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/reel_c_add_photo"
                android:padding="8dp"/>

            <com.callx.app.comments.GifAwareCommentEditText
                android:id="@+id/et_comment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/reel_c_write_comment"
                android:textSize="14sp"
                android:maxLines="3"
                android:minHeight="40dp"
                android:gravity="center_vertical"
                android:background="@drawable/bg_comment_input_field"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:inputType="textMultiLine|textCapSentences"
                android:imeOptions="flagNoExtractUi"/>
            <!-- Multiline field: Enter = new line (Instagram-style), sending is the
                 send button. imeOptions="actionSend" was dead here - keyboards show
                 Enter for multiline fields and nothing handled the action. -->

            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_send_fill"
                android:tint="@android:color/white"
                android:background="@drawable/bg_comment_send_circle"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/reel_c_send"
                android:padding="8dp"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
