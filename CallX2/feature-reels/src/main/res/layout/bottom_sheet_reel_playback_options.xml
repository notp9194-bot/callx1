<?xml version="1.0" encoding="utf-8"?>
<!-- Reels long-press sheet: View fullscreen (Cinema Mode) · Speed · Auto scroll · Closed Captions.
     Reuses existing drawables only: bg_more_sheet, bg_drag_handle, bg_more_item_ripple,
     bg_pill_dark_solid / bg_pill_dark_translucent (speed segments), and the ic_* icons below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_more_sheet"
    android:paddingBottom="12dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_drag_handle"/>

    <!-- View fullscreen → Cinema Mode -->
    <LinearLayout
        android:id="@+id/row_fullscreen"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="@drawable/bg_more_item_ripple"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_display_mode_immersive"
            android:importantForAccessibility="no"/>
        <TextView
            android:id="@+id/tv_fullscreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="24dp"
            android:text="View fullscreen"
            android:textColor="#FFFFFF"
            android:textSize="17sp"/>
    </LinearLayout>

    <!-- Speed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="20dp">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_speed"
            android:importantForAccessibility="no"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="24dp"
            android:text="Speed"
            android:textColor="#FFFFFF"
            android:textSize="17sp"/>
        <LinearLayout
            android:id="@+id/ll_speed_segments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp"
            android:background="@drawable/bg_pill_dark_solid"/>
    </LinearLayout>

    <!-- Auto scroll -->
    <LinearLayout
        android:id="@+id/row_auto_scroll"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="@drawable/bg_more_item_ripple"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_repost"
            android:importantForAccessibility="no"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="24dp"
            android:text="Auto scroll"
            android:textColor="#FFFFFF"
            android:textSize="17sp"/>
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_auto_scroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:useMaterialThemeColors="false"/>
    </LinearLayout>

    <!-- Closed Captions -->
    <LinearLayout
        android:id="@+id/row_captions"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="@drawable/bg_more_item_ripple"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_caption"
            android:importantForAccessibility="no"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="24dp"
            android:text="Closed Captions"
            android:textColor="#FFFFFF"
            android:textSize="17sp"/>
        <TextView
            android:id="@+id/tv_captions_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Off"
            android:textColor="#99FFFFFF"
            android:textSize="14sp"/>
    </LinearLayout>

</LinearLayout>
