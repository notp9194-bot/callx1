<?xml version="1.0" encoding="utf-8"?>
<!--
    item_reel_share_contact_grid.xml
    ★ NEW — GridLayoutManager cell for ReelShareSheetFragment's "Send to" avatars
    (Instagram-style: circular avatar + name, evenly filling a 3-column grid).

    Kept as its own file rather than editing the shared core/item_contact_share.xml,
    because that file is also used by ReelShareSheetActivity's HORIZONTAL list and
    by feature-chat's ContactShareAdapter — a match_parent width here would have
    broken both of those.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="8dp"
    android:background="?attr/selectableItemBackground">

    <!-- ★ NEW: online-status dot (Instagram-style green dot), same visual +
         threshold convention as GroupMemberAdapter/GroupInfoActivity
         (Constants.ONLINE_WINDOW_MS, circle_accept green drawable). -->
    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp">

        <!-- Story ring (same gradient/seen/hidden ring HomeFragment's feed post
             avatar and Stories tray already use — see StoryRingApplier). Sized
             bigger than the avatar so it sits behind/around it. -->
        <ImageView
            android:id="@+id/iv_story_ring"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:visibility="gone"
            tools:ignore="ContentDescription"/>

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_share_contact_avatar"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_person"/>

        <!-- ★ NEW: multi-select scrim — darkens the avatar slightly (IG-style)
             while a checkmark badge sits on top, see iv_selection_check below.
             GONE by default; ReelContactShareAdapter toggles both together. -->
        <View
            android:id="@+id/view_selection_scrim"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_avatar_selection_scrim"
            android:visibility="gone"/>

        <View
            android:id="@+id/online_dot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="1dp"
            android:background="@drawable/circle_accept"
            android:visibility="gone"/>

        <!-- ★ NEW: multi-select checkmark badge (blue circle + white check,
             white ring for contrast on any avatar). Shown/hidden in lockstep
             with view_selection_scrim above by ReelContactShareAdapter#onBindViewHolder;
             mutually exclusive with online_dot in the same corner (a selected
             contact's online dot is hidden while checked). -->
        <ImageView
            android:id="@+id/iv_selection_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:src="@drawable/bg_share_selected_check"
            android:visibility="gone"/>

    </FrameLayout>

    <TextView
        android:id="@+id/tv_share_contact_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"/>

</LinearLayout>
