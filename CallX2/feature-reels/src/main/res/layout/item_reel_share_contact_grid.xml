<?xml version="1.0" encoding="utf-8"?>
<!--
    item_reel_share_contact_grid.xml
    ★ NEW — GridLayoutManager cell for ReelShareSheetFragment's "Send to" avatars
    (Instagram-style: circular avatar + name, evenly filling a 3-column grid).

    Kept as its own file rather than editing the shared core/item_contact_share.xml,
    because that file is also used by ReelShareSheetActivity's HORIZONTAL list and
    by feature-chat's ContactShareAdapter — a match_parent width here would have
    broken both of those.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="8dp"
    android:background="?attr/selectableItemBackground">

    <!-- ★ NEW: online-status dot (Instagram-style green dot), same visual +
         threshold convention as GroupMemberAdapter/GroupInfoActivity
         (Constants.ONLINE_WINDOW_MS, circle_accept green drawable). -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_share_contact_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_person"/>

        <View
            android:id="@+id/online_dot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="1dp"
            android:background="@drawable/circle_accept"
            android:visibility="gone"/>

    </FrameLayout>

    <TextView
        android:id="@+id/tv_share_contact_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"/>

</LinearLayout>
