<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="0dp"
    android:paddingEnd="4dp">

    <!-- NO vertical padding on this row on purpose: padding clips child
         drawing, so the trunk would stop 8dp short of the row edge and leave
         a gap between consecutive replies. The 8dp top/bottom spacing lives
         in the avatar / body / like-column margins below, and the connector
         spans the row's full height (match_parent, no margins). -->

    <!-- Thread connector: thin 2dp trunk + curved arrow into the avatar.
         24dp wide: arm is 20dp so the arrow tip lands ~3dp from the avatar. -->
    <com.callx.app.comments.ReplyConnectorView
        android:id="@+id/reply_connector"
        android:layout_width="24dp"
        android:layout_height="match_parent"/>

    <ImageView
        android:id="@+id/iv_avatar"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="10dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_comment_avatar_circle"
        android:clipToOutline="true"
        android:src="@drawable/ic_person"/>

    <!-- Reply body (8dp top/bottom = the row spacing that used to be padding) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"/>

            <ImageView
                android:id="@+id/iv_verified"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="3dp"
                android:src="@drawable/ic_verified_pink"
                android:visibility="gone"
                android:contentDescription="@string/reel_c_verified"/>

            <TextView
                android:id="@+id/tv_author_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/reel_c_author"
                android:textSize="8sp"
                android:textColor="@color/text_muted"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:background="@drawable/bg_sort_chip"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="10sp"
                android:textColor="@color/text_muted"/>

            <TextView
                android:id="@+id/tv_edited"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/reel_c_edited"
                android:textSize="9sp"
                android:textColor="@color/text_muted"
                android:visibility="gone"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_creator_liked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/reel_c_liked_by_creator"
            android:textSize="9sp"
            android:textColor="@color/reel_like_heart"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tv_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12.5sp"
            android:textColor="@color/comment_text_body"
            android:maxLines="8"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/btn_reply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-2dp"
            android:layout_marginBottom="-6dp"
            android:text="@string/reel_c_reply"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:fontFamily="sans-serif-medium"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>

    <!-- Like button + count -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginStart="6dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="-7dp">

        <!-- 40dp tap target; 13dp padding => 14dp icon,
             thin-stroke ic_comment_heart. -->
        <ImageButton
            android:id="@+id/btn_like_reply"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_comment_heart"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reel_c_like_reply"
            android:padding="13dp"/>

        <TextView
            android:id="@+id/tv_likes_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-11dp"
            android:text=""
            android:textSize="10sp"
            android:textColor="@color/text_muted"
            android:gravity="center"/>
    </LinearLayout>

</LinearLayout>
