<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/iv_avatar"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp"
        android:src="@drawable/ic_person"/>

    <!-- Reply body -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/tv_author_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="Author"
                android:textSize="8sp"
                android:textColor="@color/text_muted"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:background="@drawable/bg_sort_chip"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="10sp"
                android:textColor="@color/text_muted"/>

            <TextView
                android:id="@+id/tv_edited"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="(edited)"
                android:textSize="9sp"
                android:textColor="@color/text_muted"
                android:visibility="gone"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_creator_liked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="❤️ Liked by creator"
            android:textSize="9sp"
            android:textColor="#FF416C"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tv_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12.5sp"
            android:textColor="@color/text_secondary"
            android:maxLines="8"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/btn_reply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Reply"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:fontFamily="sans-serif-medium"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>

    <!-- Like button + count -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginStart="6dp">

        <ImageButton
            android:id="@+id/btn_like_reply"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_heart"
            android:tint="#FF416C"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Like reply"
            android:padding="5dp"/>

        <TextView
            android:id="@+id/tv_likes_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="9sp"
            android:textColor="@color/text_muted"
            android:gravity="center"/>
    </LinearLayout>

</LinearLayout>
