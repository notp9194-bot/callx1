<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_video_trim.xml — modernized (was a WhatsApp-style dual-SeekBar
  panel with a raw VideoView). Now:
    ■ Minimal floating toolbar — translucent circular close + gradient "Next" pill
    ■ Rounded video preview card, ExoPlayer surface, centered translucent play button
    ■ Single filmstrip range trimmer (VideoTrimRangeView) with real thumbnails,
      draggable handles, dimmed trimmed-out edges, and a live playhead
    ■ Duration chip instead of two separate "Selected:" text rows
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btn_trim_cancel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_trim_toolbar_btn"
            android:contentDescription="Cancel"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Trim"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAlignment="center"/>

        <TextView
            android:id="@+id/btn_trim_send"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="88dp"
            android:text="Next"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:background="@drawable/bg_trim_next_pill_selector"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Video preview -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_trim_preview_card"
        android:clipToOutline="true"
        android:outlineProvider="background">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_trim_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:resize_mode="fit"
            app:surface_type="texture_view"/>

        <ImageButton
            android:id="@+id/btn_trim_play"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_trim_play_btn"
            android:contentDescription="Play/Pause"/>
    </FrameLayout>

    <!-- Trim controls panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="24dp">

        <!-- Duration chip row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_trim_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_pill_dark_solid"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tv_trim_start_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#8A8A8A"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" – "
                android:textColor="#8A8A8A"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tv_trim_end_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#8A8A8A"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Filmstrip range trimmer -->
        <com.callx.app.editor.VideoTrimRangeView
            android:id="@+id/trim_range_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>

        <!-- Trim progress (hidden until Next is tapped) -->
        <LinearLayout
            android:id="@+id/layout_trim_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp"
            android:visibility="gone">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/pb_trim_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:indicatorColor="#22D3A6"
                app:trackColor="#2A2A2A"
                app:trackThickness="4dp"
                app:trackCornerRadius="4dp"
                app:indicatorDirectionLinear="startToEnd"/>

            <TextView
                android:id="@+id/tv_trim_progress_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:minWidth="34dp"
                android:text="0%"
                android:textColor="#8A8A8A"
                android:textSize="12sp"
                android:textAlignment="viewEnd"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
