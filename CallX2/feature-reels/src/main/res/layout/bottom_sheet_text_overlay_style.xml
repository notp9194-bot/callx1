<?xml version="1.0" encoding="utf-8"?>
<!--
  Text Overlay style sheet — Step 2's font / bold·italic·align / background /
  colour / size controls, moved out of the always-visible Step 2 card (where
  they used to make that step's card panel taller than every other step,
  shrinking the video preview above it) into a bottom sheet opened via the
  new "settings" gear button next to the text input.

  Reuses the same com.google.android.material.bottomsheet.BottomSheetDialog
  class the sticker picker sheet (StatusStickerPickerSheet) is built on —
  see openTextOverlayStyleSheet() in ReelEditorActivity — instead of a
  separate popup/dialog implementation.

  View IDs are unchanged from the old inline layout (ll_text_font_row,
  ll_text_style_row, ll_text_bg_row, ll_text_color_row, seek_text_size) so
  the existing chip-building logic (setupAdvancedTextOverlayPanel(),
  syncTextOverlayPanelSelectionUI(), refreshChipSelection(), buildChip())
  in ReelEditorActivity works unchanged — only where these views live moved,
  not the code that builds/drives them.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_trim_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Grabber handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@color/trim_divider"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Text Style"
                android:textColor="@color/trim_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/btn_text_style_done"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Done"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="@drawable/bg_trim_gradient_button_ripple"/>
        </LinearLayout>

        <!-- Font family chips (populated in code: Classic / Serif / Mono / Condensed) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FONT"
            android:textColor="@color/trim_text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/ll_text_font_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <!-- Bold / Italic / Align chips (populated in code) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STYLE"
            android:textColor="@color/trim_text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/ll_text_style_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <!-- Background style chips: None / Pill / Solid / Highlight (populated in code) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BACKGROUND"
            android:textColor="@color/trim_text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/ll_text_bg_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <!-- Color swatches (populated in code) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COLOUR"
            android:textColor="@color/trim_text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/ll_text_color_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <!-- Size slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIZE"
                android:textColor="@color/trim_text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="8dp"/>

            <SeekBar
                android:id="@+id/seek_text_size"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="48"
                android:progress="12"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
