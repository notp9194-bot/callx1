<?xml version="1.0" encoding="utf-8"?>
<!-- Content for stub_collab_row ViewStub in fragment_reel_player.xml.
     MULTI-COLLABORATOR, MERGED ROW: overlapping avatar stack (owner first,
     then collaborators, up to 3 shown) + "@owner and N others" + Follow
     button, all on one line — matches Instagram's collab credit row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_collab_second_author"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:paddingVertical="2dp">
    <!-- Instagram-style overlapping avatar stack with a real crescent
         cutout notch (not just a flat circle-on-top overlap) — see
         CollabAvatarStackView for the notch-cutting logic. -->
    <com.callx.app.views.CollabAvatarStackView
        android:id="@+id/collab_avatar_stack"
        android:layout_width="wrap_content"
        android:layout_height="28dp"/>
    <TextView
        android:id="@+id/tv_collab_author_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:id="@+id/tv_collab_follow_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="Follow"
        android:textColor="#00E5FF"
        android:textSize="13sp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/bg_reel_follow_btn"
        android:visibility="gone"/>
</LinearLayout>
