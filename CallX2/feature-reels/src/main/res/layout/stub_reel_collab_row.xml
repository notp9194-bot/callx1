<?xml version="1.0" encoding="utf-8"?>
<!-- Content for stub_collab_row ViewStub in fragment_reel_player.xml.
     MULTI-COLLABORATOR, MERGED ROW: overlapping avatar stack (owner first,
     then collaborators, up to 3 shown) + "@owner and N others" + Follow
     button, all on one line — matches Instagram's collab credit row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_collab_second_author"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:paddingVertical="2dp">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="24dp">
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_collab_stack_1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="0dp"
            app:civ_border_width="1.5dp"
            app:civ_border_color="#000000"
            android:src="@drawable/ic_person"/>
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_collab_stack_2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            app:civ_border_width="1.5dp"
            app:civ_border_color="#000000"
            android:visibility="gone"
            android:src="@drawable/ic_person"/>
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_collab_stack_3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="24dp"
            app:civ_border_width="1.5dp"
            app:civ_border_color="#000000"
            android:visibility="gone"
            android:src="@drawable/ic_person"/>
    </FrameLayout>
    <TextView
        android:id="@+id/tv_collab_author_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:id="@+id/tv_collab_follow_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="Follow"
        android:textColor="#00E5FF"
        android:textSize="13sp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/bg_reel_follow_btn"
        android:visibility="gone"/>
</LinearLayout>
