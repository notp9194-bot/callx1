<?xml version="1.0" encoding="utf-8"?>
<!--
  item_home_header.xml — HomeFragment feed RecyclerView, position 0.
  Instagram-style top bar + stories row + (hidden) Following/For-You toggle.
  Extracted from the old fragment_home.xml's NestedScrollView content so it
  can be item view type VT_HEADER in the single top-level RecyclerView —
  see HomeFragment.FeedAdapter. Content/behavior unchanged from before.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ── Instagram-style Fixed Header ── -->
    <LinearLayout
        android:id="@+id/header_instagram"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- + New Post -->
        <ImageButton
            android:id="@+id/btn_new_post"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_add_reels"
            android:tint="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="New Post"/>

        <!-- App title — tappable to show Following / Favorites dropdown -->
        <TextView
            android:id="@+id/tv_feed_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CallX  ▾"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:fontFamily="cursive"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <!-- Notifications / Heart -->
        <ImageButton
            android:id="@+id/btn_notifications"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_heart"
            android:tint="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notifications"/>
    </LinearLayout>

    <!-- ── Notes/status bubbles ── -->
    <HorizontalScrollView
        android:id="@+id/scroll_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp">
        <LinearLayout
            android:id="@+id/container_notes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <!-- ── Stories Bar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <HorizontalScrollView
            android:id="@+id/scroll_stories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:id="@+id/container_stories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Add Story (My story) — always first -->
                <LinearLayout
                    android:id="@+id/btn_add_story"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="88dp"
                        android:layout_height="88dp">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/iv_my_story_avatar"
                            android:layout_width="78dp"
                            android:layout_height="78dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_person"
                            app:civ_border_width="1dp"
                            app:civ_border_color="@color/divider"/>

                        <!-- "+" overlay -->
                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="bottom|end"
                            android:src="@drawable/ic_status_add"
                            android:background="@color/brand_primary"
                            android:padding="3dp"
                            android:tint="@color/text_primary"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Your story"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Contact story avatars injected here by HomeFragment -->
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

    <!-- ── Feed Toggle ── (hidden — replaced by Instagram header with dropdown) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/btn_home_following"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Following"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:paddingEnd="20dp"
                android:gravity="center_vertical"
                android:alpha="1.0"/>

            <TextView
                android:id="@+id/btn_home_for_you"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="For You"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:paddingEnd="20dp"
                android:gravity="center_vertical"
                android:alpha="0.55"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/btn_home_search"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_search"
                android:tint="@color/text_primary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginEnd="4dp"
                android:contentDescription="Search"/>

            <ImageButton
                android:id="@+id/btn_home_upload"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_add_reels"
                android:tint="@color/text_primary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Upload Post"/>
        </LinearLayout>

        <!-- Active-tab underline indicator -->
        <View
            android:id="@+id/v_feed_indicator"
            android:layout_width="70dp"
            android:layout_height="2dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:background="@color/brand_primary"/>
    </FrameLayout>

</LinearLayout>
