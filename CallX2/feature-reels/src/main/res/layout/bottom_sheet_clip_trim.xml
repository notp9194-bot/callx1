<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#161616"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Trim clip" android:textColor="#FFFFFF" android:textSize="16sp"
        android:fontFamily="sans-serif-medium" android:layout_marginBottom="4dp"/>

    <TextView android:id="@+id/tv_clip_trim_duration"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="0:00" android:textColor="#00E5FF" android:textSize="13sp"
        android:layout_marginBottom="16dp"/>

    <com.callx.app.views.VideoTrimFilmstripView
        android:id="@+id/clip_trim_filmstrip"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginBottom="20dp"/>

    <Button android:id="@+id/btn_clip_trim_done"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Done" android:textColor="#000000"
        android:backgroundTint="#00E5FF"/>

</LinearLayout>
