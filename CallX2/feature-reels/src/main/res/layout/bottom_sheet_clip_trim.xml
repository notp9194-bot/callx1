<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#161616"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Trim clip" android:textColor="#FFFFFF" android:textSize="16sp"
        android:fontFamily="sans-serif-medium" android:layout_marginBottom="4dp"/>

    <TextView android:id="@+id/tv_clip_trim_duration"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="0:00" android:textColor="#00E5FF" android:textSize="13sp"
        android:layout_marginBottom="12dp"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="12dp"
        android:background="#000000">

        <androidx.media3.ui.PlayerView
            android:id="@+id/clip_trim_player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:resize_mode="fit"/>

        <ImageButton android:id="@+id/btn_clip_trim_play_pause"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_action"
            android:src="@drawable/ic_play"
            android:contentDescription="Play"
            android:padding="12dp"/>
    </FrameLayout>

    <com.callx.app.views.VideoTrimFilmstripView
        android:id="@+id/clip_trim_filmstrip"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <ImageButton android:id="@+id/btn_clip_trim_split"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_content_cut"
            android:padding="6dp"
            android:contentDescription="Split at playhead"/>

        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Split at playhead"
            android:textColor="#CCCCCC" android:textSize="13sp"/>
    </LinearLayout>

    <Button android:id="@+id/btn_clip_trim_done"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Done" android:textColor="#000000"
        android:backgroundTint="#00E5FF"/>

</LinearLayout>
