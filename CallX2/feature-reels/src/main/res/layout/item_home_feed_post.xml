<?xml version="1.0" encoding="utf-8"?>
<!--
  item_home_feed_post.xml — Instagram-style Reels home feed card
  ■ Video fills 9:16 aspect (height set in Java from screen width)
  ■ Header (avatar + username + suggested + audio) overlaid on video — top gradient
  ■ Mute button overlaid — bottom-right of video
  ■ End-of-reel overlay — "Watch more reels" pill + "Watch again" text — GONE by default
  ■ Action bar (❤ | 💬 | 🔄 | ▷ | 🔖) below video with counts — theme-aware
    (background_light / text_primary / text_secondary) so it switches
    properly between light and dark mode instead of staying hardcoded black.
  ■ Timestamp + caption below action bar — also theme-aware
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="12dp"><!-- 🐛 FIX: was 2dp — Post feed's separate header row adds
        ~10dp of its own top padding before the next card's content starts, so its
        cards read as visibly separated. Home feed's header is overlaid ON the video
        (no such padding), so 2dp made back-to-back reels look like one continuous
        video with no boundary — bumped to 12dp to match Post feed's effective gap.
        PERF: no background here on purpose.
        fragment_home's root is already @color/background_light, so painting
        the same colour again per card is a full extra overdraw pass over the
        entire feed area on every frame. The video block below draws its own
        opaque black, and the text/action rows sit on the fragment colour. -->

    <!-- ══════════ VIDEO BLOCK ══════════ -->
    <!-- Always solid black, in both light & dark mode — the video itself
         should never switch to a light background (Instagram behaves the
         same way). Only the content BELOW the video (action bar, counts,
         timestamp, caption) follows the app theme. -->
    <FrameLayout
        android:id="@+id/frame_video"
        android:layout_width="match_parent"
        android:layout_height="600dp"
        android:background="#000000">
        <!-- height overridden in Java: screenWidth × 16/9 for exact 9:16 -->

        <!-- ExoPlayer surface — MediaItem set in HomeFragment -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/pv_feed_post"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:resize_mode="zoom"
            app:surface_type="surface_view"/>

        <!-- Thumbnail — shown until video starts, fades out -->
        <ImageView
            android:id="@+id/iv_post_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#111111"/>

        <!-- ── Overlaid header strip at top of video ── -->
        <LinearLayout
            android:id="@+id/overlay_post_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="14dp"
            android:paddingBottom="20dp">

            <!-- ── Normal solo-owner row: avatar + username/suggested/audio ──
                 GONE (in favor of stub_home_collab_row below) when the reel
                 has collaborators — same merged-row swap ReelUiController
                 does for the immersive Reels player (ll_owner_row vs
                 ll_collab_second_author). -->
            <LinearLayout
                android:id="@+id/ll_post_owner_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Avatar + optional gradient ring -->
                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp">

                    <ImageView
                        android:id="@+id/iv_post_story_ring"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_gravity="center"
                        android:background="@drawable/story_ring_insta_gradient"
                        android:visibility="gone"/>

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/iv_post_avatar"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_person"
                        app:civ_border_width="0dp"
                        app:civ_border_color="@android:color/transparent"/>

                    <!-- Legacy dual-avatar overlap — only used as a fallback
                         for old collabInitiatorUid/collabColaboratorUid data
                         that predates the multi-collaborator stack above.
                         GONE for solo posts and for the new collab system. -->
                    <LinearLayout
                        android:id="@+id/layout_collab_avatar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:orientation="horizontal"
                        android:visibility="gone"/>
                </FrameLayout>

                <!-- Username + Suggested + Audio -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_post_owner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@username"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium"/>

                        <ImageView
                            android:id="@+id/iv_post_verified"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_marginStart="3dp"
                            android:src="@drawable/ic_verified_pink"
                            android:visibility="gone"
                            android:contentDescription="Verified"/>
                    </LinearLayout>

                    <!-- Shown only for suggested / For You posts -->
                    <TextView
                        android:id="@+id/tv_post_suggested"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Suggested for you"
                        android:textColor="#CCCCCC"
                        android:textSize="11sp"
                        android:visibility="gone"/>

                    <!-- Audio track info -->
                    <TextView
                        android:id="@+id/tv_post_audio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_music"
                        android:drawablePadding="4dp"
                        android:drawableTint="#CCCCCC"
                        android:text="Original audio"
                        android:textColor="#CCCCCC"
                        android:textSize="11sp"
                        android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ── Collab / multi-collaborator merged row — REUSED as-is from
                 the Reels play screen (stub_reel_collab_row.xml): overlapping
                 avatar stack (CollabAvatarStackView) + "@owner and N others"
                 + Follow, same ids (collab_avatar_stack, tv_collab_author_name,
                 tv_collab_follow_btn, ll_collab_song_row / tv_collab_song_name)
                 so HomeFragment can drive it with the exact same binding code
                 as ReelUiController. GONE unless the reel has collaborators. -->
            <ViewStub
                android:id="@+id/stub_home_collab_row"
                android:inflatedId="@+id/ll_collab_second_author"
                android:layout="@layout/stub_reel_collab_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <!-- Follow pill — GONE by default -->
            <TextView
                android:id="@+id/btn_post_follow"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Follow"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_reel_follow_btn"
                android:visibility="gone"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- More / ≡ -->
            <ImageButton
                android:id="@+id/btn_post_more"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_more_vert"
                android:tint="#FFFFFF"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More"/>
        </LinearLayout>

        <!-- ── Collab icon — bottom-LEFT corner of the video, mirror of the
             mute/audio-cover tiles on the bottom-right. Same circular chip
             look (bg_mute_toggle_circle) so it reads as part of the same
             video-chrome family. Tapping opens the exact same
             CollaboratorsBottomSheet as tapping the "@owner and N others"
             collab row/avatar stack above (see HomeFragment bind logic) —
             this just gives collab posts a second, always-reachable entry
             point lower on the card, same idea as Instagram surfacing collab
             credit in more than one spot on a multi-author post.
             GONE for solo posts (no collaborators) — shown only when
             isCollabStackDisplay is true, same condition that inflates
             stub_home_collab_row above. -->
        <ImageButton
            android:id="@+id/btn_post_collab_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="34dp"
            android:src="@drawable/ic_group"
            android:tint="#FFFFFF"
            android:background="@drawable/bg_mute_toggle_circle"
            android:padding="6dp"
            android:contentDescription="Collaborators"
            android:visibility="gone"/>

        <!-- Mute toggle — sits above the audio-cover tile, bottom-right corner of video -->
        <ImageButton
            android:id="@+id/btn_post_mute"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="70dp"
            android:src="@drawable/ic_volume_off"
            android:tint="#FFFFFF"
            android:background="@drawable/bg_mute_toggle_circle"
            android:padding="5dp"
            android:contentDescription="Mute"/>

        <!-- Audio-cover tile — reused from the immersive Reels player's right
             action rail (see fragment_reel_player.xml's btn_create_audio /
             ReelUiController), same rounded-square look (bg_audio_create_tile),
             same 28dp size as the player, pinned to the bottom-right corner
             of the content instead of being the last item in a vertical
             action rail. Tapping opens the same sound-detail screen (see
             openHomeCardSoundDetail()). GONE when the post has no attached
             music. -->
        <ImageButton
            android:id="@+id/btn_post_audio_cover"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="34dp"
            android:src="@drawable/ic_audio"
            android:scaleType="centerCrop"
            android:padding="2dp"
            android:background="@drawable/bg_audio_create_tile"
            android:contentDescription="Original audio"
            android:visibility="gone"/>

        <!-- ── Center play button — shown when autoplay is off (feed
             settings) or the user tapped to pause. Tap = play. ── -->
        <ImageView
            android:id="@+id/btn_post_play_overlay"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play"
            android:tint="#FFFFFF"
            android:alpha="0.9"
            android:padding="14dp"
            android:background="#66000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:contentDescription="Play"/>

        <!-- ── "2x" chip — visible only while the user holds the video
             down (press-and-hold fast-forward, like Instagram/YouTube) ── -->
        <TextView
            android:id="@+id/tv_post_speed_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="72dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_speed_chip"
            android:text="2x  ▶▶"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone"/>

        <!-- ── Elapsed / total time — shown while scrubbing the bar ── -->
        <TextView
            android:id="@+id/tv_post_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="26dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_speed_chip"
            android:text="0:00 / 0:00"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:visibility="gone"/>

        <!-- ── Scrubbable progress bar — pinned to the bottom edge of the
             video, same slim track drawable the full-screen player uses ── -->
        <SeekBar
            android:id="@+id/sb_post_progress"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_gravity="bottom"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/progress_reel_seekbar"
            android:thumb="@drawable/thumb_reel_seek"
            android:splitTrack="false"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:contentDescription="Seek"/>

        <!-- ── End-of-reel overlay — GONE until video ends ── -->
        <LinearLayout
            android:id="@+id/layout_end_of_reel_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#66000000"
            android:visibility="gone">

            <!-- "Watch more reels" white pill -->
            <LinearLayout
                android:id="@+id/btn_watch_more_card"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:background="@drawable/bg_watch_more_pill"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_play"
                    android:tint="#000000"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Watch more reels"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

            <!-- "Watch again" plain text below pill -->
            <TextView
                android:id="@+id/btn_watch_again_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Watch again"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>

        <!-- Double tap like animation — same drawable/style as the immersive
             player's iv_like_anim (fragment_reel_player.xml), just placed
             here so double-tap-to-like works in the Home feed card too. -->
        <ImageView
            android:id="@+id/iv_post_like_anim"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_heart_filled"
            android:tint="#FF416C"
            android:visibility="gone"
            android:alpha="0"
            android:contentDescription="Like animation"/>

    </FrameLayout>
    <!-- ═══ End video block ═══ -->

    <!-- ══════════ Multi-photo page-indicator dots ══════════ -->
    <!-- Sits BELOW the media (Instagram-style), not overlaid on top of it —
         only shown/populated in Java for multi-photo posts (see
         HomeFragment holder.photoDots). GONE by default / for video reels
         and single-photo posts. -->
    <FrameLayout
        android:id="@+id/frame_photo_dots_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone"/>

    <!-- ══════════ ACTION BAR — Instagram-style spacing ══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- ❤ Like + count group -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="14dp">

            <ImageButton
                android:id="@+id/btn_post_like"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_heart"
                android:tint="@color/text_primary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Like"/>

            <TextView
                android:id="@+id/tv_post_likes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- 💬 Comment + count group -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="14dp">

            <ImageButton
                android:id="@+id/btn_post_comment"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_comment_reel"
                android:tint="@color/text_primary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Comment"/>

            <TextView
                android:id="@+id/tv_post_comments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- 🔄 Repost + count group -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="14dp">

            <ImageButton
                android:id="@+id/btn_post_repost"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_repost"
                android:tint="@color/text_primary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Repost"/>

            <TextView
                android:id="@+id/tv_post_reposts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- ▷ Send / Share + count group -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/btn_post_send"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_share_reel"
                android:tint="@color/text_primary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Send"/>

            <TextView
                android:id="@+id/tv_post_sends"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- 🔖 Save — right-aligned spacer -->
        <ImageButton
            android:id="@+id/btn_post_save"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_bookmark"
            android:tint="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Save"/>
    </LinearLayout>

    <!-- Caption -->
    <!-- 🐛 FIX: caption now comes BEFORE the timestamp, to match Post feed's
         order (item_post_feed_photo.xml) — was time-then-caption here, which
         made the two feeds show reels/posts in a visibly different order and
         confused users into thinking they were different content types. -->
    <TextView
        android:id="@+id/tv_post_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="2dp"
        android:text=""
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end"/>

    <!-- "more / less" expand toggle for long captions -->
    <TextView
        android:id="@+id/tv_post_read_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp"
        android:text="more"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Instagram-style social context below the caption. These are hidden
         for legacy reels that have no corresponding metadata. -->
    <TextView
        android:id="@+id/tv_post_liked_by"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"/>

    <TextView
        android:id="@+id/tv_post_comment_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="2dp"
        android:paddingBottom="3dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone"
        android:id="@+id/scroll_post_tagged_people">
        <LinearLayout
            android:id="@+id/layout_post_tagged_people"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone"
        android:id="@+id/scroll_post_product_tags">
        <LinearLayout
            android:id="@+id/layout_post_product_tags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tv_post_translate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:text="See translation"
        android:textColor="@color/brand_primary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"/>

    <TextView
        android:id="@+id/tv_post_translation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="3dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:visibility="gone"/>

    <!-- Timestamp -->
    <TextView
        android:id="@+id/tv_post_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="1 day ago"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"/>

</LinearLayout>
