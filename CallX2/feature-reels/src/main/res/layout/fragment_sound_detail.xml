<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_sound_detail.xml  —  SINGLE layout used by both:
      • SoundDetailActivity  (hosts SoundDetailFragment, isSheet=false → drag handle GONE)
      • SoundDetailSheetFragment (hosts SoundDetailFragment, isSheet=true  → drag handle VISIBLE)

    Fragment programmatically controls drag-handle visibility + close icon at runtime.

    Root is a MaterialCardView (not a plain FrameLayout) so the top corners
    can actually round off in sheet mode. The BottomSheetDialog's own
    container already draws rounded top corners by default, but a plain
    View's flat rectangular background paints straight over them — only a
    Shapeable container like MaterialCardView clips its children to the
    corner shape. applyMode() in SoundDetailFragment.java sets the corner
    radius: rounded top corners when isSheet, flat (0dp, unchanged) in
    Activity mode.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_sound_detail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/sound_detail_bg_light"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:contentPadding="0dp">


    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_sound_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/sound_detail_bg_light"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Drag handle — GONE in Activity mode, VISIBLE in Sheet mode (set by Fragment) -->
            <View
                android:id="@+id/view_drag_handle"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_drag_handle"
                android:visibility="gone"/>

            <!-- Top bar — background matched to the panel card
                 (?attr/colorSurface) so header, panel, and grid all sit on
                 the exact same surface colour in both light/dark mode. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:background="?attr/colorSurface">

                <!-- Back (Activity) / Close (Sheet) — icon set by Fragment -->
                <ImageButton
                    android:id="@+id/btn_sound_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_arrow_back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="@color/text_primary"
                    android:contentDescription="Back"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sound"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium"/>

                <ImageButton
                    android:id="@+id/btn_sound_share"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_share_reel"
                    android:tint="@color/text_primary"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Share sound"/>

                <ImageButton
                    android:id="@+id/btn_save_sound"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_bookmark"
                    android:tint="@color/text_primary"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Save sound"/>

                <ImageButton
                    android:id="@+id/btn_sound_more"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_more_vert"
                    android:tint="@color/text_primary"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="More options"/>
            </LinearLayout>

            <!-- Shimmer skeleton -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmer_sound_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View android:layout_width="80dp" android:layout_height="80dp"
                        android:background="@drawable/bg_skeleton_circle"/>

                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <View android:layout_width="140dp" android:layout_height="16dp"
                            android:background="@drawable/bg_skeleton_rect"/>
                        <View android:layout_width="90dp" android:layout_height="12dp"
                            android:background="@drawable/bg_skeleton_rect" android:layout_marginTop="8dp"/>
                        <View android:layout_width="110dp" android:layout_height="12dp"
                            android:background="@drawable/bg_skeleton_rect" android:layout_marginTop="6dp"/>
                    </LinearLayout>

                    <View android:layout_width="52dp" android:layout_height="52dp"
                        android:background="@drawable/bg_skeleton_circle"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="8dp"
                    android:background="@drawable/bg_skeleton_rect" android:layout_marginTop="24dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="20dp">
                    <View android:layout_width="38dp" android:layout_height="38dp"
                        android:background="@drawable/bg_skeleton_circle"/>
                    <View android:layout_width="100dp" android:layout_height="14dp"
                        android:background="@drawable/bg_skeleton_rect" android:layout_marginStart="12dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="20dp">
                    <View android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                        android:background="@drawable/bg_skeleton_rect" android:layout_marginEnd="8dp"/>
                    <View android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                        android:background="@drawable/bg_skeleton_rect"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="24dp">
                    <View android:layout_width="0dp" android:layout_height="160dp" android:layout_weight="1"
                        android:background="@drawable/bg_skeleton_rect" android:layout_marginEnd="2dp"/>
                    <View android:layout_width="0dp" android:layout_height="160dp" android:layout_weight="1"
                        android:background="@drawable/bg_skeleton_rect" android:layout_marginEnd="2dp"/>
                    <View android:layout_width="0dp" android:layout_height="160dp" android:layout_weight="1"
                        android:background="@drawable/bg_skeleton_rect"/>
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- Sound info card -->
            <LinearLayout
                android:id="@+id/layout_sound_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/colorSurface"
                android:paddingHorizontal="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <!-- Cover + meta -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">

                    <FrameLayout android:layout_width="111dp" android:layout_height="148dp">
                        <!-- Soft glow behind the cover — replaces a hard-edge
                             card shadow with a gentle radial bloom, per the
                             "soft shadow (glow-style, no hard border)" brief. -->
                        <View android:layout_width="111dp" android:layout_height="148dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_sound_cover_glow"/>
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_sound_cover"
                            android:layout_width="99dp" android:layout_height="136dp"
                            android:layout_gravity="center"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_music_note"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.SoundDetail.Cover"/>
                        <View android:layout_width="34dp" android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_reel_play_badge"/>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:layout_marginStart="2dp"
                            android:src="@drawable/ic_play_rounded"/>
                        <!-- Vinyl-ring decoration removed — this cover no
                             longer spins during playback, so the ring (and
                             its rotation) is gone in favor of a plain,
                             larger static thumbnail (screenshot-style). -->
                        <ImageView android:id="@+id/iv_disc_ring"
                            android:layout_width="99dp" android:layout_height="136dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_music_disc"
                            android:tint="@color/sound_detail_button_light"
                            android:scaleType="fitXY"
                            android:visibility="gone"/>
                    </FrameLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:id="@+id/tv_sound_title"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Sound Title"
                                android:textColor="@color/sound_detail_text_light"
                                android:textSize="20sp" android:fontFamily="sans-serif-medium"
                                android:maxLines="2" android:ellipsize="end"/>
                            <!-- Verified badge — UI only, always shown next to the
                                 title (no real verification-status logic wired up),
                                 matching the pink checkmark badge from the screenshot.
                                 Sourced from core/drawable/ic_verified_pink (moved
                                 there so other screens/modules can reuse the same
                                 badge instead of each keeping their own copy). -->
                            <ImageView android:id="@+id/iv_sound_title_verified"
                                android:layout_width="16dp" android:layout_height="16dp"
                                android:layout_marginStart="4dp"
                                android:src="@drawable/ic_verified_pink"
                                android:contentDescription="Verified"/>
                        </LinearLayout>

                        <TextView android:id="@+id/tv_sound_artist"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="• Original Audio"
                            android:textColor="@color/sound_detail_subtext_light"
                            android:textSize="13sp" android:layout_marginTop="3dp"/>

                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginTop="6dp">
                            <TextView android:id="@+id/tv_sound_reel_count"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0 Reels"
                                android:textColor="@color/sound_detail_text_light"
                                android:textSize="13sp" android:fontFamily="sans-serif-medium"/>
                            <TextView android:id="@+id/tv_sound_saves_count"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="•  0 Saves"
                                android:textColor="@color/sound_detail_text_light"
                                android:textSize="13sp" android:fontFamily="sans-serif-medium"
                                android:visibility="gone"/>
                        </LinearLayout>

                        <!-- Original / Trending — rounded chip row -->
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginTop="10dp">
                            <TextView android:id="@+id/tv_sound_original_badge"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Original" android:textColor="@color/brand_primary"
                                android:textSize="12sp" android:fontFamily="sans-serif-medium"
                                android:background="@drawable/bg_sound_stat_chip"
                                android:drawableStart="@drawable/ic_sound_note_outline"
                                android:drawableTint="@color/brand_primary"
                                android:drawablePadding="5dp"
                                android:paddingHorizontal="12dp" android:paddingVertical="6dp"
                                android:visibility="gone"/>
                            <TextView android:id="@+id/tv_sound_trending_rank"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Trending" android:textColor="@color/brand_primary"
                                android:textSize="12sp" android:fontFamily="sans-serif-medium"
                                android:background="@drawable/bg_sound_stat_chip"
                                android:drawableStart="@drawable/ic_sound_flame_outline"
                                android:drawableTint="@color/brand_primary"
                                android:drawablePadding="5dp"
                                android:paddingHorizontal="12dp" android:paddingVertical="6dp"
                                android:layout_marginStart="8dp" android:visibility="gone"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <TextView android:id="@+id/tv_sound_bpm"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="@color/sound_detail_subtext_light"
                                android:textSize="11sp" android:visibility="gone"/>
                            <TextView android:id="@+id/tv_sound_genre"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="@color/sound_detail_subtext_light"
                                android:textSize="11sp" android:layout_marginStart="8dp"
                                android:visibility="gone"/>
                            <TextView android:id="@+id/tv_sound_verified_badge"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="✓ Verified" android:textColor="@color/brand_primary"
                                android:textSize="10sp" android:fontFamily="sans-serif-medium"
                                android:layout_marginStart="8dp" android:visibility="gone"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Play/pause control — glow + gradient ring, matching
                         the screenshot's vibrant ring. Ring itself is set
                         programmatically in SoundDetailFragment (shared
                         StoryRingGradientDrawable, same pink→red→orange→yellow
                         sweep used app-wide for story rings) so it never goes
                         out of sync with the brand palette. -->
                    <!-- Play button — premium refine: the gradient ring +
                         glow bloom (StoryRingGradientDrawable / PlayRingGlowDrawable,
                         same rainbow sweep used for story rings app-wide)
                         removed per request — a loud multicolor ring read
                         as the least restrained element on an otherwise flat,
                         brand-green, minimal screen. Replaced with a plain
                         flat solid circle (bg_sound_play_btn — brand_primary
                         fill, no border/shadow/gradient) and a white icon,
                         consistent with the rest of the flat redesign. -->
                    <FrameLayout android:id="@+id/layout_play_ring_container"
                        android:layout_width="56dp" android:layout_height="56dp"
                        android:layout_gravity="center_vertical">

                        <ImageButton android:id="@+id/btn_sound_play_pause"
                            android:layout_width="56dp" android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_play" android:tint="@android:color/white"
                            android:background="@drawable/bg_sound_play_btn"
                            android:padding="16dp" android:contentDescription="Play preview"/>
                    </FrameLayout>
                </LinearLayout>

                <!-- Waveform + progress card — single rounded box using this
                     screen's own bg_sound_detail_box (bg_card_rounded's
                     ?attr/colorSurfaceVariant resolves to plain white in
                     light mode, same as the panel bg, so it was invisible). -->
                <LinearLayout android:id="@+id/card_sound_waveform"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_sound_detail_box"
                    android:padding="16dp"
                    android:layout_marginTop="20dp">

                    <!-- Thin, minimal seekbar — custom 3dp track + 10dp thumb
                         (bg_seekbar_track_sound / ic_seekbar_thumb_sound)
                         instead of the default chunky Material seekbar. -->
                    <SeekBar android:id="@+id/seekbar_sound"
                        android:layout_width="match_parent" android:layout_height="18dp"
                        android:progressDrawable="@drawable/bg_seekbar_track_sound"
                        android:thumb="@drawable/ic_seekbar_thumb_sound"
                        android:thumbTint="@null"
                        android:progressTint="@null"
                        android:splitTrack="false"
                        android:max="100"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="4dp">
                        <TextView android:id="@+id/tv_sound_current_time"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0:00" android:textColor="@color/sound_detail_subtext_light"
                            android:textSize="10sp"/>
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                        <TextView android:id="@+id/tv_sound_total_time"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0:00" android:textColor="@color/sound_detail_subtext_light"
                            android:textSize="10sp"/>
                    </LinearLayout>

                    <!-- Waveform — single Canvas view (SoundWaveformView) instead of
                         36 child Views each driven by its own ValueAnimator. See
                         SoundWaveformView's class doc for why: setLayoutParams() on
                         a LinearLayout child forces a full layout pass per frame,
                         36x, continuously, while playing. This draws all 36 bars in
                         one onDraw() and only ever calls invalidate(). -->
                    <com.callx.app.music.SoundWaveformView
                        android:id="@+id/waveform_sound"
                        android:layout_width="match_parent" android:layout_height="26dp"
                        android:layout_marginTop="12dp"/>
                </LinearLayout>

                <!-- Creator row — now boxed, reusing the same
                     bg_sound_detail_box drawable as the waveform card and
                     the use-sound buttons below, so it reads as one
                     consistent "box" style across the panel instead of a
                     bare selectable row. Ripple kept via android:foreground
                     since the background slot is now taken by the box. -->
                <LinearLayout android:id="@+id/layout_sound_creator"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="62dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/bg_sound_detail_box"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginTop="16dp" android:paddingHorizontal="14dp"
                    android:visibility="gone">
                    <ImageView android:id="@+id/iv_creator_avatar"
                        android:layout_width="44dp" android:layout_height="44dp"
                        android:scaleType="centerCrop" android:src="@drawable/ic_person"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Original Creator"
                            android:textColor="@color/sound_detail_subtext_light"
                            android:textSize="10sp" android:fontFamily="sans-serif-medium"
                            android:textAllCaps="true" android:letterSpacing="0.06"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginTop="1dp">
                            <TextView android:id="@+id/tv_creator_name"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@username"
                                android:textColor="@color/sound_detail_text_light"
                                android:textSize="15sp" android:fontFamily="sans-serif-medium"
                                android:maxLines="1" android:ellipsize="end"/>
                            <!-- Verified badge — UI only, always shown next to the
                                 creator username (no real verification-status
                                 logic wired up), matching the screenshot. -->
                            <ImageView android:id="@+id/iv_creator_verified"
                                android:layout_width="13dp" android:layout_height="13dp"
                                android:layout_marginStart="3dp"
                                android:src="@drawable/ic_verified_pink"
                                android:contentDescription="Verified"/>
                        </LinearLayout>
                        <TextView android:id="@+id/tv_creator_followers"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0 followers"
                            android:textColor="@color/sound_detail_subtext_light"
                            android:textSize="12sp"
                            android:maxLines="1" android:ellipsize="end" android:layout_marginTop="1dp"/>
                    </LinearLayout>
                    <!-- Follow/Following pill button — reused from
                         FollowConnectionsActivity / ReelLikesBottomSheet /
                         ReelSharesBottomSheet for visual consistency; style
                         applied programmatically in
                         SoundDetailFragment#styleFollowBtn(). Hidden for
                         own sound (creator == current user). Height/text
                         matched to UserReelsActivity's Follow/Message/Call
                         row (layout_instagram_cta) for the same thin,
                         Instagram-style pill look across the app. -->
                    <Button android:id="@+id/btn_follow_creator"
                        android:layout_width="wrap_content" android:layout_height="32dp"
                        android:text="Follow" android:textSize="12sp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:paddingTop="0dp" android:paddingBottom="0dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_follow_action_btn"
                        android:textColor="@android:color/white"
                        app:textAllCaps="false"
                        android:minWidth="0dp" android:minHeight="0dp"
                        android:visibility="gone"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_forward"
                        android:tint="#8064748B" android:scaleType="fitCenter"/>
                </LinearLayout>

                <!-- divider_creator removed — the creator row is now its own
                     boxed card (see layout_sound_creator above), so a hairline
                     divider right under it is redundant and was left over from
                     when the row was a bare selectable list item. -->

                <!-- Use in Camera / Use with Video / Add to profile — all
                     three in ONE row now (previously 2 + a separate
                     full-width row below). Same icon+text-wrapped-as-one-
                     centered-group pattern for all three so the plus icon
                     doesn't dock to the edge (Android drawableStart quirk).
                     30dp height, equal weight, thin Instagram-style pills. -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="22dp">
                    <FrameLayout android:id="@+id/btn_use_sound_camera"
                        android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="0.85"
                        android:background="@drawable/bg_sound_detail_action_btn"
                        android:layout_marginEnd="8dp">
                        <LinearLayout
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="14dp" android:layout_height="14dp"
                                android:src="@drawable/ic_sound_camera_outline"
                                android:tint="@color/sound_detail_text_light"
                                android:layout_marginEnd="5dp"/>
                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Camera"
                                android:textColor="@color/sound_detail_text_light" android:textSize="11sp"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                    </FrameLayout>
                    <FrameLayout android:id="@+id/btn_use_sound_gallery"
                        android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="0.85"
                        android:background="@drawable/bg_sound_detail_action_btn"
                        android:layout_marginEnd="8dp">
                        <LinearLayout
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="14dp" android:layout_height="14dp"
                                android:src="@drawable/ic_sound_video_outline"
                                android:tint="@color/sound_detail_text_light"
                                android:layout_marginEnd="5dp"/>
                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Video"
                                android:textColor="@color/sound_detail_text_light" android:textSize="11sp"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                    </FrameLayout>
                    <!-- Wider weight (1.3 vs 0.85) than the two boxes above so
                         the full "Add to profile" text fits on one line
                         without ellipsizing or shrinking to just "Add". -->
                    <FrameLayout android:id="@+id/btn_add_to_profile"
                        android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1.3"
                        android:background="@drawable/bg_sound_detail_action_btn"
                        android:visibility="gone">
                        <LinearLayout
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="14dp" android:layout_height="14dp"
                                android:src="@drawable/ic_add_reels"
                                android:tint="@color/sound_detail_text_light"
                                android:layout_marginEnd="4dp"/>
                            <TextView android:id="@+id/tv_add_to_profile"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Add to profile"
                                android:textColor="@color/sound_detail_text_light" android:textSize="10sp"
                                android:maxLines="1" android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Buffering -->
            <ProgressBar android:id="@+id/progress_sound"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/brand_primary"
                android:layout_marginVertical="8dp" android:visibility="gone"/>

            <!-- Reels header — background matched to the panel card
                 (?attr/colorSurface) too, same token as the top bar,
                 the info panel, and the grid below, so this row doesn't
                 fall back to the screen background (sound_detail_bg_light),
                 which is a different shade from colorSurface in dark mode. -->
            <LinearLayout android:id="@+id/layout_reels_header"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="?attr/colorSurface"
                android:paddingHorizontal="16dp" android:paddingTop="8dp"
                android:paddingBottom="8dp" android:visibility="gone">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Reels with this sound"
                    android:textColor="@color/sound_detail_text_light" android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"/>
                <TextView android:id="@+id/tv_see_all_reels"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="See all" android:textColor="@color/brand_primary"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- Reels grid — background matched to the panel card
                 (?attr/colorSurface), same as the top bar above. -->
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_sound_reels"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurface"
                android:padding="1dp"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false" android:clipChildren="false"
                android:overScrollMode="never"/>

            <!-- Pagination spinner -->
            <ProgressBar android:id="@+id/progress_reels_pagination"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/brand_primary"
                android:layout_marginVertical="10dp" android:visibility="gone"/>

            <!-- Related sounds -->
            <LinearLayout android:id="@+id/layout_related_sounds_section"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingTop="16dp" android:paddingBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Similar Sounds"
                        android:textColor="@color/sound_detail_text_light" android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView android:id="@+id/tv_see_all_related"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="See all" android:textColor="@color/brand_primary"
                        android:textSize="13sp"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_related_sounds"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp" android:paddingBottom="16dp"
                    android:clipToPadding="false"/>
            </LinearLayout>

            <!-- Mini-player — SwipeAwareFrameLayout so swipe-up/down-to-close
                 (MediaSwipeReplyCloseHelper, same as MediaViewerActivity) can
                 hook every touch event first, same as an Activity's
                 dispatchTouchEvent or a PopupWindow's setTouchInterceptor. -->
            <com.callx.app.utils.SwipeAwareFrameLayout android:id="@+id/layout_mini_player"
                android:layout_width="match_parent" android:layout_height="64dp"
                android:background="@drawable/bg_sound_detail_box"
                android:visibility="gone"
                android:layout_marginHorizontal="12dp" android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">
                    <ImageView android:id="@+id/iv_mini_cover"
                        android:layout_width="40dp" android:layout_height="40dp"
                        android:scaleType="centerCrop" android:src="@drawable/ic_music_note"/>
                    <TextView android:id="@+id/tv_mini_title"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/sound_detail_text_light" android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1" android:ellipsize="end" android:layout_marginStart="10dp"/>
                    <ImageButton android:id="@+id/btn_mini_play_pause"
                        android:layout_width="40dp" android:layout_height="40dp"
                        android:src="@drawable/ic_pause" android:tint="@color/brand_primary"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Mini play/pause"/>
                    <ImageButton android:id="@+id/btn_mini_close"
                        android:layout_width="40dp" android:layout_height="40dp"
                        android:src="@drawable/ic_close" android:tint="@color/icon_tint"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Close mini player"/>
                </LinearLayout>
            </com.callx.app.utils.SwipeAwareFrameLayout>

            <!-- Bottom nav padding -->
            <View android:layout_width="match_parent" android:layout_height="80dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating "Use audio / Save" bar -->
    <LinearLayout android:id="@+id/layout_floating_sound_actions"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:visibility="gone">
        <TextView android:id="@+id/btn_floating_use_audio"
            android:layout_width="wrap_content" android:layout_height="44dp"
            android:minWidth="150dp" android:gravity="center"
            android:text="🎵  Use audio" android:textColor="@color/white"
            android:textSize="14sp" android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="20dp"
            android:background="@drawable/bg_pill_dark_solid"
            android:layout_marginEnd="10dp"/>
        <TextView android:id="@+id/btn_floating_save"
            android:layout_width="wrap_content" android:layout_height="44dp"
            android:minWidth="90dp" android:gravity="center"
            android:text="🔖  Save" android:textColor="@color/white"
            android:textSize="14sp" android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="18dp"
            android:background="@drawable/bg_pill_dark_solid"/>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
