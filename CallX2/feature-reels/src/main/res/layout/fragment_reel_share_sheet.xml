<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_reel_share_sheet.xml
    BottomSheetDialogFragment ka layout — CoordinatorLayout aur backdrop hata diye.
    Material ka BottomSheetDialog apna backdrop/dim/animation khud handle karta hai.
-->
<!--
    ★ FIX: root ab WRAP_CONTENT hai (match_parent + weight=1 RecyclerView wala
    approach ek real bug tha — us se content ki total height ~screen-height
    jitni ban jaati thi, aur button row (last child) us tall content ke bottom
    pe chala jaata tha, jo collapsed/peek window (jo hamesha content ka UPAR ka
    hissa dikhata hai) ke bahar clip ho jaata tha — button row kabhi dikhta hi
    nahi tha. Ab poora content apni natural (chhoti) height me rehta hai, aur
    grow/shrink ReelShareSheetFragment#animateSheetContent() se explicitly,
    state-change par (drag khatam hone ke baad) animate hota hai — peek-clip
    pe depend nahi karta.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="@color/divider"/>

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Share Reel"
            android:textSize="17sp"
            android:fontFamily="sans-serif-bold"
            android:textColor="#FFE082"/>

        <ImageButton
            android:id="@+id/btn_share_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_close"
            android:tint="?attr/colorOnSurface"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"/>
    </LinearLayout>

    <!-- ★ NEW: search box to filter the "Send to" contact grid below —
         ReelShareSheetFragment wires a TextWatcher that calls
         ReelContactShareAdapter#filter() on every keystroke. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search_bar"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_search"
            android:tint="?attr/colorOnSurfaceVariant"/>

        <EditText
            android:id="@+id/et_share_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:hint="Search"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:inputType="text"/>
    </LinearLayout>

    <!-- Send to contacts label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Send to"
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:paddingStart="16dp"
        android:layout_marginBottom="8dp"/>

    <ProgressBar
        android:id="@+id/progress_share"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        android:visibility="visible"/>

    <!--
        ★ FIX: ab EXPLICIT fixed height hai (pehle 0dp+weight=1 tha, jo root
        wrap_content hone ki wajah se 0dp resolve ho jaata — ya match_parent
        root ke sath poori screen jitna ban jaata, dono hi galat the).
        230dp collapsed state me ~2 avatar-rows dikhata hai; upar kheenchne pe
        ReelShareSheetFragment#animateSheetContent() ye height animate karke
        RV_EXPANDED_MAX_DP tak badhata hai (actual contact count se clamp) — extra rows reveal hote hain.
        GridLayoutManager(spanCount=3) Java (onViewCreated) me set hota hai.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_share_contacts"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"/>

    <!--
        ★ NEW: multi-select send bar — hidden (GONE) until at least one
        contact is checked in the grid above. ReelShareSheetFragment shows
        this via ReelContactShareAdapter.OnSelectionChangedListener and
        leaves ll_share_button_row (Copy Link / Share via / Story / Status /
        Repost, further below) untouched so its own expand/collapse height
        animation is never disturbed by selection state.
    -->
    <LinearLayout
        android:id="@+id/ll_selection_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="10dp">

        <EditText
            android:id="@+id/et_share_message"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_search_bar"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:hint="Write a message…"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:maxLines="1"
            android:imeOptions="actionDone"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btn_send_separately"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Send separately"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5B6EF5"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btn_send_to_group"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Send to new group chat"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:background="@drawable/bg_btn_outline_pill"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

    <!--
        ★ UPGRADE: saare action buttons (Copy Link / Share via / Add to Story /
        Add to Status / Repost) ab ek hi HORIZONTAL row me icon-buttons ki tarah hain
        (IG/WhatsApp share-sheet jaisa), pehle vertical list tha.

        Ye row ReelShareSheetFragment#animateSheetContent() se smoothly grow/shrink
        hoti hai jab sheet expand/collapse hoti hai (state-change par animate,
        upar wale RecyclerView ki height ke saath sync me) — taaki freed-up space
        RecyclerView ko mil jaye aur zyada avatars dikh sakein. IDs same rakhe hain
        purane click listeners ke saath compatible rehne ke liye.
    -->
    <LinearLayout
        android:id="@+id/ll_share_button_row"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:orientation="horizontal"
        android:weightSum="6"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <!-- Copy Link -->
        <LinearLayout
            android:id="@+id/btn_copy_link"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
                <View android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@drawable/bg_share_icon_circle"/>
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_share_reel"
                    android:tint="#00F260"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Copy Link"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end"
                android:textColor="?attr/colorOnSurface"/>
        </LinearLayout>

        <!-- Share via -->
        <LinearLayout
            android:id="@+id/btn_share_external"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
                <View android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@drawable/bg_share_icon_circle"/>
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_send"
                    android:tint="#00C6FF"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Share via"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end"
                android:textColor="?attr/colorOnSurface"/>
        </LinearLayout>

        <!-- Direct WhatsApp share — the only external share counted by
             milestone earnings. Generic "Share via" remains unchanged. -->
        <LinearLayout
            android:id="@+id/btn_share_whatsapp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
                <View android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@drawable/bg_share_icon_circle"/>
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_whatsapp"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="WhatsApp"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end"
                android:textColor="?attr/colorOnSurface"/>
        </LinearLayout>

        <!-- Add to Story (Instagram-style gradient ring) -->
        <LinearLayout
            android:id="@+id/btn_add_to_story"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp"
                    android:src="@drawable/gradient_story_ring"/>
                <ImageView android:layout_width="26dp" android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_sparkle"
                    android:tint="#FFFFFF"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Story"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end"
                android:textColor="?attr/colorOnSurface"/>
        </LinearLayout>

        <!-- Add to Status (WhatsApp-style) -->
        <LinearLayout
            android:id="@+id/btn_share_to_status"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
                <View android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@drawable/bg_share_icon_circle"/>
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_status_notification"
                    android:tint="?attr/colorOnSurface"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Status"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end"
                android:textColor="?attr/colorOnSurface"/>
        </LinearLayout>

        <!-- Repost with Caption -->
        <LinearLayout
            android:id="@+id/btn_repost_with_caption"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
                <View android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@drawable/bg_share_icon_circle"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🔁" android:textSize="19sp"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Repost"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end"
                android:textColor="?attr/colorOnSurface"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
