<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_reel_share_sheet.xml
    BottomSheetDialogFragment ka layout — CoordinatorLayout aur backdrop hata diye.
    Material ka BottomSheetDialog apna backdrop/dim/animation khud handle karta hai.
-->
<!--
    ★ UPGRADE: root ab match_parent hai (pehle wrap_content tha).
    BottomSheetBehavior ko fitToContents(false) diya gaya hai (ReelShareSheetFragment#onStart),
    isliye ye view hamesha FULL available sheet height pe layout hoti hai — chahe sheet abhi
    peek (collapsed) state me ho ya fully expanded. Peek state me sirf upar ka hissa dikhta hai
    (system clip), aur jaise-jaise user upar khींchta hai, neeche ka avatar-grid hissa reveal
    hota hai — isi se "sheet upar kro to zyada avatar dikhe" wala effect milta hai bina kisi
    extra reload/relayout ke.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="@color/divider"/>

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Share Reel"
            android:textSize="17sp"
            android:fontFamily="sans-serif-bold"
            android:textColor="#FFE082"/>

        <ImageButton
            android:id="@+id/btn_share_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_close"
            android:tint="?attr/colorOnSurface"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"/>
    </LinearLayout>

    <!-- Send to contacts label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Send to"
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:paddingStart="16dp"
        android:layout_marginBottom="8dp"/>

    <ProgressBar
        android:id="@+id/progress_share"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        android:visibility="visible"/>

    <!--
        ★ UPGRADE: ab GRID hai (pehle single horizontal row tha).
        layout_height="0dp" + layout_weight="1" => baaki saari bachi hui vertical space
        ye RecyclerView le leta hai, jisse sheet jitni upar khinchi jaye utne hi zyada
        avatar-rows dikhte jaate hain (screenshot-2 wala effect).
        GridLayoutManager(spanCount=3) Java (onViewCreated) me set hota hai.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_share_contacts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

    <!--
        ★ UPGRADE: saare action buttons (Copy Link / Share via / Add to Story /
        Add to Status / Repost) ab ek hi HORIZONTAL row me icon-buttons ki tarah hain
        (IG/WhatsApp share-sheet jaisa), pehle vertical list tha.

        Ye poori row ReelShareSheetFragment#onSlide me PROGRAMMATICALLY animate hoti hai:
        jaise-jaise sheet upar (expand) hoti hai, iski height + alpha dono smoothly 0
        tak shrink ho jaate hain — taaki freed-up space upar wale RecyclerView (weight=1)
        ko mil jaye aur zyada avatars dikh sakein. Sheet wapas peek/collapsed hone par
        ye row phir se smoothly reveal ho jaati hai. IDs same rakhe hain purane click
        listeners ke saath compatible rehne ke liye.
    -->
    <LinearLayout
        android:id="@+id/ll_share_button_row"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:orientation="horizontal"
        android:weightSum="5"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <!-- Copy Link -->
        <LinearLayout
            android:id="@+id/btn_copy_link"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
                <View android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@drawable/bg_share_icon_circle"/>
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_share_reel"
                    android:tint="#00F260"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Copy Link"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end"
                android:textColor="?attr/colorOnSurface"/>
        </LinearLayout>

        <!-- Share via -->
        <LinearLayout
            android:id="@+id/btn_share_external"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
                <View android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@drawable/bg_share_icon_circle"/>
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_send"
                    android:tint="#00C6FF"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Share via"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end"
                android:textColor="?attr/colorOnSurface"/>
        </LinearLayout>

        <!-- Add to Story (Instagram-style gradient ring) -->
        <LinearLayout
            android:id="@+id/btn_add_to_story"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp"
                    android:src="@drawable/gradient_story_ring"/>
                <ImageView android:layout_width="26dp" android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_sparkle"
                    android:tint="#FFFFFF"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Story"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end"
                android:textColor="?attr/colorOnSurface"/>
        </LinearLayout>

        <!-- Add to Status (WhatsApp-style) -->
        <LinearLayout
            android:id="@+id/btn_share_to_status"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
                <View android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@drawable/bg_share_icon_circle"/>
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_status_notification"
                    android:tint="?attr/colorOnSurface"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Status"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end"
                android:textColor="?attr/colorOnSurface"/>
        </LinearLayout>

        <!-- Repost with Caption -->
        <LinearLayout
            android:id="@+id/btn_repost_with_caption"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
                <View android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@drawable/bg_share_icon_circle"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🔁" android:textSize="19sp"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Repost"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end"
                android:textColor="?attr/colorOnSurface"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
