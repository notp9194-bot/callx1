<?xml version="1.0" encoding="utf-8"?>
<!--
    Long-press "peek" popup for UserReelsActivity's grid.

    Root is a full-screen FrameLayout used as the PopupWindow's content view
    (so it can draw a dim scrim behind the small preview card, anchored near
    wherever the user's thumb is on the grid, without opening a new Activity).
    The card + action sheet scale/fade in from the pressed thumbnail's rect
    and are driven entirely from ReelPeekPreviewController.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_peek_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Instagram-style blurred backdrop — a blurred screenshot of whatever
         was on screen the instant before the peek opened (grid of reel
         thumbnails), captured + blurred in ReelPeekPreviewController and
         dropped in here. Starts empty/transparent; fades in once the
         background thread finishes blurring (~one frame later). -->
    <ImageView
        android:id="@+id/iv_peek_blur_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:contentDescription="@null"/>

    <!-- Dim scrim on TOP of the blurred backdrop — only partially opaque now
         (animates to SCRIM_MAX_ALPHA, not 1f) so the blur underneath still
         shows through, matching Instagram's long-press peek look instead of
         a flat black dim. -->
    <View
        android:id="@+id/view_peek_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:alpha="0"/>

    <LinearLayout
        android:id="@+id/layout_peek_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Mini video preview card — bumped another 20% per user request,
             on top of the previous 230x330dp -> 276x396dp pass. New size:
             276*1.2≈331dp, 396*1.2≈475dp. card_peek_actions/card_peek_options
             below stay the same width as this card so the stacked cards
             still line up. -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_peek"
            android:layout_width="331dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="16dp"
            app:cardBackgroundColor="#000000"
            app:cardPreventCornerOverlap="true">

            <FrameLayout
                android:id="@+id/frame_peek_video"
                android:layout_width="match_parent"
                android:layout_height="475dp">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/peek_player_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    app:use_controller="false"
                    app:resize_mode="zoom"
                    app:surface_type="texture_view"
                    app:keep_content_on_player_reset="true"
                    app:show_buffering="never"
                    android:background="#000000"/>
                <!--
                    surface_type="texture_view": card_peek's cardCornerRadius
                    clip ONLY affects normal View drawing. The default
                    surface_type (SurfaceView) punches its own hardware
                    compositor layer straight through the window, bypassing
                    the CardView's rounded-corner clip entirely — that's what
                    was showing as sharp/semi-transparent square corners
                    poking out on all four sides of this rounded card.
                    TextureView renders as a normal View (goes through the
                    same draw/clip pass as everything else), so it respects
                    the parent CardView's rounded clipping like any other
                    child. keep_content_on_player_reset avoids a black flash
                    on fast-switch player swaps; show_buffering="never" keeps
                    PlayerView's own spinner off since peek_loading below
                    already covers that. -->

                <ProgressBar
                    android:id="@+id/peek_loading"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="#FFFFFF"/>

                <!-- Mute/unmute badge (top-left) — tapping the player toggles
                     sound; icon + background flip between the muted (dim)
                     and unmuted (brand-tinted) look so the state is obvious
                     at a glance, mirroring the reel feed's mute affordance. -->
                <LinearLayout
                    android:id="@+id/layout_peek_mute_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_reel_count"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:id="@+id/iv_peek_mute_icon"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:src="@drawable/ic_volume_off"
                        android:tint="#FFFFFF"
                        android:contentDescription="Muted"/>
                </LinearLayout>

                <!-- Duration badge (top-right) -->
                <TextView
                    android:id="@+id/tv_peek_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:text="0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_reel_count"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"/>

                <!-- Caption + stats, bottom of card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_peek_caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:visibility="gone"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_eye"
                            android:tint="#FFFFFF"/>

                        <TextView
                            android:id="@+id/tv_peek_views"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="12dp"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"/>

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_heart_filled"
                            android:tint="#FFFFFF"/>

                        <TextView
                            android:id="@+id/tv_peek_likes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Quick-action sheet below the card, iOS-context-menu style -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_peek_actions"
            android:layout_width="331dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="#F5F5F5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btn_peek_play"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Watch Reel"
                    android:textColor="@color/brand_primary"
                    android:textSize="14.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:drawableStart="@drawable/ic_play"
                    android:drawableTint="@color/brand_primary"
                    android:drawablePadding="10dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.6dp"
                    android:background="#D9D9D9"/>

                <!-- Fixed "Options" toggle — tapping this no longer opens a
                     separate AlertDialog; it expands card_peek_options below
                     (same popup, mini player keeps playing underneath).
                     Hidden entirely when the caller passes no options (see
                     ReelPeekPreviewController#show). -->
                <TextView
                    android:id="@+id/btn_peek_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Options"
                    android:textColor="#1C1C1C"
                    android:textSize="14.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:drawableStart="@drawable/ic_more_vert"
                    android:drawableTint="#1C1C1C"
                    android:drawablePadding="10dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Compact options card — Instagram-style tight card, a SEPARATE
             area from the mini player above (own card, own space below the
             actions sheet), populated dynamically by
             ReelPeekPreviewController with whatever PeekOptions the caller
             passed (View Insights / Pin / Share / Delete for the owner's
             own reel). Starts GONE; toggled by tapping "Options" above. -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_peek_options"
            android:layout_width="331dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="#F5F5F5">

            <LinearLayout
                android:id="@+id/layout_peek_options_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</FrameLayout>
