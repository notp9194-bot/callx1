<?xml version="1.0" encoding="utf-8"?>
<!--
  ReelPhotoMusicTrimActivity ("Adjust Music") — Instagram-style music clip screen,
  shared by Reels (photo / video) and Status.
  Full-bleed dimmed media, Cancel / track art / Done on top, track label in the middle,
  style chips + clip-length circle + play/stop above a scrolling waveform with a fixed
  gradient window. All view ids are unchanged from the previous layout.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/iv_photo_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/adjust_music_cd_reel_preview"/>

    <VideoView
        android:id="@+id/video_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

    <!-- Dim layer so white UI stays readable over any photo -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:importantForAccessibility="no"/>

    <!-- Centre: track label (big, restyled by the style chips) -->
    <LinearLayout
        android:id="@+id/layout_trim_track_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="40dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="28dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tv_trim_title_track"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/adjust_music_original_audio"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"/>

        <TextView
            android:id="@+id/tv_trim_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/adjust_music_artist_placeholder"
            android:textColor="#CCFFFFFF"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_preview_play_hint"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:layout_marginTop="120dp"
        android:src="@drawable/ic_play"
        android:tint="#EEFFFFFF"
        android:background="@drawable/bg_circle_action"
        android:padding="14dp"
        android:contentDescription="@string/adjust_music_cd_play_preview"/>

    <ProgressBar
        android:id="@+id/progress_preview_buffer"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:layout_marginTop="120dp"
        android:indeterminateTint="#FFFFFFFF"
        android:visibility="gone"/>

    <ProgressBar
        android:id="@+id/progress_trim_load"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="#FFFFFFFF"
        android:visibility="gone"/>

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:fitsSystemWindows="true"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/btn_trim_back"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="@string/adjust_music_cancel"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/adjust_music_cd_back"/>

        <!-- Hidden title (kept so existing code can bind it) -->
        <TextView
            android:id="@+id/tv_trim_title"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

        <!-- Track art: tap = pick a different song -->
        <FrameLayout
            android:id="@+id/btn_trim_change"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_music_cover_thumb"
            android:padding="2dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/adjust_music_cd_change_audio">

            <ImageView
                android:id="@+id/iv_trim_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:contentDescription="@string/adjust_music_cd_track_cover"/>
        </FrameLayout>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

        <TextView
            android:id="@+id/btn_trim_use"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical|end"
            android:text="@string/adjust_music_done"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/adjust_music_cd_use_selection"/>
    </LinearLayout>

    <!-- Bottom controls -->
    <LinearLayout
        android:id="@+id/layout_trim_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <!-- Label style chips (they restyle the music sticker) -->
        <LinearLayout
            android:id="@+id/ll_style_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="14dp">

            <TextView android:id="@+id/chip_style_0" style="@style/AdjustMusicStyleChip"
                android:text="🚫" android:contentDescription="@string/adjust_music_cd_style_default"/>
            <TextView android:id="@+id/chip_style_1" style="@style/AdjustMusicStyleChip"
                android:text="AA" android:contentDescription="@string/adjust_music_cd_style_caps"/>
            <TextView android:id="@+id/chip_style_2" style="@style/AdjustMusicStyleChip"
                android:text="AI" android:contentDescription="@string/adjust_music_cd_style_glass"/>
            <TextView android:id="@+id/chip_style_3" style="@style/AdjustMusicStyleChip"
                android:text="Aa" android:contentDescription="@string/adjust_music_cd_style_plain"/>
            <TextView android:id="@+id/chip_style_4" style="@style/AdjustMusicStyleChip"
                android:text="A" android:contentDescription="@string/adjust_music_cd_style_light"/>
        </LinearLayout>

        <!-- Clip length circle + progress line + play/stop -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/btn_trim_duration"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="30"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:background="@drawable/bg_music_duration_circle"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/adjust_music_cd_clip_length"/>

            <ProgressBar
                android:id="@+id/progress_trim_line"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="14dp"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/progress_music_line"
                android:contentDescription="@string/adjust_music_cd_progress"/>

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_music_white_circle">

                <ImageButton
                    android:id="@+id/btn_trim_preview"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_play"
                    android:tint="#FF111111"
                    android:background="@android:color/transparent"
                    android:padding="12dp"
                    android:contentDescription="@string/adjust_music_cd_preview_selection"/>

                <ProgressBar
                    android:id="@+id/progress_trim_preview_btn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="#FF111111"
                    android:visibility="gone"/>
            </FrameLayout>
        </LinearLayout>

        <!-- Scrolling waveform under a fixed gradient window -->
        <com.callx.app.views.ClipWindowWaveformView
            android:id="@+id/waveform_trim_view"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="16dp"/>

        <!-- Hidden: preset radio group (logic still drives it) + total duration -->
        <RadioGroup
            android:id="@+id/rg_trim_presets"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">
            <RadioButton android:id="@+id/rb_preset_15" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <RadioButton android:id="@+id/rb_preset_30" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true"/>
            <RadioButton android:id="@+id/rb_preset_60" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </RadioGroup>
        <TextView
            android:id="@+id/tv_trim_total_duration"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>
    </LinearLayout>
</FrameLayout>
