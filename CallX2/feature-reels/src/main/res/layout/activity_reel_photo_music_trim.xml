<?xml version="1.0" encoding="utf-8"?>
<!--
  ReelPhotoMusicTrimActivity ("Adjust Music") — modern redesign.

  All colors reference @color/trim_* tokens defined in
  feature-reels/src/main/res/values/colors.xml (light) and
  values-night/colors.xml (dark) — the activity itself needs no extra code
  for theming since the resource system swaps the right variant based on
  the device's light/dark setting automatically.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/trim_screen_bg">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <ImageButton
            android:id="@+id/btn_trim_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/bg_trim_circle_btn"
            android:padding="9dp"
            android:tint="@color/trim_text_primary"
            android:contentDescription="Back"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="6dp">

            <TextView
                android:id="@+id/tv_trim_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adjust Music"
                android:textColor="@color/trim_text_primary"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preview and select the best part"
                android:textColor="@color/trim_text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- Spacer to keep the title visually centered against the back button
             now that Done has moved to the bottom action row. -->
        <View
            android:layout_width="40dp"
            android:layout_height="40dp"/>
    </LinearLayout>

    <!-- Photo reel preview -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_trim_photo_rounded"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/iv_photo_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Reel preview"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:text="PREVIEW"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_trim_preview_badge"/>

        <ImageView
            android:id="@+id/iv_preview_play_hint"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play"
            android:tint="#EEFFFFFF"
            android:background="@drawable/bg_circle_action"
            android:padding="14dp"
            android:contentDescription="Play preview"/>
    </FrameLayout>

    <!-- Loading indicator (shown while the track is being prepared) -->
    <ProgressBar
        android:id="@+id/progress_trim_load"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:visibility="gone"/>

    <!-- Bottom control panel (hidden until audio loads) -->
    <LinearLayout
        android:id="@+id/layout_trim_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_trim_card"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        android:visibility="visible">

        <!-- Track info row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_trim_subcard"
            android:padding="10dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/iv_trim_cover"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_trim_photo_rounded"
                android:clipToOutline="true"
                android:contentDescription="Track cover"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:id="@+id/tv_trim_title_track"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Original audio"
                    android:textColor="@color/trim_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tv_trim_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Artist"
                    android:textColor="@color/trim_text_secondary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_waveform_mini"
                android:contentDescription="Audio"/>
        </LinearLayout>

        <!-- Preset chips: 15s / 30s / 60s -->
        <RadioGroup
            android:id="@+id/rg_trim_presets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_preset_15"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="15s"
                android:gravity="center"
                android:textColor="@color/trim_text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/selector_trim_chip_bg"
                android:button="@drawable/selector_trim_chip_check"
                android:paddingStart="10dp"
                android:drawablePadding="6dp"/>

            <RadioButton
                android:id="@+id/rb_preset_30"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="30s"
                android:gravity="center"
                android:textColor="@color/trim_text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/selector_trim_chip_bg"
                android:button="@drawable/selector_trim_chip_check"
                android:paddingStart="10dp"
                android:drawablePadding="6dp"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rb_preset_60"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="60s"
                android:gravity="center"
                android:textColor="@color/trim_text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/selector_trim_chip_bg"
                android:button="@drawable/selector_trim_chip_check"
                android:paddingStart="10dp"
                android:drawablePadding="6dp"/>
        </RadioGroup>

        <!-- Draggable waveform + trim handles -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <com.callx.app.views.AudioTrimWaveformView
                android:id="@+id/waveform_trim_view"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_trim_subcard"
                android:paddingHorizontal="4dp"/>
        </FrameLayout>

        <!-- Bottom action row: Total duration (left) + Done (right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_trim_duration_chip"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="10dp">

                <ImageButton
                    android:id="@+id/btn_trim_preview"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_play"
                    android:tint="@color/trim_gradient_end"
                    android:background="@android:color/transparent"
                    android:padding="5dp"
                    android:contentDescription="Preview selection"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total duration"
                        android:textColor="@color/trim_text_muted"
                        android:textSize="10sp"/>

                    <TextView
                        android:id="@+id/tv_trim_total_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/trim_text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btn_trim_use"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:minWidth="100dp"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:text="Done"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_trim_gradient_button_ripple"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Use selection"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
