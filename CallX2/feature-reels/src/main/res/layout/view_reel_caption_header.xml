<?xml version="1.0" encoding="utf-8"?>
<!-- Content of the reel caption/owner header row, split out of
     activity_reel_comment.xml so it can be inflated lazily via a ViewStub
     (see layout_reel_caption_header_stub) only on the caption-tap entry
     point — the far more common comment-icon/count entry point then pays
     zero inflation cost for this block (no CircleImageView, no nested
     LinearLayout/TextViews created, no attrs resolved) instead of
     inflating-then-hiding it on every sheet open. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layout_reel_caption_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="?attr/colorSurface">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_caption_header_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_person"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_caption_header_owner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/tv_caption_header_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13.5sp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_primary"
                android:maxLines="3"
                android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/divider_caption_header"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>
</LinearLayout>
