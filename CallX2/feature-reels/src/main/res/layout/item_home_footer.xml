<?xml version="1.0" encoding="utf-8"?>
<!--
  item_home_footer.xml — HomeFragment feed RecyclerView, VT_FOOTER (always
  the very last position). This USED to hold the Trending/Suggested
  Creators/Friends Activity/Continue Watching blocks, statically pinned at
  the bottom of the feed — a position an infinite-scroll feed practically
  never reaches. Those 4 blocks are inline FeedRows now, drip-fed into the
  scroll a few posts at a time, Instagram-style (see HomeFragment's
  ROW_TRENDING_REELS class doc and ensureTrendingRowViewCreated() etc).

  All that's left here is the bottom-nav clearance spacer, so the very last
  post in the feed doesn't end up sitting flush behind the bottom nav bar.
-->
<View xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"/>
