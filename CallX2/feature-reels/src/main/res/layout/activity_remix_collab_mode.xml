<?xml version="1.0" encoding="utf-8"?>
<!-- v790 — Screen 2: Choose Mode (Remix / Collab) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rc_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|start"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/rc_text"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/rc_title"
            android:textColor="@color/rc_text"
            android:textSize="17sp"
            android:textStyle="bold"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/rc_choose_mode"
            android:textColor="@color/rc_text"
            android:textSize="26sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:text="@string/rc_choose_mode_sub"
            android:textColor="@color/rc_purple"
            android:textSize="15sp"/>

        <!-- Remix card -->
        <LinearLayout
            android:id="@+id/card_remix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rc_bg_card_selected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/rc_bg_tile">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/rc_ic_remix"/>
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rc_mode_remix"
                    android:textColor="@color/rc_text"
                    android:textSize="17sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/rc_mode_remix_desc"
                    android:textColor="@color/rc_text_sub"
                    android:textSize="13sp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/iv_check_remix"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/rc_bg_check_on"
                android:padding="5dp"
                android:src="@drawable/rc_ic_check"/>
        </LinearLayout>

        <!-- Collab card -->
        <LinearLayout
            android:id="@+id/card_collab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/rc_bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/rc_bg_tile">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_group"
                    android:tint="@color/rc_purple"/>
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rc_mode_collab"
                    android:textColor="@color/rc_text"
                    android:textSize="17sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/rc_mode_collab_desc"
                    android:textColor="@color/rc_text_sub"
                    android:textSize="13sp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/iv_check_collab"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/rc_bg_check_off"
                android:padding="5dp"
                android:src="@drawable/rc_ic_check"
                android:visibility="visible"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rc_bg_note"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/rc_ic_shield"/>
            <TextView
                android:id="@+id/tv_note"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/rc_note_notify"
                android:textColor="@color/rc_text_sub"
                android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btn_next"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="20dp"
        android:background="@drawable/rc_bg_btn_primary"
        android:stateListAnimator="@null"
        android:text="@string/rc_next"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"/>
</LinearLayout>
