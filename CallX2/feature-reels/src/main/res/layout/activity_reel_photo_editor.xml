<?xml version="1.0" encoding="utf-8"?>
<!-- ✅ INSTAGRAM-STYLE REDESIGN (Per-Photo Editor): matches the same
     redesign already applied to the Reel (video) editor screen
     (activity_reel_editor.xml) — the old version of this screen was a
     fixed-height photo box on top with a horizontal tab bar (Filter /
     Effect / Caption / Sticker / Adjust), a numbered dot-stepper, and its
     own Back/Next bar below, all stacked in a single vertical column. New
     testers found that confusing (feels like a form, hides most of the
     photo while editing). This screen now follows the same Instagram/
     Reels-style editor pattern:
       • the photo preview runs edge-to-edge, full screen, at all times —
         every tool's effect (filter, effect overlay, caption, stickers) is
         visible live, in place, immediately
       • the 5 tools (still the same underlying tools — Filter, Effect,
         Caption, Sticker, Adjust) are exposed as a single column of round
         icon buttons fixed to the right edge, instead of a horizontal tab
         bar + linear Back/Next wizard — tap any icon to jump straight to
         that tool
       • that tool's controls slide up as a compact panel anchored to the
         bottom edge, over the photo, instead of pushing the photo into a
         small box
     All of the underlying tool content (filter chips, effect chips,
     caption input + style row, sticker picker + emoji row, adjust sliders)
     is unchanged — same views, same ids — only the surrounding chrome
     (tab bar, step-indicator dots, fixed Back/Next bar, fixed-height photo
     box) is gone, since the rail on the right replaces it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/trim_screen_bg">

    <!-- ══════════════════ Full-screen live photo preview ══════════════════ -->
    <FrameLayout
        android:id="@+id/fl_editor_preview_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <!-- Blurred background — Instagram-style letterbox fill (same photo, blurred) -->
        <ImageView
            android:id="@+id/iv_photo_editor_bg_blur"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription=""/>

        <!-- Foreground photo: fitCenter — NEVER cropped regardless of aspect ratio -->
        <ImageView
            android:id="@+id/iv_photo_editor_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Photo preview"/>

        <!-- Effect overlay -->
        <View
            android:id="@+id/v_editor_effect_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:clickable="false"/>

        <!-- Colour filter tint -->
        <View
            android:id="@+id/v_editor_color_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:clickable="false"/>

        <!-- Sticker layer -->
        <FrameLayout
            android:id="@+id/fl_editor_sticker_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"/>

        <!-- Caption preview -->
        <TextView
            android:id="@+id/tv_photo_editor_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:padding="8dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:background="#BB000000"
            android:visibility="gone"
            android:clickable="false"/>
    </FrameLayout>

    <!-- ══════════════════ Top overlay bar (back / crop / rotate / Done) ══════════════════ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_editor_top_scrim"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/btn_editor_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="✕"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:id="@+id/tv_photo_editor_index"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Photo 1 of 1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#B0000000"
            android:shadowRadius="4"
            android:shadowDx="0"
            android:shadowDy="0"/>

        <TextView
            android:id="@+id/btn_editor_crop"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="⛶"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:id="@+id/btn_editor_rotate"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="⟳"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:id="@+id/btn_editor_done"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Done"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="@drawable/bg_trim_gradient_button_ripple"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- ══════════════════ Right-edge vertical tool rail ══════════════════
         Instagram-style: one column of round icon buttons, vertically
         centered on the right edge, floating directly over the live photo.
         Tapping an icon opens that tool's panel at the bottom (see
         goToPhotoEditorStep() / updatePhotoEditorRailUi() in
         ReelPhotoEditorActivity) — the currently-open tool's icon is filled
         with the brand gradient (bg_editor_rail_icon_active), every other
         icon stays a plain translucent disc (bg_editor_rail_icon). Same
         drawables/pattern as the Reel (video) editor's rail. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="22dp">
            <ImageButton
                android:id="@+id/rail_icon_filter"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_filter"
                android:scaleType="center"
                android:padding="12dp"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_editor_rail_icon"
                android:contentDescription="Filter"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Filter"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#B0000000"
                android:shadowRadius="4"
                android:shadowDx="0"
                android:shadowDy="0"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="22dp">
            <ImageButton
                android:id="@+id/rail_icon_effect"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_beauty"
                android:scaleType="center"
                android:padding="12dp"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_editor_rail_icon"
                android:contentDescription="Effect"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Effect"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#B0000000"
                android:shadowRadius="4"
                android:shadowDx="0"
                android:shadowDy="0"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="22dp">
            <ImageButton
                android:id="@+id/rail_icon_caption"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_caption"
                android:scaleType="center"
                android:padding="12dp"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_editor_rail_icon"
                android:contentDescription="Caption"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Caption"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#B0000000"
                android:shadowRadius="4"
                android:shadowDx="0"
                android:shadowDy="0"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="22dp">
            <ImageButton
                android:id="@+id/rail_icon_sticker"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_sparkle"
                android:scaleType="center"
                android:padding="12dp"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_editor_rail_icon"
                android:contentDescription="Stickers"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sticker"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#B0000000"
                android:shadowRadius="4"
                android:shadowDx="0"
                android:shadowDy="0"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <ImageButton
                android:id="@+id/rail_icon_adjust"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_settings"
                android:scaleType="center"
                android:padding="12dp"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_editor_rail_icon"
                android:contentDescription="Adjust"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Adjust"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#B0000000"
                android:shadowRadius="4"
                android:shadowDx="0"
                android:shadowDy="0"/>
        </LinearLayout>

    </LinearLayout>

    <!-- ══════════════════ Bottom tool panel (floats over the photo) ══════════════════
         Compact card anchored to the bottom edge instead of a fixed-height
         section that pushes the photo preview up — the photo stays visible
         and live everywhere above/around this panel while a tool is open.
         Same bg_trim_card visual language as the Reel (video) editor's
         bottom panel / Audio Mixer. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_trim_card">

        <!-- Drag-handle affordance (decorative) -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@color/trim_divider"/>

        <!-- ✅ Kept as hidden 0dp views purely so their R.id constants still
             exist: step_dot_5 / step_line_4 / step_ring_5 are shared ids in
             this module's dot-stepper pattern (reel_editor / reel_upload /
             this screen), reel_upload's own layout only defines steps 1-4,
             and ReelEditorActivity#setupEditorStepWizard() still looks up
             all 5. Always null-checked before use, so these are harmless
             no-ops here — the rail + tv_photo_editor_step_name below
             replace what the old dot-stepper used to show on this screen. -->
        <TextView android:id="@+id/step_dot_5" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <View android:id="@+id/step_line_4" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <ImageView android:id="@+id/step_ring_5" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

        <!-- Apply to all checkbox -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp">

            <CheckBox
                android:id="@+id/cb_apply_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apply filter &amp; effect to all photos"
                android:textColor="@color/trim_text_secondary"
                android:textSize="12sp"
                android:buttonTint="#A855F7"/>
        </LinearLayout>

        <!-- Current tool name — same tv_photo_editor_step_name Java already
             updates on every goToPhotoEditorStep() call (see
             updatePhotoEditorStepUi()); the numbered "Step X of 5" pill and
             tab bar are gone since the rail on the right is now the primary
             navigation, not a linear sequence. -->
        <TextView
            android:id="@+id/tv_photo_editor_step_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="Filter"
            android:textAllCaps="true"
            android:textColor="@color/trim_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:fontFamily="sans-serif-medium"/>

        <!-- ── Tool panels (only one visible at a time, toggled by
             goToPhotoEditorStep()) — content unchanged from before. ── -->

    <!-- FILTERS panel -->
    <HorizontalScrollView
        android:id="@+id/panel_filters"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:scrollbars="none"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/ll_filter_chips"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"/>
    </HorizontalScrollView>

    <!-- EFFECTS panel -->
    <HorizontalScrollView
        android:id="@+id/panel_effects"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:scrollbars="none"
        android:visibility="gone"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/ll_effect_chips"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"/>
    </HorizontalScrollView>

    <!-- CAPTION panel -->
    <LinearLayout
        android:id="@+id/panel_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/et_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Caption for this photo…"
            android:textColorHint="@color/trim_text_muted"
            android:textColor="@color/trim_text_primary"
            android:textSize="13sp"
            android:background="@drawable/bg_comment_input"
            android:padding="10dp"
            android:maxLines="3"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <ToggleButton android:id="@+id/toggle_bold"
                android:layout_width="40dp" android:layout_height="36dp"
                android:textOn="B" android:textOff="B"
                android:textStyle="bold" android:textSize="14sp"
                android:textColor="@color/trim_text_primary" android:background="@drawable/bg_reel_editor_tool_chip"/>

            <ToggleButton android:id="@+id/toggle_italic"
                android:layout_width="40dp" android:layout_height="36dp"
                android:textOn="I" android:textOff="I"
                android:textStyle="italic" android:textSize="14sp"
                android:textColor="@color/trim_text_primary" android:background="@drawable/bg_reel_editor_tool_chip"
                android:layout_marginStart="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Size"
                android:textColor="@color/trim_text_secondary"
                android:textSize="11sp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"/>

            <SeekBar
                android:id="@+id/sb_caption_size"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="40"
                android:progress="10"
                android:progressTint="#A855F7"
                android:thumbTint="#A855F7"/>
        </LinearLayout>

        <!-- Caption colour picker -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/ll_caption_color_picker"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"/>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- STICKERS panel v2: full sticker sheet button + quick emoji row -->
    <LinearLayout
        android:id="@+id/panel_stickers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Opens StatusStickerPickerSheet (Music · Poll · Quiz · Countdown · Mention · Hashtag · Link) -->
        <TextView
            android:id="@+id/btn_add_full_sticker"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="✨  Add Sticker  (Music · Poll · Quiz · Countdown · more)"
            android:textColor="@color/trim_text_primary"
            android:textSize="13sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@color/trim_chip_bg"/>

        <!-- Quick emoji overlays -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:scrollbars="none"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:id="@+id/ll_emoji_row"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"/>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- ADJUST panel -->
    <LinearLayout
        android:id="@+id/panel_adjust"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Brightness -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="32dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                android:text="Brightness" android:textColor="@color/trim_text_secondary" android:textSize="11sp"/>
            <SeekBar android:id="@+id/sb_brightness"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:progressTint="#FFD700" android:thumbTint="#FFD700"/>
            <TextView android:id="@+id/tv_brightness_val"
                android:layout_width="36dp" android:layout_height="wrap_content"
                android:text="+0.0" android:textColor="@color/trim_text_secondary" android:textSize="11sp"
                android:gravity="end"/>
        </LinearLayout>

        <!-- Contrast -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="32dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                android:text="Contrast" android:textColor="@color/trim_text_secondary" android:textSize="11sp"/>
            <SeekBar android:id="@+id/sb_contrast"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:progressTint="#00E5FF" android:thumbTint="#00E5FF"/>
            <TextView android:id="@+id/tv_contrast_val"
                android:layout_width="36dp" android:layout_height="wrap_content"
                android:text="1.0x" android:textColor="@color/trim_text_secondary" android:textSize="11sp"
                android:gravity="end"/>
        </LinearLayout>

        <!-- Saturation -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="32dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                android:text="Saturation" android:textColor="@color/trim_text_secondary" android:textSize="11sp"/>
            <SeekBar android:id="@+id/sb_saturation"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:progressTint="#FF416C" android:thumbTint="#FF416C"/>
            <TextView android:id="@+id/tv_saturation_val"
                android:layout_width="36dp" android:layout_height="wrap_content"
                android:text="1.0x" android:textColor="@color/trim_text_secondary" android:textSize="11sp"
                android:gravity="end"/>
        </LinearLayout>

        <!-- Ken Burns direction -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ken Burns Direction" android:textColor="@color/trim_text_secondary"
            android:textSize="11sp" android:layout_marginTop="10dp"/>
        <LinearLayout
            android:id="@+id/ll_kb_direction"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"/>

        <!-- Duration -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="32dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="10dp">
            <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                android:text="Duration" android:textColor="@color/trim_text_secondary" android:textSize="11sp"/>
            <SeekBar android:id="@+id/sb_duration"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:progressTint="#00FF88" android:thumbTint="#00FF88"/>
            <TextView android:id="@+id/tv_duration_label"
                android:layout_width="52dp" android:layout_height="wrap_content"
                android:text="3.0s" android:textColor="@color/trim_text_secondary" android:textSize="11sp"
                android:gravity="end"/>
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>

</FrameLayout>
