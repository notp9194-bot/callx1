<?xml version="1.0" encoding="utf-8"?>
<!--
    Thin-outline pill — transparent fill, 1dp border — used for the
    "Camera" / "Video" use-sound buttons so they read as outlined pills
    (screenshot style) instead of solid gray boxes. Corner radius is half
    of the 30dp button height for a true pill shape.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent"/>
    <stroke android:width="1dp" android:color="@color/sound_detail_button_light"/>
    <corners android:radius="15dp"/>
</shape>
