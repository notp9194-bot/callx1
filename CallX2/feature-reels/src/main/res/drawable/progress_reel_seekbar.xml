<?xml version="1.0" encoding="utf-8"?>
<!--
  Centered bottom "pill" seek track for Reels (see fragment_reel_player.xml
  for the weighted 50%-width container this sits inside).

  The SeekBar view itself is 28dp tall purely to give the thumb a generous
  touch/drag target — this drawable insets top/bottom so only a slim ~5dp
  capsule is actually painted, flush with the bottom of that touch target.
  Corner radius is set to half the painted thickness (2.5dp for a 5dp bar)
  so both ends are fully rounded — a true pill/capsule shape, not just
  slightly-rounded rectangle corners.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@android:id/background"
        android:top="23dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#66FFFFFF" />
            <corners android:radius="2.5dp" />
        </shape>
    </item>

    <item
        android:id="@android:id/progress"
        android:top="23dp"
        android:bottom="0dp">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#FF416C" />
                <corners android:radius="2.5dp" />
            </shape>
        </clip>
    </item>

</layer-list>
