<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_profile_song_badge.xml — LIGHT MODE
    Instagram-style "audio badge" that overlaps the top-left of the avatar
    (Screenshot 3 reference). Opaque pill + soft border so it reads clearly
    on top of any avatar photo, with a drop shadow via view elevation.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFFFF"/>
    <stroke android:width="0.75dp" android:color="#14000000"/>
    <corners android:radius="20dp"/>
</shape>
