<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_song_pill.xml — LIGHT MODE
    "Username ke niche" strip (profile-song pill / "Add a song" stub).
    Premium look: thin hairline border + a faint fill so the pill reads as a
    subtle card rather than a plain outline. Kept low-contrast on purpose —
    "thodi visible" — so it doesn't compete with the avatar/stats above it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0A000000"/>
    <stroke android:width="0.75dp" android:color="#1F000000"/>
    <corners android:radius="20dp"/>
</shape>
