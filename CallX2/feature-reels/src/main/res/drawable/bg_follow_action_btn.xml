<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback background for item_follow_user.xml's btn_follow_action —
     the real per-state (Follow/Following/Follow Back) color is applied at
     bind time in FollowConnectionsActivity$UserListAdapter#styleBtn(), this
     is just what's visible before the first bind / while GONE. Corner
     radius (8dp) matches styleBtn() — rounded-rect, not a full pill. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/follow_button_pressed"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/follow_button_primary"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</selector>
