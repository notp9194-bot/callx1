<?xml version="1.0" encoding="utf-8"?>
<!-- Same border color/width as bg_btn_outline_pill (Message pill, Following
     pill) — just a true circle (oval, equal width/height) instead of a
     rounded-rectangle, so the add-person icon button matches Instagram's
     circular action button instead of rendering as a rounded square. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent"/>
    <stroke android:width="1dp" android:color="#CCCCCC"/>
    <corners android:radius="14dp"/>
</shape>
