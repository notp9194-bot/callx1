<?xml version="1.0" encoding="utf-8"?>
<!--
    Same fill as bg_sound_detail_box (sound_detail_button_light — E8E8E8
    light / 2A2A2A dark) but with an 8dp corner radius to match
    bg_btn_follow_pill's corner exactly, so "Use in Camera" / "Use with
    Video" sit visually consistent with "Add to profile" in the same row.
    Kept as its own drawable (not a radius edit on bg_sound_detail_box)
    since that one is still shared by the waveform card and the boxed
    creator row, which should keep their own 12dp radius.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/sound_detail_button_light"/>
    <corners android:radius="8dp"/>
</shape>
