<?xml version="1.0" encoding="utf-8"?>
<!-- Comment bar input pill only (bg_comment_input is shared by search boxes etc.).
     Same fill; a 1dp stroke that is transparent at rest (so the pill never
     changes size) and brand-coloured while the field has focus.
     20dp radius = a perfect pill at the 40dp single-line height, and a softly
     rounded rectangle once it grows to 2-3 lines. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceVariant"/>
            <stroke android:width="1dp" android:color="@color/brand_primary"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceVariant"/>
            <stroke android:width="1dp" android:color="@android:color/transparent"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</selector>
