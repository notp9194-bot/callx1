<?xml version="1.0" encoding="utf-8"?>
<!-- ✅ NEW: base fill for every step-icon box in the icon-box stepper —
     same dark rounded square for all 5 steps; progress is communicated by
     bg_step_icon_box_active (border overlay) and the label color, not by
     changing this fill. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/step_icon_box_bg"/>
    <corners android:radius="14dp"/>
</shape>
