<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_story_ring.xml — brand story ring gradient, DARK palette
    Colour flow (from top, clockwise): Dark Magenta 0-15% (#99004D)
    -> Dark Red 15-50% (#8B0000) -> Dark Yellow 50-100% (#B8860B).
    Used in activity_user_reels.xml for view_story_ring (90dp avatar ring).
    A plain XML sweep gradient natively supports exactly 3 stops
    (start/center/end at 0%/50%/100%), which lines up perfectly with these
    3 bands, so this IS the exact spec — no approximation needed. For the
    seamless-closing version (100% blends back into 0% with zero seam), see
    StoryRingShaderCache (used by StoryRingGradientDrawable), which is what
    actually renders wherever the code overrides this XML.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer gradient oval — brand sweep gradient -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="sweep"
                android:startColor="#99004D"
                android:centerColor="#8B0000"
                android:endColor="#B8860B"/>
        </shape>
    </item>
    <!-- Inner white spacer (3dp) — creates visible gap between gradient and avatar -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF"/>
        </shape>
    </item>
</layer-list>
