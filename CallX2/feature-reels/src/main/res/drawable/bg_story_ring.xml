<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_story_ring.xml — brand story ring gradient
    Smooth colour flow (from top, clockwise): Purple #8A2BE2 (0%) -> Pink
    #FF1493 (15%) -> Red-Orange #FF5318 (55%) -> Orange-Yellow #FFBE00 (75%)
    -> Yellow #FFF200 (100%). No hard edges.
    Used in activity_user_reels.xml for view_story_ring (90dp avatar ring).
    Plain XML sweep gradients only support 3 stops (start/center/end fixed
    at 0%/50%/100%), so this is the closest 3-stop approximation: startColor
    is Purple, centerColor is the Red-Orange blend since the 50% midpoint
    falls near it, endColor is Yellow. For the pixel-exact 5-stop smooth
    gradient, see StoryRingShaderCache (used by StoryRingGradientDrawable),
    which is what actually renders wherever the code overrides this XML.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer gradient oval — brand sweep gradient -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="sweep"
                android:startColor="#8A2BE2"
                android:centerColor="#FF5318"
                android:endColor="#FFF200"/>
        </shape>
    </item>
    <!-- Inner white spacer (3dp) — creates visible gap between gradient and avatar -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF"/>
        </shape>
    </item>
</layer-list>
