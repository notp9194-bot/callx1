<?xml version="1.0" encoding="utf-8"?>
<!--
  Theme-aware X (Twitter) badge background, scoped to UserReelsActivity's
  action row (activity_user_reels.xml). The shared bg_social_x_btn is
  hardcoded solid black in every theme, which read fine in dark mode but
  looked out of place next to this row's new light-mode-aware Call/Video/
  YouTube circles. Day variant: light surface fill (matches the other three
  pills) with the X glyph tinted dark via @color/x_logo_tint. Night variant
  (drawable-night) restores the original solid-black badge with a white glyph.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/surface_bg"/>
    <stroke
        android:width="1dp"
        android:color="#E3E5EA"/>
</shape>
