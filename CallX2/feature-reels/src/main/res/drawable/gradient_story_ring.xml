<?xml version="1.0" encoding="utf-8"?>
<!--
    Brand gradient story ring — shown when a contact has a reel_story type status.
    Colour flow (from top, clockwise): Pink/Magenta 0-10% (#FF1493)
    -> Pink-Red 10-38% (#FF3B5C) -> Orange 38-50% (#FF8A00) ->
    Yellow 50-100% (#FFD600, widened band). Plain XML sweep gradients only
    support 3 stops (start/center/end fixed at 0%/50%/100%), so centerColor
    is Orange since the 50% mark sits right at the Orange/Yellow boundary —
    this is the closest 3-stop approximation. For the pixel-exact,
    seamless-closing 4-band gradient with these exact percentages, see
    StoryRingShaderCache (used by StoryRingGradientDrawable / the chat-list
    ring) which supports arbitrary colour stops.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="sweep"
        android:startColor="#FF1493"
        android:centerColor="#FF8A00"
        android:endColor="#FFD600"
        android:centerX="0.5"
        android:centerY="0.5"/>
</shape>
