<?xml version="1.0" encoding="utf-8"?>
<!--
    Brand gradient story ring — shown when a contact has a reel_story type status.
    Smooth colour flow (from top, clockwise): Purple #8A2BE2 (0%) -> Pink
    #FF1493 (15%) -> Red-Orange #FF5318 (55%) -> Orange-Yellow #FFBE00 (75%)
    -> Yellow #FFF200 (100%). No hard edges. Plain XML sweep gradients only
    support 3 stops (start/center/end fixed at 0%/50%/100%), so centerColor
    is Red-Orange (the colour that sits at the 50% mark) — this is the
    closest 3-stop approximation. For the pixel-exact 5-stop smooth version,
    see StoryRingShaderCache (used by StoryRingGradientDrawable / the
    chat-list ring).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="sweep"
        android:startColor="#8A2BE2"
        android:centerColor="#FF5318"
        android:endColor="#FFF200"
        android:centerX="0.5"
        android:centerY="0.5"/>
</shape>
