<?xml version="1.0" encoding="utf-8"?>
<!--
    Brand gradient story ring — shown when a contact has a reel_story type status.
    DARK palette, colour flow (from top, clockwise): Dark Magenta 0-15%
    (#99004D) -> Dark Red 15-50% (#8B0000) -> Dark Yellow 50-100%
    (#B8860B). A plain XML sweep gradient natively supports exactly 3 stops
    (start/center/end at 0%/50%/100%), which lines up perfectly with these
    3 bands, so this IS the exact spec — no approximation needed. For the
    seamless-closing version (100% blends back into 0% with zero seam), see
    StoryRingShaderCache (used by StoryRingGradientDrawable / the chat-list
    ring) which supports arbitrary colour stops.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="sweep"
        android:startColor="#99004D"
        android:centerColor="#8B0000"
        android:endColor="#B8860B"
        android:centerX="0.5"
        android:centerY="0.5"/>
</shape>
