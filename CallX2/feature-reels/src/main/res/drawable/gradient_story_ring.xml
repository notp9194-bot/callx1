<?xml version="1.0" encoding="utf-8"?>
<!--
    Brand gradient story ring — shown when a contact has a reel_story type status.
    Colour flow (from top, clockwise): Purple 25% -> Pink/Magenta 20% ->
    Orange 20% -> Yellow 35%. Plain XML sweep gradients only support 3 stops
    (start/center/end fixed at 0%/50%/100%), so centerColor is Orange (the
    colour that actually sits at the 45-65% band, covering the 50% mark) —
    Pink/Magenta appears naturally in the purple->orange blend around the
    25-45% region. For pixel-exact 4-stop percentages, see
    StoryRingShaderCache (used by StoryRingGradientDrawable / the chat-list
    ring) which supports arbitrary colour stops.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="sweep"
        android:startColor="#7D00FF"
        android:centerColor="#FF8A00"
        android:endColor="#FFD600"
        android:centerX="0.5"
        android:centerY="0.5"/>
</shape>
