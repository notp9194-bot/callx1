<?xml version="1.0" encoding="utf-8"?>
<!--
    Brand gradient story ring — shown when a contact has a reel_story type status.
    Colour flow (from top, clockwise): Pink/Magenta 0-15% (#FF1493)
    -> Pink-Red 15-55% (#FF3B5C) -> Orange 55-75%
    (#FF8A00) -> Yellow 75-100% (#FFD600). Plain XML
    sweep gradients only support 3 stops (start/center/end fixed at
    0%/50%/100%), so centerColor is Pink-Red (the colour that actually sits
    at the 50% mark, inside the dominant 15-55% band) — this is the closest
    3-stop approximation. For pixel-exact 4-band percentages with hard edges
    at 15%/55%/75%, see StoryRingShaderCache (used by StoryRingGradientDrawable /
    the chat-list ring) which supports arbitrary colour stops.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="sweep"
        android:startColor="#FF1493"
        android:centerColor="#FF3B5C"
        android:endColor="#FFD600"
        android:centerX="0.5"
        android:centerY="0.5"/>
</shape>
