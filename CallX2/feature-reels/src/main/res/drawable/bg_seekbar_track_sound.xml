<?xml version="1.0" encoding="utf-8"?>
<!--
    Thin, minimal seekbar track. IMPORTANT: a bare <shape> inside a
    progressDrawable layer-list gets STRETCHED to fill the SeekBar's full
    assigned height — the <size> tag only affects intrinsic/measure size,
    not what's actually drawn once bounds are set. That's why the first
    version of this drawable rendered as a thick chunky pill instead of a
    thin 3dp line. Fixed by wrapping each shape in an <inset> with generous
    top/bottom insets, which DOES constrain the drawn height regardless of
    the SeekBar's own height.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <inset android:insetTop="7dp" android:insetBottom="7dp">
            <shape android:shape="rectangle">
                <corners android:radius="1.5dp"/>
                <solid android:color="@color/sound_detail_box_tint"/>
            </shape>
        </inset>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <inset android:insetTop="7dp" android:insetBottom="7dp">
                <shape android:shape="rectangle">
                    <corners android:radius="1.5dp"/>
                    <solid android:color="@color/brand_primary"/>
                </shape>
            </inset>
        </clip>
    </item>
</layer-list>
