<?xml version="1.0" encoding="utf-8"?>
<!--
  Pure spacing divider for layout_duet_video_container (showDividers="middle").
  No color/line drawn — just an 10dp transparent gap between the Original
  and Camera panels, so their rounded corners show cleanly on both sides
  instead of the old solid divider bar touching edge-to-edge.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size
        android:width="10dp"
        android:height="10dp" />
</shape>
