<?xml version="1.0" encoding="utf-8"?>
<!--
    Rounded fill box for the Sound Detail screen only.

    Fill now matches the panel background exactly (?attr/colorSurface —
    same token layout_sound_info/the top bar/the reels grid all use) so the
    waveform card and creator row blend into the panel instead of reading
    as a flat gray block. A faint stroke (sound_detail_box_border) is what
    keeps the box shape visible — it reads as a soft shadow edge rather
    than a hard outline. Shared by the waveform/seekbar card and the
    boxed creator row — one drawable, not two.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurface"/>
    <stroke android:width="1dp" android:color="@color/sound_detail_box_border"/>
    <corners android:radius="12dp"/>
</shape>
