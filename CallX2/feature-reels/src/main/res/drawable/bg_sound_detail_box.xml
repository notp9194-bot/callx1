<?xml version="1.0" encoding="utf-8"?>
<!--
    Premium flat redesign: no stroke, no elevation. Fill is a subtle
    brand-tinted background (sound_detail_box_tint) instead of matching the
    panel + a border — the box reads as its own soft surface purely through
    color, flat design instead of a bordered/shadowed card.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/sound_detail_box_tint"/>
    <corners android:radius="14dp"/>
</shape>
