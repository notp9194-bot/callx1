<?xml version="1.0" encoding="utf-8"?>
<!--
    story_ring_insta_gradient.xml
    Brand story ring gradient — colour flow (from top, clockwise):
    Pink/Magenta 0-10% (#FF1493) -> Pink-Red 10-38% (#FF3B5C) ->
    Orange 38-50% (#FF8A00) -> Yellow 50-100% (#FFD600, widened band).
    Used as background/src for story rings across Reels (home stories, reel
    comments, reel player owner ring, feed post ring, share sheet).
    The avatar (slightly smaller) sits on top, visually creating a ring effect.
    Note: plain XML sweep gradients only support 3 stops (start/center/end
    fixed at 0/50/100%) — centerColor is Orange since the 50% mark sits
    right at the Orange/Yellow boundary; this is the closest 3-stop
    approximation of the spec. For the pixel-exact, seamless-closing 4-band
    gradient with these exact percentages, see StoryRingShaderCache.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer gradient oval — full gradient circle -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="sweep"
                android:startColor="#FF1493"
                android:centerColor="#FF8A00"
                android:endColor="#FFD600"/>
        </shape>
    </item>
    <!-- Inner white ring (2.5dp all sides) — creates visible gap between gradient and avatar -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF"/>
        </shape>
    </item>
</layer-list>
