<?xml version="1.0" encoding="utf-8"?>
<!--
    story_ring_insta_gradient.xml
    Brand story ring gradient — DARK palette, colour flow (from top,
    clockwise): Dark Magenta 0-15% (#99004D) -> Dark Red 15-50% (#8B0000)
    -> Dark Yellow 50-100% (#B8860B).
    Used as background/src for story rings across Reels (home stories, reel
    comments, reel player owner ring, feed post ring, share sheet).
    The avatar (slightly smaller) sits on top, visually creating a ring effect.
    A plain XML sweep gradient natively supports exactly 3 stops
    (start/center/end at 0/50/100%), which lines up perfectly with these 3
    bands, so this IS the exact spec — no approximation needed. For the
    seamless-closing version (100% blends back into 0% with zero seam), see
    StoryRingShaderCache, which is what actually renders wherever the code
    overrides this XML.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer gradient oval — full gradient circle -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="sweep"
                android:startColor="#99004D"
                android:centerColor="#8B0000"
                android:endColor="#B8860B"/>
        </shape>
    </item>
    <!-- Inner white ring (2.5dp all sides) — creates visible gap between gradient and avatar -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF"/>
        </shape>
    </item>
</layer-list>
