<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_share_selected_check.xml
    ★ NEW — blue filled circle + white ring + white checkmark, used as the
    multi-select "this contact is selected" badge in the reel share sheet
    grid (Instagram/WhatsApp share-sheet style). Deliberately has NO
    android:tint so it always renders in these fixed colors regardless of
    theme/day-night, matching a fixed brand-blue selection indicator.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- white ring for contrast against any avatar color -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,1a11,11 0,1 0,0.01,0z"/>

    <!-- blue fill -->
    <path
        android:fillColor="#5B6EF5"
        android:pathData="M12,3a9,9 0,1 0,0.01,0z"/>

    <!-- checkmark -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M7.3,12.4l3.1,3.1l6.3,-6.8"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

</vector>
