<?xml version="1.0" encoding="utf-8"?>
<!--
    Gray ring for highlights the current viewer has already opened —
    Instagram-style seen state (see StatusHighlightManager.markHighlightSeen /
    HighlightsRowAdapter.bindAlbum). Stroke width matches the 4dp used by
    StoryRingGradientDrawable / HighlightRingDrawable so the ring doesn't
    visibly change thickness when it flips from gradient to gray.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <stroke android:width="4dp" android:color="#CCCCCC"/>
    <solid android:color="@android:color/transparent"/>
</shape>
