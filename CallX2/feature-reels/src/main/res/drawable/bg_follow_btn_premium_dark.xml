<?xml version="1.0" encoding="utf-8"?>
<!-- Premium outline Follow button — reused as-is across Reels tab
     (tv_follow_btn), Home feed + Post feed video overlay headers
     (btn_post_follow), and their collab-row twins (tv_collab_follow_btn
     in stub_reel_collab_row.xml). No solid fill (transparent box only),
     8dp rounded corners, soft translucent-white border for a light
     "premium" outline look on dark/video backgrounds. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="1.2dp" android:color="#B3FFFFFF"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="1.2dp" android:color="#80FFFFFF"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</selector>
