<?xml version="1.0" encoding="utf-8"?>
<!-- Same brand gradient in both light and dark mode by design — it's the
     primary CTA and should stay high-contrast/eye-catching either way. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@color/trim_gradient_start"
        android:endColor="@color/trim_gradient_end"/>
    <corners android:radius="28dp"/>
</shape>
