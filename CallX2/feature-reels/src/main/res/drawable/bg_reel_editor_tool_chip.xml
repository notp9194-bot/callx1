<?xml version="1.0" encoding="utf-8"?>
<!-- ✅ FIX (light/dark mode support): chip background for the Reel Editor's
     tool icon buttons (Filters/Stickers/Subtitles/Transitions/Voice FX/
     Audio Mixer/Thumbnail/Music). Replaces the old @drawable/bg_speed_chip,
     which was hardcoded #44000000 fill + #66FFFFFF stroke — only readable
     when this screen was forced pure black. Uses the existing
     trim_chip_bg / trim_chip_stroke tokens (already defined per-theme in
     colors.xml / values-night/colors.xml) so the chip reads correctly on
     both the light and dark card panel. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/trim_chip_bg"/>
    <stroke android:color="@color/trim_chip_stroke" android:width="1dp"/>
    <corners android:radius="6dp"/>
</shape>
