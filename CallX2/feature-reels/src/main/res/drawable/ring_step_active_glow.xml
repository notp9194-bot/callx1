<?xml version="1.0" encoding="utf-8"?>
<!-- Vibrant-green glow ring drawn around whichever step dot is currently active.
     Sized slightly bigger than the 28dp step dot (see step_ring_N in
     activity_reel_upload.xml) and continuously rotated in code
     (ReelUploadActivity#startActiveStepRingSpin) — the sweep gradient fades from
     transparent to solid green around the ring instead of being a flat stroke, so
     the rotation actually reads as a spinning glow instead of a static circle. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="ring"
    android:innerRadiusRatio="3.6"
    android:thicknessRatio="9"
    android:useLevel="false">
    <gradient
        android:type="sweep"
        android:startColor="#0000F260"
        android:centerColor="#8000F260"
        android:endColor="#FF00F260"/>
</shape>
