<?xml version="1.0" encoding="utf-8"?>
<!-- Flat 5% black scrim (top 40dp), then a gradual 20dp fade (40dp→60dp)
     down to fully transparent — long fade so the cutoff is unnoticeable. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Flat 5% black — top 40dp -->
    <item android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#0D000000"/>
        </shape>
    </item>

    <!-- 40dp to 60dp — fades 5% black to fully transparent -->
    <item android:top="40dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#0D000000"
                android:endColor="#00000000"/>
        </shape>
    </item>

</layer-list>
