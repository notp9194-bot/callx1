<?xml version="1.0" encoding="utf-8"?>
<!-- Single continuous gradient (not a layer-list of separate flat+gradient
     shapes) — avoids the visible seam/line at the flat→fade boundary.
     Flat 5% black till center (~30dp), then one smooth linear fade to
     fully transparent by the bottom (60dp). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#0D000000"
        android:centerColor="#0D000000"
        android:endColor="#00000000"/>
</shape>
