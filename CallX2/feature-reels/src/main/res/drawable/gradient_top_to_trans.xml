<?xml version="1.0" encoding="utf-8"?>
<!-- Flat 5% black scrim behind the home-feed reel header, ending exactly at
     the avatar's bottom edge (60dp) — fades smoothly to transparent in the
     last 5dp so the cutoff isn't visible, no overhang past the avatar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Flat 5% black — top 55dp -->
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#0D000000"/>
        </shape>
    </item>

    <!-- Last 5dp only — fades 5% black to fully transparent, ends at 60dp -->
    <item android:top="55dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#0D000000"
                android:endColor="#00000000"/>
        </shape>
    </item>

</layer-list>
