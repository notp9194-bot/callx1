<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="#B9ACF8"/><corners android:radius="26dp"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/rc_purple_dark"/><corners android:radius="26dp"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/rc_purple"/><corners android:radius="26dp"/></shape>
    </item>
</selector>
