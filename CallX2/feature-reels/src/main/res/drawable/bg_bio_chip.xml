<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_bio_chip.xml — LIGHT MODE
    Bio-links chip row (hsv_bio_links / ll_bio_chips), under the username.
    Same premium thin-pill treatment as bg_song_pill: faint fill + thin
    hairline border, so chips read as subtle pills instead of the old
    hardcoded grey box.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0A000000"/>
    <stroke android:width="0.75dp" android:color="#1F000000"/>
    <corners android:radius="16dp"/>
</shape>
