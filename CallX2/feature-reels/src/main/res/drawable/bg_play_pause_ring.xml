<?xml version="1.0" encoding="utf-8"?>
<!--
    Colorful sweep-gradient ring — replaces the old flat pink stroke oval
    (bg_play_pause_btn.xml) so the big play/pause button matches the
    screenshot's pink→green circular ring. Also reused around the creator
    avatar (iv_creator_avatar) at a smaller size.

    Built as two stacked ovals (a layer-list "punch"), since a <shape>'s
    <stroke> only accepts a single flat color — it can't carry a gradient.
    The outer oval is fully filled with a sweep gradient; the inner oval,
    inset by the ring's intended thickness, is punched out using the
    screen's own surface color so only a thin colored ring remains visible.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="sweep"
                android:startColor="@color/sound_ring_pink"
                android:centerColor="@color/sound_ring_green"
                android:endColor="@color/sound_ring_pink"
                android:useLevel="false"/>
        </shape>
    </item>
    <item
        android:top="3dp"
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/sound_detail_bg_light"/>
        </shape>
    </item>
</layer-list>
