<?xml version="1.0" encoding="utf-8"?>
<!--
  Theme-aware twin of bg_circle_action, used only by UserReelsActivity's
  Call / Video / YouTube pill row (activity_user_reels.xml). The original
  bg_circle_action is hardcoded dark (#1A1A1A) with no drawable-night
  counterpart, so on this screen's light theme it rendered as a heavy black
  circle behind each colored icon. This day variant uses the app's existing
  light surface token; drawable-night/bg_circle_action_adaptive.xml keeps the
  original dark styling for dark mode.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/surface_bg"/>
    <stroke
        android:width="1dp"
        android:color="#E3E5EA"/>
</shape>
