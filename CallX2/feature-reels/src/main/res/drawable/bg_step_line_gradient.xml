<?xml version="1.0" encoding="utf-8"?>
<!-- ✅ NEW: gradient fill for the step-stepper connecting line once its step
     is reached/passed — same brand gradient as bg_trim_gradient_button, just
     stretched thin so consecutive completed segments read as one joined
     gradient strip instead of separate flat-colored lines. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@color/trim_gradient_start"
        android:endColor="@color/trim_gradient_end"/>
    <corners android:radius="2dp"/>
</shape>
