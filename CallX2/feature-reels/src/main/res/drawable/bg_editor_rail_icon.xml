<?xml version="1.0" encoding="utf-8"?>
<!-- ✅ NEW (Instagram-style editor): circular chip for the right-side vertical
     tool rail in the Reel Editor. Sits directly on top of the live video
     preview, so it stays a translucent dark disc (not a themed card color)
     regardless of light/dark app theme — same treatment Instagram/Reels-style
     editors use for their right-rail icons. See bg_editor_rail_icon_active.xml
     for the selected/current-tool state. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#4D000000"/>
    <stroke android:color="#33FFFFFF" android:width="1dp"/>
</shape>
