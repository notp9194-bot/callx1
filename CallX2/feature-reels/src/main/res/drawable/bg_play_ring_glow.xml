<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_play_ring_glow.xml — soft colour bloom sitting behind the sound-detail
    play-button ring (see fragment_sound_detail.xml, layout_play_ring_container).

    A radial gradient standing in for a real Gaussian blur (no blur library /
    RenderEffect fallback needed pre-API 31): pink center fading through the
    same ring palette out to fully transparent, so it reads as a glow
    "bleeding" outward from the ring rather than a hard-edged colored disc —
    matching the glowing-ring-with-photo-behind-it look from the dark-mode
    screenshot.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="48dp"
        android:startColor="#80FF1493"
        android:centerColor="#40FF8A00"
        android:centerY="0.5"
        android:endColor="#00FFD600"/>
</shape>
