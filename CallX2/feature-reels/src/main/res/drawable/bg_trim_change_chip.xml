<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined pill for the "Change" button at the bottom-left of ReelPhotoMusicTrimActivity -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/trim_chip_selected_bg">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/trim_subcard_bg"/>
            <stroke android:width="1dp" android:color="@color/trim_chip_stroke"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</ripple>
