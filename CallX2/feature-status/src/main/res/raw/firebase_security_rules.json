{
  "rules": {
    // ── User profiles ───────────────────────────────────────────────────────
    "users": {
      "$uid": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    // ── Channels ────────────────────────────────────────────────────────────
    "channels": {
      ".read":  "auth != null",
      "$channelId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id','name','ownerUid','createdAt'])"
      }
    },

    // ── Channel posts ───────────────────────────────────────────────────────
    "channelPosts": {
      "$channelId": {
        ".read":  "auth != null",
        "$postId": {
          ".write": "auth != null",
          "reactions": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid"
            }
          },
          "pollVotes": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid"
            }
          }
        }
      }
    },

    // ── Channel scheduled posts ─────────────────────────────────────────────
    "channelScheduled": {
      "$channelId": {
        ".read":  "auth != null",
        "$postId": {
          ".write": "auth != null"
        }
      }
    },

    // ── Channel follows (user → channel index) ──────────────────────────────
    "channelFollows": {
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    // ── Channel followers (channel → user reverse index) ───────────────────
    "channelFollowers": {
      "$channelId": {
        ".read":  "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.uid == $uid || root.child('channelAdmins').child($channelId).child(auth.uid).exists())"
        }
      }
    },

    // ── Channel admins ─────────────────────────────────────────────────────
    "channelAdmins": {
      "$channelId": {
        ".read":  "auth != null",
        "$uid": {
          ".write": "auth != null && root.child('channelAdmins').child($channelId).child(auth.uid).val() == 'owner'"
        }
      }
    },

    // ── Channel mutes ──────────────────────────────────────────────────────
    "channelMutes": {
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    // ── Channel last-seen timestamps ───────────────────────────────────────
    "channelLastSeen": {
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    // ── Channel invite codes ───────────────────────────────────────────────
    "channelInviteCodes": {
      ".read":  "auth != null",
      "$code": {
        ".write": "auth != null"
      }
    },

    // ── Blocked followers ──────────────────────────────────────────────────
    "channelBlockedFollowers": {
      "$channelId": {
        ".read":  "auth != null && root.child('channelAdmins').child($channelId).child(auth.uid).exists()",
        ".write": "auth != null && root.child('channelAdmins').child($channelId).child(auth.uid).exists()"
      }
    },

    // ── Channel reports ────────────────────────────────────────────────────
    "channelReports": {
      "$channelId": {
        ".read":  false,
        ".write": "auth != null"
      }
    },
    "channelPostReports": {
      "$channelId": {
        "$postId": {
          ".read":  false,
          ".write": "auth != null"
        }
      }
    },

    // ── Channel analytics ──────────────────────────────────────────────────
    "channelAnalytics": {
      "$channelId": {
        ".read":  "auth != null && root.child('channelAdmins').child($channelId).child(auth.uid).exists()",
        ".write": false
      }
    },

    // ── Channel notification prefs ─────────────────────────────────────────
    "channelNotifPrefs": {
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    // ── Direct messages ────────────────────────────────────────────────────
    "messages": {
      "$chatId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    // ── Group messages ─────────────────────────────────────────────────────
    "groupMessages": {
      "$groupId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    // ── Groups ─────────────────────────────────────────────────────────────
    "groups": {
      ".read":  "auth != null",
      "$groupId": {
        ".write": "auth != null"
      }
    },
    "userGroups": {
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    // ── Contacts ───────────────────────────────────────────────────────────
    "contacts": {
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    // ── Status ─────────────────────────────────────────────────────────────
    // NOTE: the blanket "$uid": { ".write": auth.uid == $uid } below only lets
    // the STATUS OWNER write anywhere under their own status/{uid} subtree.
    // That's correct for the status content itself, but seenBy/reactions/
    // replies are all written by OTHER viewers (someone opening your status,
    // reacting to it, or commenting on it) — every one of those writes was
    // being silently rejected, which is why comments never actually reached
    // status/{ownerUid}/{statusId}/replies for anyone to see. Each viewer-
    // driven child now has its own override letting a user write only their
    // own entry (own seenBy flag, own reaction, own reply row); the owner
    // still has full access via the ancestor rule above.
    "status": {
      ".read":  "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        "$statusId": {
          "seenBy": {
            "$viewerUid": {
              ".write": "auth != null && auth.uid == $viewerUid"
            }
          },
          "reactions": {
            "$viewerUid": {
              ".write": "auth != null && auth.uid == $viewerUid"
            }
          },
          "replies": {
            "$replyId": {
              ".write": "auth != null && (!data.exists() || data.child('uid').val() == auth.uid)",
              ".validate": "newData.hasChildren(['uid','name','text','timestamp']) && newData.child('uid').val() == auth.uid"
            }
          }
        }
      }
    },
    "statusSeen": {
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "statusHighlights": {
      "$uid": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    // ── Calls ──────────────────────────────────────────────────────────────
    "calls": {
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        ".write": "auth != null"
      }
    },

    // ── Requests ───────────────────────────────────────────────────────────
    "requests": {
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        ".write": "auth != null"
      }
    }
  }
}
