<?xml version="1.0" encoding="utf-8"?>
<!-- v952: solid = status_card_placeholder (was status_card_body_bg + an identical-looking opaque layer on iv_card_bg => 3 stacked fills). v556: flat card, 16dp corners (@dimen/status_card_radius), no stroke. Used with clipToOutline on a plain FrameLayout. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/status_card_placeholder"/>
    <corners android:radius="@dimen/status_card_radius"/>
</shape>
