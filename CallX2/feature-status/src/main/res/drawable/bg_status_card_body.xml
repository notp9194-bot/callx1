<?xml version="1.0" encoding="utf-8"?>
<!-- v554: replaces MaterialCardView (bg + 1dp stroke + 18dp corners). Used with clipToOutline on a plain FrameLayout. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/status_card_body_bg"/>
    <corners android:radius="18dp"/>
    <stroke android:width="1dp" android:color="@color/status_card_stroke"/>
</shape>
