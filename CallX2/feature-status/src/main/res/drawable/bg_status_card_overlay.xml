<?xml version="1.0" encoding="utf-8"?>
<!-- v556: top vignette (keeps the top-left avatar ring legible on bright images) + bottom name scrim in ONE view. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="top|fill_horizontal" android:height="64dp"
        android:drawable="@drawable/bg_status_card_top_scrim"/>
    <item android:gravity="bottom|fill_horizontal" android:height="84dp"
        android:drawable="@drawable/bg_status_card_bottom_scrim"/>
</layer-list>
