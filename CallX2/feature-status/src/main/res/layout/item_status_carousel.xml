<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- v561: the "Status" title moved into the top bar (fragment_status.xml) -->

    <com.callx.app.feed.NestedScrollableHost
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Shown only until the first status data arrives (see StatusListAdapter.beginInitialLoad) -->
        <LinearLayout
            android:id="@+id/ll_status_skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingBottom="8dp"
            android:importantForAccessibility="no"
            android:visibility="gone">
            <include layout="@layout/item_status_card_skeleton"/>
            <include layout="@layout/item_status_card_skeleton"/>
            <include layout="@layout/item_status_card_skeleton"/>
            <include layout="@layout/item_status_card_skeleton"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_status_carousel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:overScrollMode="never"/>

        <!-- Edge fades as plain gradient overlays (no offscreen layer, unlike requiresFadingEdge).
             Colours + visibility are driven from CarouselVH.updateFades(). -->
        <View
            android:id="@+id/fade_left"
            android:layout_width="20dp"
            android:layout_height="match_parent"
            android:layout_gravity="left"
            android:importantForAccessibility="no"
            android:visibility="invisible"/>
        <View
            android:id="@+id/fade_right"
            android:layout_width="20dp"
            android:layout_height="match_parent"
            android:layout_gravity="right"
            android:importantForAccessibility="no"
            android:visibility="invisible"/>

    </com.callx.app.feed.NestedScrollableHost>

    <!-- Search produced no matches (driven by StatusListAdapter#setSearchEmptyQuery) -->
    <TextView
        android:id="@+id/tv_carousel_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"/>

</LinearLayout>
