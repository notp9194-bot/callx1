<?xml version="1.0" encoding="utf-8"?>
<!-- v758: one "Used By" row — avatar (30dp) + story ring (1.5dp, 2dp gap) + online dot, name, @username, time, View. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground">

    <FrameLayout
        android:layout_width="@dimen/tpl_use_ring"
        android:layout_height="@dimen/tpl_use_ring">
        <ImageView
            android:id="@+id/tu_avatar"
            android:layout_width="@dimen/tpl_use_avatar"
            android:layout_height="@dimen/tpl_use_avatar"
            android:layout_gravity="center"
            android:scaleType="centerCrop"/>
        <ImageView
            android:id="@+id/tu_ring"
            android:layout_width="@dimen/tpl_use_ring"
            android:layout_height="@dimen/tpl_use_ring"
            android:layout_gravity="center"
            android:visibility="gone"/>
        <View
            android:id="@+id/tu_online"
            android:layout_width="@dimen/tpl_use_online_dot"
            android:layout_height="@dimen/tpl_use_online_dot"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_circle_green"
            android:visibility="gone"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tu_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/tu_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/tu_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="12sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tu_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:text="@string/tpl_uses_view"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/rounded_input_bg"/>
</LinearLayout>
