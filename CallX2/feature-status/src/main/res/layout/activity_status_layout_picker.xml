<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_status_layout_picker.xml — WhatsApp-level Layout Picker for Status.

    Structure:
      ┌──────────────────────────────────────────┐
      │  ← toolbar                      Done     │
      ├──────────────────────────────────────────┤
      │  "Start layout / Choose layout" subtitle │
      ├──────────────────────────────────────────┤
      │  StatusLayoutPreviewView  (top preview)  │  ← GONE until ≥1 selected
      ├──────────────────────────────────────────┤
      │  Recents ▾  (folder selector header)     │
      ├──────────────────────────────────────────┤
      │  3-column gallery grid (RecyclerView)    │
      ├──────────────────────────────────────────┤
      │  ────────────────────────────────────── │
      │  [■] [■│■] [■ ■] [■▬] [■│■] [■]  ←6btns│
      └──────────────────────────────────────────┘
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ── Toolbar ─────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layout_picker_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:background="#000000">

        <ImageView
            android:id="@+id/btn_layout_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"/>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tv_layout_picker_done"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Done"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_layout_done_btn"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- ── Main vertical layout ────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="56dp">

        <!-- Title subtitle -->
        <TextView
            android:id="@+id/tv_layout_picker_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start layout"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose up to 6 photos for your layout."
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingBottom="12dp"/>

        <!-- ── Layout preview (hidden until selection starts) ─────────── -->
        <LinearLayout
            android:id="@+id/layout_preview_section"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.callx.app.compose.StatusLayoutPreviewView
                android:id="@+id/layout_preview_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="8dp"/>

            <!-- Small drag handle separator -->
            <View
                android:layout_width="32dp"
                android:layout_height="3dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_drag_handle"
                android:layout_marginBottom="6dp"/>

        </LinearLayout>

        <!-- ── Recents header with folder dropdown ─────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recents"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_arrow_right"
                android:rotation="90"
                android:tint="#AAAAAA"
                android:contentDescription="Dropdown"/>

        </LinearLayout>

        <!-- ── Gallery grid ────────────────────────────────────────────── -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_layout_media_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"/>

        <!-- ── Divider above layout style row ──────────────────────────── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A2A"
            android:layout_marginTop="4dp"/>

        <!-- ── Layout style selector row ───────────────────────────────── -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_layout_styles"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
