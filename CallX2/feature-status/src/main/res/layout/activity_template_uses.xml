<?xml version="1.0" encoding="utf-8"?>
<!-- v758: "Used This Template" — header bar, template summary card, "Used By" list. All icons/backgrounds are existing drawables. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="?android:attr/colorBackground">

    <!-- Top bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <ImageView
            android:id="@+id/tu_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="8dp"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:contentDescription="@null"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:id="@+id/tu_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/tpl_uses_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/tu_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="8dp"
            android:padding="12dp"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/text_primary"
            android:contentDescription="@null"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </FrameLayout>

    <!-- Template summary card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:padding="12dp"
        android:orientation="horizontal"
        android:background="@drawable/rounded_input_bg">

        <FrameLayout
            android:id="@+id/tu_thumb_wrap"
            android:layout_width="72dp"
            android:layout_height="108dp">
            <ImageView
                android:id="@+id/tu_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/card_rounded"/>
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="108dp"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tu_template_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tpl_uses_default_name"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/card_rounded">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_sbar_copy"
                    android:tint="@color/text_primary"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/tpl_uses_story_template"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_pill_people"
                    android:tint="@color/tpl_text_secondary"/>
                <TextView
                    android:id="@+id/tu_used_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/tpl_text_secondary"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end"/>

                <LinearLayout
                    android:id="@+id/tu_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:background="@drawable/card_rounded">
                    <ImageView
                        android:id="@+id/tu_save_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_bookmark"
                        android:tint="@color/text_primary"/>
                    <TextView
                        android:id="@+id/tu_save_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/tpl_uses_save"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- "Used By"  ·  N People -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tpl_uses_used_by"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/tu_people_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tpl_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- v770: All Users / Followers / Following (styled in TemplateUsesActivity) -->
    <LinearLayout
        android:id="@+id/tu_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">
        <TextView
            android:id="@+id/tu_f_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tpl_uses_filter_all"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"/>
        <TextView
            android:id="@+id/tu_f_followers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/tpl_uses_filter_followers"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"/>
        <TextView
            android:id="@+id/tu_f_following"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/tpl_uses_filter_following"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tu_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"/>
        <include
            android:id="@+id/tu_skeleton"
            layout="@layout/layout_template_uses_skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/tu_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/tpl_uses_empty"
            android:textColor="@color/tpl_text_secondary"
            android:visibility="gone"/>
        <ProgressBar
            android:id="@+id/tu_footer_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/tu_footer_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:padding="14dp"
            android:text="@string/tpl_uses_retry"
            android:textColor="@color/text_primary"
            android:background="@drawable/rounded_input_bg"
            android:visibility="gone"/>
    </FrameLayout>
</LinearLayout>
