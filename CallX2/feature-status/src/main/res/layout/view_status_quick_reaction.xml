<?xml version="1.0" encoding="utf-8"?>
<!-- v516: swipe-up / reply-focus emoji grid (Instagram). Emoji glyphs are set from code
     (StatusViewerActivity.QUICK_EMOJIS); no card background — they float over a dim scrim. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_quick_reaction_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/ll_quick_reaction_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <TextView android:id="@+id/tv_qr_1"
                android:layout_width="88dp" android:layout_height="88dp"
                android:gravity="center" android:textSize="48sp"
                android:includeFontPadding="false"
                android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/tv_qr_2"
                android:layout_width="88dp" android:layout_height="88dp"
                android:gravity="center" android:textSize="48sp"
                android:includeFontPadding="false"
                android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/tv_qr_3"
                android:layout_width="88dp" android:layout_height="88dp"
                android:gravity="center" android:textSize="48sp"
                android:includeFontPadding="false"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp">
            <TextView android:id="@+id/tv_qr_4"
                android:layout_width="88dp" android:layout_height="88dp"
                android:gravity="center" android:textSize="48sp"
                android:includeFontPadding="false"
                android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/tv_qr_5"
                android:layout_width="88dp" android:layout_height="88dp"
                android:gravity="center" android:textSize="48sp"
                android:includeFontPadding="false"
                android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/tv_qr_6"
                android:layout_width="88dp" android:layout_height="88dp"
                android:gravity="center" android:textSize="48sp"
                android:includeFontPadding="false"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
