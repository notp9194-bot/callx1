<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/trim_screen_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/trim_screen_bg"
            android:title="New Status"
            app:navigationIcon="@drawable/ic_back"
            app:titleTextColor="@color/trim_text_primary"
            app:contentInsetStartWithNavigation="8dp"/>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/status_form_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Reel-style step header. The preview below stays visible while
                 the user moves through each status step. -->
            <LinearLayout
                android:id="@+id/status_wizard_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_step_eyebrow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CREATE YOUR STATUS"
                        android:textColor="@color/trim_gradient_end"
                        android:textSize="15sp"
                        android:letterSpacing="0.12"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:id="@+id/tv_step_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 of 3"
                        android:textColor="@color/trim_text_secondary"
                        android:textSize="16sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/status_stepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <ImageView
                            android:id="@+id/step_ring_1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/bg_step_active_ring_blue"
                            android:contentDescription="@null"
                            android:visibility="gone"/>

                        <TextView
                            android:id="@+id/step_dot_1"
                            android:layout_gravity="center"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:background="@drawable/bg_trim_gradient_button"/>
                    </FrameLayout>
                    <View
                        android:id="@+id/step_line_1"
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="6dp"
                        android:background="@color/trim_divider"/>
                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <ImageView
                            android:id="@+id/step_ring_2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/bg_step_active_ring_blue"
                            android:contentDescription="@null"
                            android:visibility="gone"/>

                        <TextView
                            android:id="@+id/step_dot_2"
                            android:layout_gravity="center"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:gravity="center"
                            android:text="2"
                            android:textColor="@color/trim_text_secondary"
                            android:textStyle="bold"
                            android:background="@drawable/bg_trim_circle_btn"/>
                    </FrameLayout>
                    <View
                        android:id="@+id/step_line_2"
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="6dp"
                        android:background="@color/trim_divider"/>
                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <ImageView
                            android:id="@+id/step_ring_3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/bg_step_active_ring_blue"
                            android:contentDescription="@null"
                            android:visibility="gone"/>

                        <TextView
                            android:id="@+id/step_dot_3"
                            android:layout_gravity="center"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="@color/trim_text_secondary"
                            android:textStyle="bold"
                            android:background="@drawable/bg_trim_circle_btn"/>
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Create"
                        android:textColor="@color/trim_text_secondary"
                        android:textSize="11sp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Edit"
                        android:textColor="@color/trim_text_secondary"
                        android:textSize="11sp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Publish"
                        android:textColor="@color/trim_text_secondary"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Persistent cross-step preview for text and media. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/status_step_preview_card"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/trim_divider"
                app:strokeWidth="1dp"
                android:background="@drawable/bg_trim_subcard">

                <FrameLayout
                    android:id="@+id/status_step_preview_frame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_trim_photo_rounded">

                    <ImageView
                        android:id="@+id/iv_step_preview_media"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:contentDescription="Status media preview"/>

                    <TextView
                        android:id="@+id/tv_step_preview_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="28dp"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/tv_step_preview_empty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Your preview will appear here"
                        android:textColor="@color/trim_text_secondary"
                        android:textSize="14sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:text="PREVIEW"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:letterSpacing="0.12"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_trim_preview_badge"/>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Text input ── -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_text"
                android:tag="wizard_step_text"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Type your status…"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="6"
                    android:minLines="3"/>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tv_char_count"
                android:tag="wizard_step_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="0 / 700"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="12dp"
                android:layout_marginEnd="4dp"/>

            <!-- ── Background color picker ── -->
            <LinearLayout
                android:id="@+id/bg_color_picker_row"
                android:tag="wizard_step_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:gravity="center">

                <View android:id="@+id/color_swatch_0"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:layout_margin="4dp" android:background="@drawable/circle_primary"/>
                <View android:id="@+id/color_swatch_1"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:layout_margin="4dp" android:background="@drawable/circle_primary"/>
                <View android:id="@+id/color_swatch_2"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:layout_margin="4dp" android:background="@drawable/circle_primary"/>
                <View android:id="@+id/color_swatch_3"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:layout_margin="4dp" android:background="@drawable/circle_primary"/>
                <View android:id="@+id/color_swatch_4"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:layout_margin="4dp" android:background="@drawable/circle_primary"/>
                <View android:id="@+id/color_swatch_5"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:layout_margin="4dp" android:background="@drawable/circle_primary"/>
                <View android:id="@+id/color_swatch_6"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:layout_margin="4dp" android:background="@drawable/circle_primary"/>
                <View android:id="@+id/color_swatch_7"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:layout_margin="4dp" android:background="@drawable/circle_primary"/>
                <View android:id="@+id/color_swatch_8"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:layout_margin="4dp" android:background="@drawable/circle_primary"/>
                <View android:id="@+id/color_swatch_9"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:layout_margin="4dp" android:background="@drawable/circle_primary"/>

            </LinearLayout>

            <!-- ── Font style picker ── -->
            <HorizontalScrollView
                android:tag="wizard_step_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_font_default"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="72dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:text="Aa"
                        android:textSize="13sp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_font_bold"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="72dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:text="Aa"
                        android:textStyle="bold"
                        android:textSize="13sp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_font_italic"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="72dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:text="Aa"
                        android:textStyle="italic"
                        android:textSize="13sp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_font_handwriting"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="72dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:text="Aa"
                        android:fontFamily="monospace"
                        android:textSize="13sp"/>

                    <com.google.android.material.button.MaterialButton
                        android:tag="btn_font_condensed"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="72dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:text="Aa"
                        android:fontFamily="sans-serif-condensed"
                        android:textSize="13sp"/>

                    <com.google.android.material.button.MaterialButton
                        android:tag="btn_font_serif"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="72dp"
                        android:layout_height="36dp"
                        android:text="Aa"
                        android:fontFamily="serif"
                        android:textSize="13sp"/>

                </LinearLayout>

            </HorizontalScrollView>

            <!-- ── Text alignment picker ── -->
            <LinearLayout
                android:tag="wizard_step_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:tag="btn_align_left"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    app:icon="@drawable/ic_status_align_left"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="Align left"/>

                <com.google.android.material.button.MaterialButton
                    android:tag="btn_align_center"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    app:icon="@drawable/ic_status_align_center"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="Align center"/>

                <com.google.android.material.button.MaterialButton
                    android:tag="btn_align_right"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:icon="@drawable/ic_status_align_right"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="Align right"/>

            </LinearLayout>

            <!-- ── Link preview card (auto-shown when a URL is typed) ── -->
            <com.google.android.material.card.MaterialCardView
                android:tag="link_preview_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ProgressBar
                        android:tag="link_preview_progress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="16dp"
                        android:visibility="gone"/>

                    <LinearLayout
                        android:tag="link_preview_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="10dp"
                        android:visibility="gone">

                        <ImageView
                            android:tag="link_preview_image"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:scaleType="centerCrop"
                            android:background="@drawable/card_rounded"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Link preview"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:tag="link_preview_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="Title"/>

                            <TextView
                                android:tag="link_preview_desc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:text="Description"/>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="2dp">

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/ic_status_link"
                                    android:layout_marginEnd="4dp"/>

                                <TextView
                                    android:tag="link_preview_domain"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp"
                                    android:text="domain.com"/>

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Media button ──
                 Photo + Video merged into one "Upload" button (was two
                 separate buttons). Tapping it shows the same Camera/Gallery/
                 Cancel dialog as before; "Gallery" now opens the shared
                 chat attach-sheet (multi-select + caption + edit + view-once)
                 instead of a plain single-file picker. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pick_image"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Upload"
                app:icon="@drawable/ic_gallery"
                app:cornerRadius="14dp"
                android:layout_marginBottom="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:tag="btn_gif"
                android:id="@+id/btn_gif"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Add GIF / Sticker"
                app:icon="@drawable/ic_gif"
                app:cornerRadius="14dp"
                android:layout_marginBottom="8dp"/>

            <!-- ╔══════════════════════════════════════════════════════════╗ -->
            <!-- ║  NEW v26 — Interactive Sticker Picker Button             ║ -->
            <!-- ╚══════════════════════════════════════════════════════════╝ -->
            <com.google.android.material.button.MaterialButton
                android:tag="btn_add_sticker"
                android:id="@+id/btn_add_sticker"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🎵 Add Sticker (Music · Countdown · Quiz · Question)"
                app:cornerRadius="14dp"
                android:textSize="13sp"
                android:layout_marginBottom="16dp"
                app:strokeColor="@color/brand_primary"
                app:strokeWidth="1.5dp"/>

            <!-- ── Media preview (wrapped in sticker overlay FrameLayout) ── -->
            <!--
                sticker_overlay_frame: Interactive sticker cards (Music, Countdown,
                Quiz, Question) are injected as child views on top of the preview.
                The host Activity finds this FrameLayout by tag and adds overlays to it.
            -->
            <FrameLayout
                android:tag="sticker_overlay_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:id="@+id/media_preview_frame">

                <!-- Actual media preview image -->
                <!-- v238 BUG FIX: this used to be a fixed 240dp box with
                     scaleType "centerCrop" — tiny, and cropped the photo/
                     layout collage so the person couldn't actually see what
                     they were about to post. Now it's much taller (420dp)
                     with "fitCenter" so the FULL frame is always visible,
                     uncropped, same as the fix already applied to the
                     full-screen status viewer — bg_status_preview_media
                     fills any letterbox space with black instead of the
                     light card color showing through. -->
                <ImageView
                    android:id="@+id/iv_preview"
                    android:layout_width="match_parent"
                    android:layout_height="420dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:background="@drawable/bg_status_preview_media"/>

                <!-- Video play-hint icon -->
                <ImageView
                    android:id="@+id/iv_video_hint"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play"
                    android:tint="@color/white"
                    android:visibility="gone"/>

                <!-- Discard media button -->
                <ImageButton
                    android:id="@+id/btn_discard_media"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="@color/white"
                    android:background="@drawable/circle_avatar_bg"
                    android:padding="6dp"
                    android:visibility="gone"
                    android:contentDescription="Discard media"/>

                <!-- Sticker overlays are added here programmatically by NewStatusActivity -->

            </FrameLayout>

            <!-- ── Caption (shown when media is selected) ── -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/caption_group"
                android:tag="wizard_step_media"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Add caption…"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="2"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ── Upload progress ── -->
            <ProgressBar
                android:id="@+id/upload_progress"
                android:tag="wizard_step_publish"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:indeterminate="true"
                android:visibility="gone"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_upload_hint"
                android:tag="wizard_step_publish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="8dp"
                android:text="Uploading media…"/>

            <!-- ── Expiry timer + Close friends (NEW) ── -->
            <LinearLayout
                android:tag="wizard_step_publish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:tag="btn_expiry"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="⏱ 24 hours"
                    app:cornerRadius="18dp"
                    android:layout_marginEnd="12dp"/>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_status_star"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Close friends only"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:tag="toggle_close_friends"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <!-- ── Privacy selector ── -->
            <LinearLayout
                android:tag="wizard_step_publish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_shield"
                    android:tint="@color/text_secondary"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Visible to:"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_privacy"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="My contacts"
                    app:cornerRadius="18dp"/>

            </LinearLayout>

            <!-- ── Allow sharing (Status Repost, v56) ── -->
            <LinearLayout
                android:tag="wizard_step_publish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_repost"
                    android:tint="@color/text_secondary"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Allow sharing"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:tag="toggle_allow_sharing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"/>

            </LinearLayout>

            <!-- ── Ring color (avatar highlight ring, same picker as Highlights) ── -->
            <LinearLayout
                android:tag="wizard_step_publish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_status_star"
                    android:tint="@color/text_secondary"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Avatar ring color"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"/>

                <com.google.android.material.button.MaterialButton
                    android:tag="btn_ring_color"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="⚪ Ring color"
                    app:cornerRadius="18dp"/>

            </LinearLayout>

            <!-- ── Post button — reuses the core Done-button style (same
                 bg_trim_gradient_button_ripple as the Photo Editor's Done
                 button, the Audio Mixer's Done button, the Reel Upload
                 screen's Next/Post Reel buttons, and the Reel Edit screen's
                 Save Changes button) instead of the flat MaterialButton
                 backgroundTint. ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_post"
                android:tag="wizard_step_publish"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Post Status"
                app:cornerRadius="16dp"
                android:background="@drawable/bg_trim_gradient_button_ripple"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/status_wizard_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/btn_step_back"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="82dp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Back"
                    android:textColor="@color/trim_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_trim_duration_chip"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/btn_step_next"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="112dp"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="Continue"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_trim_gradient_button_ripple"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
