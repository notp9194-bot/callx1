<?xml version="1.0" encoding="utf-8"?>
  <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
      xmlns:app="http://schemas.android.com/apk/res-auto"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/black">

      <!-- Full-screen content layers -->
      <!-- WhatsApp-style backdrop: a blurred, darkened, cropped copy of the
           same image fills the whole screen behind the actual photo, which
           is shown with fitCenter (never cropped) on top of it. See
           StatusViewerActivity#showImageStatusFromUrl() / StatusBlurTransformation. -->
      <ImageView
          android:id="@+id/iv_status_bg"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:scaleType="centerCrop"
          android:visibility="gone"/>

      <ImageView
          android:id="@+id/iv_status"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:scaleType="fitCenter"
          android:visibility="gone"/>

      <androidx.media3.ui.PlayerView
          android:id="@+id/player_view"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          app:surface_type="texture_view"
          android:visibility="gone"/>

      <!-- Instagram-style floating reaction replay — plays once when this
           status/reel-as-status has received emoji reactions. Purely
           visual, never intercepts touch. See
           StatusViewerActivity#playReactionBurstIfAny(). -->
      <com.callx.app.reaction.FloatingReactionOverlayView
          android:id="@+id/reaction_burst_overlay"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:visibility="gone"/>

      <!-- Text status -->
      <FrameLayout
          android:id="@+id/fl_text_status"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:visibility="gone">
          <TextView
              android:id="@+id/tv_text_status"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_gravity="center"
              android:padding="40dp"
              android:textColor="@color/white"
              android:textSize="28sp"
              android:textStyle="bold"
              android:gravity="center"
              android:lineSpacingMultiplier="1.2"/>
      </FrameLayout>

      <!-- ── Reshare attribution card overlay (reel_reshare / post_reshare) ── -->
      <FrameLayout
          android:id="@+id/fl_reshare_attribution_container"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="bottom|center_horizontal"
          android:layout_marginBottom="100dp"
          android:visibility="gone">

          <LinearLayout
              android:id="@+id/ll_reshare_attribution_card"
              android:layout_width="280dp"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:background="@drawable/bg_reshare_card"
              android:padding="10dp"
              android:gravity="center_vertical"
              android:clickable="true"
              android:focusable="true"
              android:foreground="?attr/selectableItemBackground">

              <ImageView
                  android:id="@+id/iv_reshare_thumb"
                  android:layout_width="56dp"
                  android:layout_height="56dp"
                  android:scaleType="centerCrop"
                  android:background="#CCCCCC"/>

              <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:orientation="vertical"
                  android:layout_marginStart="10dp">

                  <TextView
                      android:id="@+id/tv_reshare_type_badge"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="Reel"
                      android:textSize="10sp"
                      android:textColor="#FFFFFF"
                      android:background="#C13584"
                      android:paddingStart="6dp"
                      android:paddingEnd="6dp"
                      android:paddingTop="2dp"
                      android:paddingBottom="2dp"/>

                  <TextView
                      android:id="@+id/tv_reshare_original_owner"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:textSize="13sp"
                      android:textStyle="bold"
                      android:textColor="#1A1A1A"
                      android:layout_marginTop="4dp"
                      android:maxLines="1"
                      android:ellipsize="end"/>

                  <TextView
                      android:id="@+id/tv_view_original_btn"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="View Original →"
                      android:textSize="12sp"
                      android:textColor="#0095F6"
                      android:layout_marginTop="3dp"
                      android:clickable="true"
                      android:focusable="true"
                      android:background="?attr/selectableItemBackground"/>
              </LinearLayout>
          </LinearLayout>
      </FrameLayout>

      <!-- Touch capture layer -->
      <View
          android:id="@+id/touch_layer"
          android:layout_width="match_parent"
          android:layout_height="match_parent"/>

      <!-- Interactive sticker overlay (music/countdown/quiz/question cards).
           Declared after touch_layer so a tap landing on a sticker card is
           handled by that card's own click listener instead of falling
           through to the tap-to-navigate layer underneath — same ordering
           trick the header/footer controls below already rely on. Empty
           areas of this FrameLayout aren't clickable, so taps there still
           pass through to touch_layer as normal. -->
      <FrameLayout
          android:id="@+id/fl_sticker_overlay"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:clickable="false"
          android:focusable="false"/>

      <!-- Top chrome -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingTop="8dp">

          <!-- Progress bars -->
          <LinearLayout
              android:id="@+id/segments_container"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:paddingStart="8dp"
              android:paddingEnd="8dp"
              android:paddingTop="4dp"
              android:paddingBottom="4dp"
              android:gravity="center_vertical"/>

          <!-- Header row: avatar + name + expiry + more + close -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:paddingStart="12dp"
              android:paddingEnd="8dp"
              android:paddingTop="6dp"
              android:paddingBottom="8dp"
              android:gravity="center_vertical">

              <de.hdodenhof.circleimageview.CircleImageView
                  android:id="@+id/iv_owner"
                  android:layout_width="38dp"
                  android:layout_height="38dp"
                  android:src="@drawable/ic_person"/>

              <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:orientation="vertical"
                  android:layout_marginStart="10dp">

                  <LinearLayout
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:orientation="horizontal"
                      android:gravity="center_vertical">

                      <TextView
                          android:id="@+id/tv_owner"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:textColor="@color/white"
                          android:textStyle="bold"
                          android:textSize="15sp"
                          android:shadowColor="@color/black"
                          android:shadowRadius="2"
                          android:shadowDx="0"
                          android:shadowDy="1"/>

                      <ImageView
                          android:id="@+id/iv_owner_verified"
                          android:layout_width="14dp"
                          android:layout_height="14dp"
                          android:layout_marginStart="4dp"
                          android:src="@drawable/ic_verified_pink"
                          android:visibility="gone"
                          android:contentDescription="Verified"/>
                  </LinearLayout>

                  <!-- NEW: audio-name ticker, directly below the owner name —
                       shown only when this status has a music sticker attached.
                       Reuses core's MusicTickerView, the exact same component
                       (and continuous-scroll animation) already used by the
                       reel player's bio song row (ll_bio_song_row /
                       tv_bio_song_name in fragment_reel_player.xml) — no
                       duplicate ticker implementation. -->
                  <LinearLayout
                      android:id="@+id/ll_status_song_row"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_marginTop="2dp"
                      android:orientation="horizontal"
                      android:gravity="center_vertical"
                      android:visibility="gone">

                      <ImageView
                          android:layout_width="11dp"
                          android:layout_height="11dp"
                          android:src="@drawable/ic_music_note"
                          android:tint="@color/white"
                          android:contentDescription="Song"/>

                      <com.callx.app.views.MusicTickerView
                          android:id="@+id/tv_status_song_name"
                          android:layout_width="150dp"
                          android:layout_height="wrap_content"
                          android:layout_marginStart="4dp"/>
                  </LinearLayout>

                  <LinearLayout
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:orientation="horizontal"
                      android:gravity="center_vertical">

                      <TextView
                          android:id="@+id/tv_timestamp"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:textColor="#CCFFFFFF"
                          android:textSize="12sp"/>

                      <!-- FIX: expiry label — was findViewWithTag, now proper ID -->
                      <TextView
                          android:id="@+id/tv_expiry_label"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:layout_marginStart="6dp"
                          android:textColor="#AAFFFFFF"
                          android:textSize="11sp"
                          android:visibility="gone"/>

                  </LinearLayout>

              </LinearLayout>

              <!-- More options -->
              <ImageButton
                  android:id="@+id/btn_more"
                  android:layout_width="40dp"
                  android:layout_height="40dp"
                  android:src="@android:drawable/ic_menu_more"
                  android:tint="@color/white"
                  android:background="?attr/selectableItemBackgroundBorderless"/>

              <!-- Close -->
              <ImageButton
                  android:id="@+id/btn_close_status"
                  android:layout_width="40dp"
                  android:layout_height="40dp"
                  android:src="@drawable/ic_back"
                  android:tint="@color/white"
                  android:background="?attr/selectableItemBackgroundBorderless"/>

          </LinearLayout>

      </LinearLayout>

      <!-- Mute button (video only) -->
      <ImageButton
          android:id="@+id/btn_mute"
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:layout_gravity="end|top"
          android:layout_marginTop="72dp"
          android:layout_marginEnd="12dp"
          android:src="@drawable/ic_volume_on"
          android:tint="@color/white"
          android:background="@drawable/bg_circle_dark"
          android:padding="8dp"
          android:visibility="gone"
          android:contentDescription="Mute"/>

      <!-- FIX: Download + Forward action row (was findViewWithTag, now proper IDs) -->
      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="end|top"
          android:layout_marginTop="124dp"
          android:layout_marginEnd="12dp"
          android:orientation="vertical">

          <ImageButton
              android:id="@+id/btn_download"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:src="@android:drawable/ic_menu_save"
              android:tint="@color/white"
              android:background="@drawable/bg_circle_dark"
              android:padding="8dp"
              android:contentDescription="Download"
              android:visibility="gone"/>

          <ImageButton
              android:id="@+id/btn_forward"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:layout_marginTop="8dp"
              android:src="@drawable/ic_arrow_right"
              android:tint="@color/white"
              android:background="@drawable/bg_circle_dark"
              android:padding="8dp"
              android:contentDescription="Forward"
              android:visibility="gone"/>

          <!-- Repost button — visible for viewers when owner allows sharing -->
          <ImageButton
              android:id="@+id/btn_repost"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:layout_marginTop="8dp"
              android:src="@drawable/ic_repost"
              android:tint="@color/white"
              android:background="@drawable/bg_circle_dark"
              android:padding="8dp"
              android:contentDescription="Repost to my status"
              android:visibility="gone"/>

      </LinearLayout>

      <!-- Bottom chrome -->
      <LinearLayout
          android:id="@+id/ll_bottom_chrome"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_gravity="bottom"
          android:orientation="vertical"
          android:background="@drawable/bg_status_reply_overlay"
          android:paddingTop="32dp"
          android:paddingBottom="12dp"
          android:paddingStart="12dp"
          android:paddingEnd="12dp">

          <!-- FIX: Location tag — was findViewWithTag("tv_location_tag"), now proper ID -->
          <TextView
              android:id="@+id/tv_location_tag"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:textColor="#EEFFFFFF"
              android:textSize="13sp"
              android:paddingBottom="4dp"
              android:drawablePadding="4dp"
              android:visibility="gone"/>

          <!-- Caption -->
          <TextView
              android:id="@+id/tv_caption"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:textColor="@color/white"
              android:textSize="14sp"
              android:paddingBottom="8dp"
              android:shadowColor="@color/black"
              android:shadowRadius="4"
              android:shadowDx="0"
              android:shadowDy="1"
              android:visibility="gone"/>

          <!-- Seen-by info (owner only) -->
          <TextView
              android:id="@+id/tv_seen_by"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:textColor="#CCFFFFFF"
              android:textSize="13sp"
              android:paddingBottom="8dp"
              android:drawablePadding="4dp"
              android:clickable="true"
              android:focusable="true"
              android:background="?attr/selectableItemBackground"
              android:visibility="gone"/>

          <!-- Latest-replies overlay (shown to every viewer, owner included) — Instagram-style: shows up to the
               last 3 commenters' avatars STACKED (overlapping, newest on top) plus
               the most recent comment's text, bottom-left on the story itself, so
               the owner sees it at a glance instead of having to open the chat DM.
               Populated/shown by StatusViewerActivity#updateLastReplyOverlay(); auto
               fades out a few seconds after showing (tap re-opens it early); tapping
               opens StatusRepliesBottomSheet with the full comment list. -->
          <LinearLayout
              android:id="@+id/ll_last_reply_bubble"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_gravity="start"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:paddingStart="6dp"
              android:paddingEnd="12dp"
              android:paddingTop="6dp"
              android:paddingBottom="6dp"
              android:layout_marginBottom="8dp"
              android:background="@drawable/bg_status_reply_overlay"
              android:clickable="true"
              android:focusable="true"
              android:visibility="gone">

              <!-- Stack: each avatar overlaps the previous by 12dp (negative start
                   margin) with a border so they read as a distinct stack, exactly
                   like Instagram's "recent repliers" cluster. Index 1 = oldest of
                   the 3 (drawn first, bottom of stack), 3 = newest (drawn last, on
                   top) — see bindLastReplyBubble() for the ordering. -->
              <FrameLayout
                  android:layout_width="wrap_content"
                  android:layout_height="26dp">

                  <de.hdodenhof.circleimageview.CircleImageView
                      android:id="@+id/iv_last_reply_avatar_1"
                      android:layout_width="24dp"
                      android:layout_height="24dp"
                      android:layout_marginStart="0dp"
                      android:src="@drawable/ic_person"
                      app:civ_border_width="1dp"
                      app:civ_border_color="@color/white"
                      android:visibility="gone"/>

                  <de.hdodenhof.circleimageview.CircleImageView
                      android:id="@+id/iv_last_reply_avatar_2"
                      android:layout_width="24dp"
                      android:layout_height="24dp"
                      android:layout_marginStart="14dp"
                      android:src="@drawable/ic_person"
                      app:civ_border_width="1dp"
                      app:civ_border_color="@color/white"
                      android:visibility="gone"/>

                  <de.hdodenhof.circleimageview.CircleImageView
                      android:id="@+id/iv_last_reply_avatar_3"
                      android:layout_width="24dp"
                      android:layout_height="24dp"
                      android:layout_marginStart="28dp"
                      android:src="@drawable/ic_person"
                      app:civ_border_width="1dp"
                      app:civ_border_color="@color/white"
                      android:visibility="gone"/>

              </FrameLayout>

              <TextView
                  android:id="@+id/tv_last_reply_text"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="8dp"
                  android:maxWidth="220dp"
                  android:maxLines="1"
                  android:ellipsize="end"
                  android:textColor="@color/white"
                  android:textSize="13sp"/>

          </LinearLayout>

          <!-- Reaction + reply row -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical">

              <com.google.android.material.textfield.TextInputLayout
                  style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:hint="Reply to status…"
                  app:boxCornerRadiusTopEnd="24dp"
                  app:boxCornerRadiusTopStart="24dp"
                  app:boxCornerRadiusBottomEnd="24dp"
                  app:boxCornerRadiusBottomStart="24dp"
                  app:hintTextColor="@color/white"
                  app:boxStrokeColor="@color/white">

                  <com.google.android.material.textfield.TextInputEditText
                      android:id="@+id/et_reply"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:textColor="@color/white"
                      android:maxLines="2"
                      android:inputType="textCapSentences"/>

              </com.google.android.material.textfield.TextInputLayout>

              <ImageButton
                  android:id="@+id/btn_react"
                  android:layout_width="44dp"
                  android:layout_height="44dp"
                  android:layout_marginStart="8dp"
                  android:src="@drawable/ic_status_notification"
                  android:tint="@color/white"
                  android:background="?attr/selectableItemBackgroundBorderless"
                  android:contentDescription="React"/>

              <!-- WhatsApp-style quick-like: single tap sends a ❤️ reaction
                   immediately (no picker); tap again to remove it. Long-press
                   still opens the full emoji picker via btn_react above. -->
              <ImageButton
                  android:id="@+id/btn_like_heart"
                  android:layout_width="44dp"
                  android:layout_height="44dp"
                  android:layout_marginStart="4dp"
                  android:padding="9dp"
                  android:src="@drawable/ic_heart"
                  android:background="?attr/selectableItemBackgroundBorderless"
                  android:contentDescription="Like status"/>

              <ImageButton
                  android:id="@+id/btn_send_reply"
                  android:layout_width="44dp"
                  android:layout_height="44dp"
                  android:layout_marginStart="4dp"
                  android:src="@drawable/ic_send_fill"
                  android:tint="@color/white"
                  android:background="?attr/selectableItemBackgroundBorderless"
                  android:contentDescription="Send reply"/>

          </LinearLayout>

      </LinearLayout>

      <!-- Swipe-up-to-react overlay — WhatsApp/Instagram style. Hidden by
           default; StatusViewerActivity#openQuickReactionOverlay() shows this
           (and focuses the reply box, opening the keyboard) when the viewer
           swipes up over the status content. Tapping an emoji sends that
           reaction immediately (same Firebase write + chat message as the
           quick-like heart) and dismisses everything; tapping the dimmed
           scrim outside the card dismisses without reacting. -->
      <FrameLayout
          android:id="@+id/fl_quick_reaction_overlay"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="#99000000"
          android:clickable="true"
          android:focusable="true"
          android:visibility="gone">

          <LinearLayout
              android:id="@+id/ll_quick_reaction_card"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_gravity="center_horizontal|bottom"
              android:layout_marginBottom="118dp"
              android:orientation="vertical"
              android:background="@drawable/bg_quick_reaction_card"
              android:paddingHorizontal="14dp"
              android:paddingVertical="12dp"
              android:gravity="center"
              android:clickable="true"
              android:focusable="true">

              <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center">

                  <TextView android:id="@+id/tv_qr_1" android:tag="\uD83D\uDE02" android:textColor="#FFFFFFFF"
                      android:layout_width="52dp" android:layout_height="52dp"
                      android:gravity="center" android:textSize="30sp"
                      android:text="\uD83D\uDE02"
                      android:background="?attr/selectableItemBackgroundBorderless"
                      android:clickable="true" android:focusable="true"/>
                  <TextView android:id="@+id/tv_qr_2" android:tag="\uD83D\uDE2E" android:textColor="#FFFFFFFF"
                      android:layout_width="52dp" android:layout_height="52dp"
                      android:gravity="center" android:textSize="30sp"
                      android:text="\uD83D\uDE2E"
                      android:background="?attr/selectableItemBackgroundBorderless"
                      android:clickable="true" android:focusable="true"/>
                  <TextView android:id="@+id/tv_qr_3" android:tag="\uD83D\uDE0D" android:textColor="#FFFFFFFF"
                      android:layout_width="52dp" android:layout_height="52dp"
                      android:gravity="center" android:textSize="30sp"
                      android:text="\uD83D\uDE0D"
                      android:background="?attr/selectableItemBackgroundBorderless"
                      android:clickable="true" android:focusable="true"/>
              </LinearLayout>

              <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center"
                  android:layout_marginTop="2dp">

                  <TextView android:id="@+id/tv_qr_4" android:tag="\uD83D\uDE22" android:textColor="#FFFFFFFF"
                      android:layout_width="52dp" android:layout_height="52dp"
                      android:gravity="center" android:textSize="30sp"
                      android:text="\uD83D\uDE22"
                      android:background="?attr/selectableItemBackgroundBorderless"
                      android:clickable="true" android:focusable="true"/>
                  <TextView android:id="@+id/tv_qr_5" android:tag="\uD83D\uDC4F" android:textColor="#FFFFFFFF"
                      android:layout_width="52dp" android:layout_height="52dp"
                      android:gravity="center" android:textSize="30sp"
                      android:text="\uD83D\uDC4F"
                      android:background="?attr/selectableItemBackgroundBorderless"
                      android:clickable="true" android:focusable="true"/>
                  <TextView android:id="@+id/tv_qr_6" android:tag="\uD83D\uDD25" android:textColor="#FFFFFFFF"
                      android:layout_width="52dp" android:layout_height="52dp"
                      android:gravity="center" android:textSize="30sp"
                      android:text="\uD83D\uDD25"
                      android:background="?attr/selectableItemBackgroundBorderless"
                      android:clickable="true" android:focusable="true"/>
              </LinearLayout>

          </LinearLayout>

      </FrameLayout>

  </FrameLayout>