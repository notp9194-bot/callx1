<?xml version="1.0" encoding="utf-8"?>
  <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
      xmlns:app="http://schemas.android.com/apk/res-auto"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="#0B0F17">

      <!-- Instagram-style layout: [ rounded story card ] over [ solid reply bar ].
           Everything that used to float over the full-screen photo now lives in
           fl_story_card; only the reply row moved out (ll_reply_bar). The column
           shrinks the card when the keyboard opens (insets applied in code). -->
      <!-- Whole-screen blurred, color-matched backdrop (behind status bar, card gap and
           reply bar) — same blurred copy of the photo as iv_status_bg, Instagram style.
           Hidden (flat dark root) for video / text statuses. -->
      <ImageView
          android:id="@+id/iv_root_bg"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:scaleType="centerCrop"
          android:importantForAccessibility="no"
          android:visibility="gone"/>

      <LinearLayout
          android:id="@+id/ll_viewer_column"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:orientation="vertical">

      <FrameLayout
          android:id="@+id/fl_story_card"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:clipToOutline="true">

      <!-- Full-screen content layers -->
      <!-- WhatsApp-style backdrop: a blurred, darkened, cropped copy of the
           same image fills the whole screen behind the actual photo, which
           is shown with fitCenter (never cropped) on top of it. See
           StatusViewerActivity#showImageStatusFromUrl() / StatusBlurTransformation. -->
      <ImageView
          android:id="@+id/iv_status_bg"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:scaleType="centerCrop"
          android:visibility="gone"/>

      <ImageView
          android:id="@+id/iv_status"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:scaleType="fitCenter"
          android:visibility="gone"/>

      <androidx.media3.ui.PlayerView
          android:id="@+id/player_view"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          app:surface_type="texture_view"
          android:visibility="gone"/>

      <!-- Instagram-style floating reaction replay — plays once when this
           status/reel-as-status has received emoji reactions. Purely
           visual, never intercepts touch. See
           StatusViewerActivity#playReactionBurstIfAny(). -->
      <com.callx.app.reaction.FloatingReactionOverlayView
          android:id="@+id/reaction_burst_overlay"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:visibility="gone"/>

      <!-- Text status — v507: ViewStub, inflated on first text status. -->
      <ViewStub
          android:id="@+id/stub_text_status"
          android:inflatedId="@+id/fl_text_status"
          android:layout="@layout/view_status_text_layer"
          android:layout_width="match_parent"
          android:layout_height="match_parent"/>

      <!-- ── Reshare attribution card (reel_reshare / post_reshare) — v507: ViewStub,
           inflated only for reshared statuses. Gravity/margin live here (stub params win). ── -->
      <ViewStub
          android:id="@+id/stub_reshare_card"
          android:inflatedId="@+id/fl_reshare_attribution_container"
          android:layout="@layout/view_status_reshare_card"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="bottom|center_horizontal"
          android:layout_marginBottom="100dp"/>

      <!-- Touch capture layer -->
      <View
          android:id="@+id/touch_layer"
          android:layout_width="match_parent"
          android:layout_height="match_parent"/>

      <!-- Fixed-height top/bottom scrims (non-clickable → taps pass through to
           touch_layer). Keep header + caption/reply bar readable over any photo,
           independent of how tall the caption is. -->
      <View
          android:id="@+id/view_top_scrim"
          android:layout_width="match_parent"
          android:layout_height="120dp"
          android:layout_gravity="top"
          android:background="@drawable/bg_status_top_scrim"
          android:importantForAccessibility="no"/>
      <View
          android:id="@+id/view_bottom_scrim"
          android:layout_width="match_parent"
          android:layout_height="140dp"
          android:layout_gravity="bottom"
          android:background="@drawable/bg_status_bottom_scrim"
          android:importantForAccessibility="no"/>

      <!-- Interactive sticker overlay (music/countdown/quiz/question cards).
           v507: ViewStub — inflated only when a status actually has stickers (or a load-error
           card). Still declared after touch_layer so sticker taps win over tap-to-navigate;
           ViewStub keeps its slot in the parent, so z-order is unchanged. -->
      <ViewStub
          android:id="@+id/stub_sticker_overlay"
          android:inflatedId="@+id/fl_sticker_overlay"
          android:layout="@layout/view_status_sticker_overlay"
          android:layout_width="match_parent"
          android:layout_height="match_parent"/>
      <!-- Top chrome -->
      <LinearLayout
          android:id="@+id/ll_top_chrome"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingTop="8dp">

          <!-- Progress bars -->
          <LinearLayout
              android:id="@+id/segments_container"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:paddingStart="8dp"
              android:paddingEnd="8dp"
              android:paddingTop="4dp"
              android:paddingBottom="4dp"
              android:gravity="center_vertical"/>

          <!-- Header row: avatar + name + expiry + more + close -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:paddingStart="12dp"
              android:paddingEnd="8dp"
              android:paddingTop="6dp"
              android:paddingBottom="8dp"
              android:gravity="center_vertical">

              <de.hdodenhof.circleimageview.CircleImageView
                  android:id="@+id/iv_owner"
                  android:layout_width="38dp"
                  android:layout_height="38dp"
                  android:src="@drawable/ic_person"/>

              <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:orientation="vertical"
                  android:layout_marginStart="10dp">

                  <LinearLayout
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:orientation="horizontal"
                      android:gravity="center_vertical">

                      <TextView
                          android:id="@+id/tv_owner"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:textColor="@color/white"
                          android:textStyle="bold"
                          android:textSize="15sp"
                          android:shadowColor="@color/black"
                          android:shadowRadius="2"
                          android:shadowDx="0"
                          android:shadowDy="1"/>

                      <ImageView
                          android:id="@+id/iv_owner_verified"
                          android:layout_width="14dp"
                          android:layout_height="14dp"
                          android:layout_marginStart="4dp"
                          android:src="@drawable/ic_verified_pink"
                          android:visibility="gone"
                          android:contentDescription="Verified"/>

                      <TextView
                          android:id="@+id/tv_timestamp"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:layout_marginStart="8dp"
                          android:textColor="#CCFFFFFF"
                          android:textSize="13sp"/>
                  </LinearLayout>

                  <!-- NEW: audio-name ticker, directly below the owner name —
                       shown only when this status has a music sticker attached.
                       Reuses core's MusicTickerView, the exact same component
                       (and continuous-scroll animation) already used by the
                       reel player's bio song row (ll_bio_song_row /
                       tv_bio_song_name in fragment_reel_player.xml) — no
                       duplicate ticker implementation. -->
                  <LinearLayout
                      android:id="@+id/ll_status_song_row"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_marginTop="2dp"
                      android:orientation="horizontal"
                      android:gravity="center_vertical"
                      android:visibility="gone">

                      <ImageView
                          android:layout_width="11dp"
                          android:layout_height="11dp"
                          android:src="@drawable/ic_music_note"
                          android:tint="@color/white"
                          android:contentDescription="Song"/>

                      <com.callx.app.views.MusicTickerView
                          android:id="@+id/tv_status_song_name"
                          android:layout_width="150dp"
                          android:layout_height="wrap_content"
                          android:layout_marginStart="4dp"/>
                  </LinearLayout>

                  <LinearLayout
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:orientation="horizontal"
                      android:gravity="center_vertical">

                      <!-- FIX: expiry label — was findViewWithTag, now proper ID -->
                      <TextView
                          android:id="@+id/tv_expiry_label"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:textColor="#AAFFFFFF"
                          android:textSize="11sp"
                          android:visibility="gone"/>

                  </LinearLayout>

              </LinearLayout>

              <!-- More options -->
              <ImageButton
                  android:id="@+id/btn_more"
                  android:layout_width="40dp"
                  android:layout_height="40dp"
                  android:src="@android:drawable/ic_menu_more"
                  android:tint="@color/white"
                  android:background="?attr/selectableItemBackgroundBorderless"/>

              <!-- Close -->
              <ImageButton
                  android:id="@+id/btn_close_status"
                  android:layout_width="40dp"
                  android:layout_height="40dp"
                  android:visibility="gone"
                  android:src="@drawable/ic_back"
                  android:tint="@color/white"
                  android:background="?attr/selectableItemBackgroundBorderless"/>

          </LinearLayout>

      </LinearLayout>

      <!-- Mute button (video only) -->
      <ImageButton
          android:id="@+id/btn_mute"
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:layout_gravity="end|top"
          android:layout_marginTop="72dp"
          android:layout_marginEnd="12dp"
          android:src="@drawable/ic_volume_on"
          android:tint="@color/white"
          android:background="@drawable/bg_circle_dark"
          android:padding="8dp"
          android:visibility="gone"
          android:contentDescription="Mute"/>

      <!-- Side action column: HIDDEN. Download / Forward / Stabilizer / Repost used to float
           over the photo (on top of the person's face). They now live in the "⋯" menu; these
           buttons stay in the tree only as click proxies (menu calls performClick()), so all
           existing listeners, permission checks and visibility rules keep working. -->
      <LinearLayout
          android:visibility="gone"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="end|top"
          android:layout_marginTop="124dp"
          android:layout_marginEnd="12dp"
          android:orientation="vertical">

          <ImageButton
              android:id="@+id/btn_download"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:src="@android:drawable/ic_menu_save"
              android:tint="@color/white"
              android:background="@drawable/bg_circle_dark"
              android:padding="8dp"
              android:contentDescription="Download"
              android:visibility="gone"/>

          <ImageButton
              android:id="@+id/btn_forward"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:layout_marginTop="8dp"
              android:src="@drawable/ic_arrow_right"
              android:tint="@color/white"
              android:background="@drawable/bg_circle_dark"
              android:padding="8dp"
              android:contentDescription="Forward"
              android:visibility="gone"/>

          <!-- Level-stabilizer on/off — global viewer preference, remembered
               across all stories. Icon reflects current on/off state. -->
          <ImageButton
              android:id="@+id/btn_stabilizer"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:layout_marginTop="8dp"
              android:src="@android:drawable/ic_menu_compass"
              android:tint="@color/white"
              android:background="@drawable/bg_circle_dark"
              android:padding="8dp"
              android:contentDescription="Stabilizer"/>

          <!-- Repost button — visible for viewers when owner allows sharing -->
          <ImageButton
              android:id="@+id/btn_repost"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:layout_marginTop="8dp"
              android:src="@drawable/ic_repost"
              android:tint="@color/white"
              android:background="@drawable/bg_circle_dark"
              android:padding="8dp"
              android:contentDescription="Repost to my status"
              android:visibility="gone"/>

      </LinearLayout>

      <!-- Bottom chrome -->
      <LinearLayout
          android:id="@+id/ll_bottom_chrome"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_gravity="bottom"
          android:orientation="vertical"
          android:background="@drawable/bg_status_reply_overlay"
          android:paddingTop="32dp"
          android:paddingBottom="14dp"
          android:paddingStart="14dp"
          android:paddingEnd="14dp">

          <!-- FIX: Location tag — was findViewWithTag("tv_location_tag"), now proper ID -->
          <TextView
              android:id="@+id/tv_location_tag"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:textColor="#EEFFFFFF"
              android:textSize="13sp"
              android:paddingBottom="4dp"
              android:drawablePadding="4dp"
              android:visibility="gone"/>

          <!-- Caption -->
          <TextView
              android:id="@+id/tv_caption"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:textColor="@color/white"
              android:textSize="17sp"
              android:lineSpacingMultiplier="1.1"
              android:paddingBottom="10dp"
              android:shadowColor="#CC000000"
              android:shadowRadius="6"
              android:shadowDx="0"
              android:shadowDy="1"
              android:visibility="gone"/>

          <!-- Seen-by info (owner only) -->
          <TextView
              android:id="@+id/tv_seen_by"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:textColor="#CCFFFFFF"
              android:textSize="13sp"
              android:paddingBottom="8dp"
              android:drawablePadding="4dp"
              android:clickable="true"
              android:focusable="true"
              android:background="?attr/selectableItemBackground"
              android:visibility="gone"/>

          <!-- Latest-replies overlay (shown to every viewer, owner included) — Instagram-style: shows up to the
               last 3 commenters' avatars STACKED (overlapping, newest on top) plus
               the most recent comment's text, bottom-left on the story itself, so
               the owner sees it at a glance instead of having to open the chat DM.
               Populated/shown by StatusViewerActivity#updateLastReplyOverlay(); auto
               fades out a few seconds after showing (tap re-opens it early); tapping
               opens StatusRepliesBottomSheet with the full comment list. -->
          <LinearLayout
              android:id="@+id/ll_last_reply_bubble"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_gravity="start"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:paddingStart="6dp"
              android:paddingEnd="12dp"
              android:paddingTop="6dp"
              android:paddingBottom="6dp"
              android:layout_marginBottom="8dp"
              android:background="@drawable/bg_status_reply_overlay"
              android:clickable="true"
              android:focusable="true"
              android:visibility="gone">

              <!-- Stack: each avatar overlaps the previous by 12dp (negative start
                   margin) with a border so they read as a distinct stack, exactly
                   like Instagram's "recent repliers" cluster. Index 1 = oldest of
                   the 3 (drawn first, bottom of stack), 3 = newest (drawn last, on
                   top) — see bindLastReplyBubble() for the ordering. -->
              <FrameLayout
                  android:layout_width="wrap_content"
                  android:layout_height="26dp">

                  <de.hdodenhof.circleimageview.CircleImageView
                      android:id="@+id/iv_last_reply_avatar_1"
                      android:layout_width="24dp"
                      android:layout_height="24dp"
                      android:layout_marginStart="0dp"
                      android:src="@drawable/ic_person"
                      app:civ_border_width="1dp"
                      app:civ_border_color="@color/white"
                      android:visibility="gone"/>

                  <de.hdodenhof.circleimageview.CircleImageView
                      android:id="@+id/iv_last_reply_avatar_2"
                      android:layout_width="24dp"
                      android:layout_height="24dp"
                      android:layout_marginStart="14dp"
                      android:src="@drawable/ic_person"
                      app:civ_border_width="1dp"
                      app:civ_border_color="@color/white"
                      android:visibility="gone"/>

                  <de.hdodenhof.circleimageview.CircleImageView
                      android:id="@+id/iv_last_reply_avatar_3"
                      android:layout_width="24dp"
                      android:layout_height="24dp"
                      android:layout_marginStart="28dp"
                      android:src="@drawable/ic_person"
                      app:civ_border_width="1dp"
                      app:civ_border_color="@color/white"
                      android:visibility="gone"/>

              </FrameLayout>

              <TextView
                  android:id="@+id/tv_last_reply_text"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="8dp"
                  android:maxWidth="220dp"
                  android:maxLines="1"
                  android:ellipsize="end"
                  android:textColor="@color/white"
                  android:textSize="13sp"/>

          </LinearLayout>


      </LinearLayout>
      </FrameLayout><!-- /fl_story_card -->

      <!-- Reply bar: solid strip UNDER the card (no longer an overlay on the photo) -->
      <LinearLayout
          android:id="@+id/ll_reply_bar"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingTop="8dp"
          android:paddingBottom="12dp"
          android:paddingStart="12dp"
          android:paddingEnd="12dp">

          <!-- Reaction + reply row -->
          <LinearLayout
              android:id="@+id/ll_reply_row"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical">

              <!-- Instagram-style pill: fixed "Send message" hint (no floating label),
                   thin translucent outline, transparent fill. Tapping it opens the reply
                   sheet (see setupReplyButton). -->
              <EditText
                  android:id="@+id/et_reply"
                  android:layout_width="0dp"
                  android:layout_height="44dp"
                  android:layout_weight="1"
                  android:background="@drawable/bg_status_reply_pill"
                  android:hint="@string/status_reply_hint"
                  android:textColorHint="#B3FFFFFF"
                  android:textColor="@color/white"
                  android:textSize="15sp"
                  android:gravity="center_vertical"
                  android:paddingStart="18dp"
                  android:paddingEnd="18dp"
                  android:maxLines="1"
                  android:inputType="textCapSentences"
                  android:importantForAutofill="no"/>


              <!-- Hidden proxy (Instagram has no separate react button): the heart's
                   long-press and the swipe-up picker open the full emoji sheet via this. -->
              <ImageButton
                  android:id="@+id/btn_react"
                  android:visibility="gone"
                  android:layout_width="44dp"
                  android:layout_height="44dp"
                  android:layout_marginStart="8dp"
                  android:src="@drawable/ic_status_react"
                  android:padding="9dp"
                  android:tint="@color/white"
                  android:background="?attr/selectableItemBackgroundBorderless"
                  android:contentDescription="@string/status_react_desc"/>

              <!-- WhatsApp-style quick-like: single tap sends a ❤️ reaction
                   immediately (no picker); tap again to remove it. Long-press
                   still opens the full emoji picker via btn_react above. -->
              <ImageButton
                  android:id="@+id/btn_like_heart"
                  android:layout_width="44dp"
                  android:layout_height="44dp"
                  android:layout_marginStart="6dp"
                  android:padding="9dp"
                  android:src="@drawable/ic_heart"
                  android:background="?attr/selectableItemBackgroundBorderless"
                  android:contentDescription="Like status"/>

              <ImageButton
                  android:id="@+id/btn_send_reply"
                  android:layout_width="44dp"
                  android:layout_height="44dp"
                  android:layout_marginStart="4dp"
                  android:src="@drawable/ic_status_share"
                  android:padding="9dp"
                  android:tint="@color/white"
                  android:background="?attr/selectableItemBackgroundBorderless"
                  android:contentDescription="@string/status_share_desc"/>

          </LinearLayout>

      </LinearLayout>
      </LinearLayout><!-- /ll_viewer_column -->

      <!-- v507: swipe-up-to-react overlay is a ViewStub now — inflated on first swipe-up
           (StatusViewerActivity#ensureQuickReactionOverlay()). See view_status_quick_reaction.xml. -->
      <ViewStub
          android:id="@+id/stub_quick_reaction"
          android:inflatedId="@+id/fl_quick_reaction_overlay"
          android:layout="@layout/view_status_quick_reaction"
          android:layout_width="match_parent"
          android:layout_height="match_parent"/>

  </FrameLayout>