<?xml version="1.0" encoding="utf-8"?>
<!-- v508: inflated lazily via ViewStub (stub_last_reply_bubble) only when a status actually has replies.
     layout_gravity / marginBottom live on the stub (stub LayoutParams win). Populated by
     StatusViewerActivity#bindLastReplyBubble(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_last_reply_bubble"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="6dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/bg_status_reply_overlay"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <!-- Stack: each avatar overlaps the previous by 12dp (negative start
         margin) with a border so they read as a distinct stack, exactly
         like Instagram's "recent repliers" cluster. Index 1 = oldest of
         the 3 (drawn first, bottom of stack), 3 = newest (drawn last, on
         top) — see bindLastReplyBubble() for the ordering. -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="26dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_last_reply_avatar_1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="0dp"
            android:src="@drawable/ic_person"
            app:civ_border_width="1dp"
            app:civ_border_color="@color/white"
            android:visibility="gone"/>

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_last_reply_avatar_2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="14dp"
            android:src="@drawable/ic_person"
            app:civ_border_width="1dp"
            app:civ_border_color="@color/white"
            android:visibility="gone"/>

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_last_reply_avatar_3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="28dp"
            android:src="@drawable/ic_person"
            app:civ_border_width="1dp"
            app:civ_border_color="@color/white"
            android:visibility="gone"/>

    </FrameLayout>

    <TextView
        android:id="@+id/tv_last_reply_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxWidth="220dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/white"
        android:textSize="13sp"/>

</LinearLayout>
