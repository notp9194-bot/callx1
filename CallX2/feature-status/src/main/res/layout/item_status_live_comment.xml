<?xml version="1.0" encoding="utf-8"?>
<!-- v576: One floating "live comment" (Instagram-style): small 20dp avatar + bold name + comment text,
     NO background. Readability comes from the text shadow + the bottom gradient of ll_bottom_chrome.
     Shown one at a time (zoom in -> ~2s -> zoom out) by StatusViewerActivity#addLiveRow()/removeLiveRow(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:clickable="true"
    android:focusable="false"
    android:importantForAccessibility="no">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/iv_live_avatar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_person"/>

    <TextView
        android:id="@+id/tv_live_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxWidth="260dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:shadowColor="#B3000000"
        android:shadowRadius="4"
        android:shadowDx="0"
        android:shadowDy="1"/>

</LinearLayout>
