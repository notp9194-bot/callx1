<?xml version="1.0" encoding="utf-8"?>
<!-- One floating "live comment" row (Instagram-style): avatar + bold name + comment text in a dark pill.
     Created by StatusViewerActivity#buildLiveRow() and stacked inside ll_live_comments. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="6dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/bg_status_reply_pill"
    android:clickable="true"
    android:focusable="false"
    android:importantForAccessibility="no">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/iv_live_avatar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_person"/>

    <TextView
        android:id="@+id/tv_live_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxWidth="260dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/white"
        android:textSize="13sp"/>

</LinearLayout>
