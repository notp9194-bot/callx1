<?xml version="1.0" encoding="utf-8"?>
<!-- Loading placeholder, same outer box/margins as item_status_card.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/status_card_width"
    android:layout_height="@dimen/status_card_height"
    android:layout_marginStart="0dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_status_card_skeleton"/>

    <View
        android:layout_width="@dimen/status_card_avatar_ring"
        android:layout_height="@dimen/status_card_avatar_ring"
        android:layout_gravity="top|start"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_status_card_skeleton_avatar"/>

    <View
        android:layout_width="64dp"
        android:layout_height="9dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_status_card_skeleton_bar"/>
</FrameLayout>
