<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/status_card_width"
    android:layout_height="@dimen/status_card_height"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="10dp">

    <!-- Card body: status image + vignette + gradient scrim + name, thin premium border -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/status_card_avatar_overlap"
        app:cardCornerRadius="18dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/status_card_body_bg"
        app:strokeWidth="1dp"
        app:strokeColor="@color/status_card_stroke"
        app:rippleColor="@color/status_card_ripple"
        android:foreground="?attr/selectableItemBackground">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/iv_card_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/status_card_placeholder"/>

            <!-- Soft top vignette for depth -->
            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_gravity="top"
                android:background="@drawable/bg_status_card_top_scrim"/>

            <!-- Bottom scrim so the name stays readable on bright photos -->
            <View
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_status_card_bottom_scrim"/>

            <!-- Hairline inner edge highlight — gives the glass/premium finish -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_status_card_inner_stroke"/>

            <!-- Text-status preview (shown only on text cards) -->
            <TextView
                android:id="@+id/tv_card_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="30dp"
                android:paddingBottom="38dp"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="5"
                android:ellipsize="end"
                android:visibility="gone"/>

            <!-- Video badge -->
            <ImageView
                android:id="@+id/iv_card_type"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:padding="3dp"
                android:src="@drawable/ic_status_card_play"
                android:background="@drawable/bg_status_card_type_badge"
                android:visibility="gone"/>

            <!-- Muted badge (top-start, mirrors the video badge) -->
            <ImageView
                android:id="@+id/iv_card_muted"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|start"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:padding="3dp"
                android:src="@drawable/ic_status_card_muted"
                android:background="@drawable/bg_status_card_type_badge"
                android:visibility="gone"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingHorizontal="9dp"
                android:paddingBottom="9dp"
                android:paddingTop="4dp">

                <TextView
                    android:id="@+id/tv_card_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:shadowColor="#CC000000"
                    android:shadowRadius="5"
                    android:letterSpacing="0.01"
                    tools:text="Name"/>

                <!-- "5m ago" / "2h ago" — hidden when there is no timestamp -->
                <TextView
                    android:id="@+id/tv_card_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="#D9FFFFFF"
                    android:textSize="10.5sp"
                    android:maxLines="1"
                    android:shadowColor="#CC000000"
                    android:shadowRadius="4"
                    android:visibility="gone"/>
            </LinearLayout>

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Avatar + ring, overlapping the top edge of the card.
         background = transparent oval so the elevation shadow (if any) follows
         the round shape instead of defaulting to a rectangle; elevation (4dp) is set
         higher than the card's 3dp so this always draws in front of it. -->
    <FrameLayout
        android:id="@+id/fl_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal|top"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/ring"
            android:layout_width="48dp"
            android:layout_height="48dp"/>

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_card_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_person"/>

        <!-- Add (+) badge, shown only on own "add status" tile.
             Its own tap target is small (17dp), but fl_avatar (48dp, below)
             now shares the same "always add" click behaviour, so tapping
             anywhere on the avatar/badge corner reliably starts a new status. -->
        <ImageView
            android:id="@+id/iv_card_add"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="bottom|end"
            android:src="@android:drawable/ic_input_add"
            android:tint="@android:color/white"
            android:padding="2dp"
            android:background="@drawable/bg_status_card_add_badge"
            android:visibility="gone"/>

        <!-- Close-friends star badge (contacts only) -->
        <ImageView
            android:id="@+id/iv_card_cf"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="bottom|end"
            android:padding="3dp"
            android:src="@drawable/ic_status_card_cf_star"
            android:background="@drawable/bg_status_card_cf_badge"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- ── Stub views referenced by StoryReshareActivity (visibility=gone) ── -->
    <ImageView android:id="@+id/iv_status_thumb"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/tv_status_owner_name"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/tv_status_type_badge"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

</FrameLayout>
