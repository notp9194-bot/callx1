<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/status_card_width"
    android:layout_height="@dimen/status_card_height"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp">

    <!-- Card body (v554): plain FrameLayout + rounded bg + clipToOutline instead of MaterialCardView
         with a nested FrameLayout — fewer views to inflate/measure/draw. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_status_card_body"
        android:clipToOutline="true"
        android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/iv_card_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/status_card_placeholder"/>

            <!-- Top vignette + bottom name scrim, merged into one layer-list view -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_status_card_overlay"/>

            <!-- Text-status preview (shown only on text cards) -->
            <TextView
                android:id="@+id/tv_card_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="56dp"
                android:paddingBottom="38dp"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="5"
                android:ellipsize="end"
                android:visibility="gone"/>

            <!-- Video badge -->
            <ImageView
                android:id="@+id/iv_card_type"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:padding="3dp"
                android:src="@drawable/ic_status_card_play"
                android:background="@drawable/bg_status_card_type_badge"
                android:visibility="gone"/>

            <!-- Muted badge (top-end; bound code shifts it 26dp down via translationY only when the video badge is shown) -->
            <ImageView
                android:id="@+id/iv_card_muted"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:padding="3dp"
                android:src="@drawable/ic_status_card_muted"
                android:background="@drawable/bg_status_card_type_badge"
                android:visibility="gone"/>

            <!-- "Add status" tile: big + circle (shown only on my card when I have no status yet) -->
            <ImageView
                android:id="@+id/iv_card_add_big"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="44dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_input_add"
                android:tint="@android:color/white"
                android:background="@drawable/bg_status_card_add_badge"
                android:visibility="gone"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingHorizontal="9dp"
                android:paddingBottom="9dp"
                android:paddingTop="4dp">

                <TextView
                    android:id="@+id/tv_card_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:letterSpacing="0.01"
                    tools:text="Name"/>

                <!-- "5m ago" / "2h ago" — hidden when there is no timestamp -->
                <TextView
                    android:id="@+id/tv_card_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="#F2FFFFFF"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:visibility="gone"/>
            </LinearLayout>

    </FrameLayout>

    <!-- Avatar + ring INSIDE the card, top-start (v556). Ring 1.5dp, 2dp transparent gap, avatar = ring - 7dp.
         No separate elevation layer: it draws above the card body simply by being later in the FrameLayout. -->
    <FrameLayout
        android:id="@+id/fl_avatar"
        android:layout_width="@dimen/status_card_avatar_ring"
        android:layout_height="@dimen/status_card_avatar_ring"
        android:layout_gravity="top|start"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp">

        <ImageView
            android:id="@+id/ring"
            android:layout_width="@dimen/status_card_avatar_ring"
            android:layout_height="@dimen/status_card_avatar_ring"/>

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_card_avatar"
            android:layout_width="@dimen/status_card_avatar"
            android:layout_height="@dimen/status_card_avatar"
            android:layout_gravity="center"
            android:src="@drawable/ic_person"/>

        <!-- Add (+) badge, shown only on own "add status" tile.
             Its own tap target is small (17dp), but fl_avatar (48dp, below)
             now shares the same "always add" click behaviour, so tapping
             anywhere on the avatar/badge corner reliably starts a new status. -->
        <ImageView
            android:id="@+id/iv_card_add"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom|end"
            android:src="@android:drawable/ic_input_add"
            android:tint="@android:color/white"
            android:padding="2dp"
            android:background="@drawable/bg_status_card_add_badge"
            android:visibility="gone"/>

        <!-- Close-friends star badge (contacts only) -->
        <ImageView
            android:id="@+id/iv_card_cf"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom|end"
            android:padding="3dp"
            android:src="@drawable/ic_status_card_cf_star"
            android:background="@drawable/bg_status_card_cf_badge"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- ── Stub views referenced by StoryReshareActivity (visibility=gone) ── -->
    <ImageView android:id="@+id/iv_status_thumb"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/tv_status_owner_name"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/tv_status_type_badge"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

</FrameLayout>
