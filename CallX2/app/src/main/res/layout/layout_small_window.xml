<?xml version="1.0" encoding="utf-8"?>
<!--
    layout_small_window.xml
    Floating small window — full mini-chat: live message list + send box,
    draggable + resizable-feel overlay. Not just a preview anymore.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="400dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="#1C1C1E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── Top drag-bar ─────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/ll_sw_dragbar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:background="#2C2C2E">

            <ImageView
                android:id="@+id/iv_sw_avatar_small"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person"
                android:background="@drawable/circle_avatar_bg"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <TextView
                    android:id="@+id/tv_sw_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact Name"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tv_sw_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online"
                    android:textColor="#8E8E93"
                    android:textSize="10sp"
                    android:maxLines="1"/>
            </LinearLayout>

            <!-- Expand → open full ChatActivity -->
            <ImageButton
                android:id="@+id/btn_sw_expand"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_picture_in_picture"
                android:tint="#AEAEB2"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Open full chat"/>

            <!-- Minimize button -->
            <ImageButton
                android:id="@+id/btn_sw_minimize"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_pause"
                android:tint="#AEAEB2"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Minimize"/>

            <!-- Close button -->
            <ImageButton
                android:id="@+id/btn_sw_close"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_close"
                android:tint="#FF453A"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"/>

        </LinearLayout>

        <!-- ── Message list — real, live chat content ──────────────────────── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_call_dark_scrim"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_sw_messages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"/>

            <!-- Empty-state — shown only while there are no messages yet -->
            <LinearLayout
                android:id="@+id/ll_sw_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_sw_avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_person"
                    android:scaleType="centerCrop"
                    android:background="@drawable/circle_avatar_bg"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No messages yet"
                    android:textColor="#8E8E93"
                    android:textSize="11sp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

        </FrameLayout>

        <!-- ── Send box — type + send, real message, not just preview ──────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2C2C2E"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:paddingVertical="4dp">

            <EditText
                android:id="@+id/et_sw_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_sw_input"
                android:hint="Message"
                android:textColorHint="#8E8E93"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:minHeight="36dp"
                android:maxLines="3"
                android:inputType="textCapSentences|textMultiLine"
                android:imeOptions="actionSend"/>

            <ImageButton
                android:id="@+id/btn_sw_send"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_forward"
                android:tint="#0A84FF"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Send"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
