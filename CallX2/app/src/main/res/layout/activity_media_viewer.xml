<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Image viewer with pinch-to-zoom (single-media mode) -->
    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/iv_full"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:scaleType="fitCenter"/>

    <!-- Video player (single-media mode).
         surface_type=texture_view (instead of the default SurfaceView) —
         REQUIRED for the Telegram-style dock animation: a SurfaceView's
         video content is composited by the system straight to the window,
         bypassing the normal view-canvas pipeline, so View.setScaleX/Y,
         setAlpha, and — critically — setClipToOutline's rounded-corner
         clip would NOT visually apply to it during the swipe/dock
         animation (square corners would poke through). TextureView draws
         through the ordinary canvas pipeline, so it fully respects all of
         those transforms. Slightly more power/perf cost than SurfaceView,
         acceptable for a foreground full-screen video viewer. -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:surface_type="texture_view"/>

    <!-- Swipeable gallery (multi-media / grouped messages mode) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/media_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

    <!-- "2 / 5" page counter — only shown in gallery mode -->
    <TextView
        android:id="@+id/tv_page_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="76dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="#99000000"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:visibility="gone"
        android:contentDescription="Page position"/>

    <!-- Loading spinner -->
    <ProgressBar
        android:id="@+id/pb_loading"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/white"
        android:visibility="gone"
        android:contentDescription="Loading"/>

    <!-- Top bar — tap image to toggle visibility.
         No more full-width background strip here — see bg_media_viewer_toolbtn
         doc: each button below now carries its own small semi-transparent
         circle instead, matching the media EDITING screen's toolbar look. -->
    <LinearLayout
        android:id="@+id/ll_top_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_gravity="top">

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back"
            android:tint="@color/white"
            android:scaleType="center"
            android:padding="10dp"
            android:background="@drawable/bg_media_viewer_toolbtn"
            android:contentDescription="Back"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/btn_edit"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_edit"
            android:tint="@color/white"
            android:scaleType="center"
            android:padding="10dp"
            android:background="@drawable/bg_media_viewer_toolbtn"
            android:contentDescription="Edit"/>

        <ImageButton
            android:id="@+id/btn_save"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:src="@android:drawable/ic_menu_save"
            android:tint="@color/white"
            android:scaleType="center"
            android:padding="10dp"
            android:background="@drawable/bg_media_viewer_toolbtn"
            android:contentDescription="Save to gallery"/>

        <ImageButton
            android:id="@+id/btn_share"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_share_reel"
            android:tint="@color/white"
            android:scaleType="center"
            android:padding="10dp"
            android:background="@drawable/bg_media_viewer_toolbtn"
            android:contentDescription="Share"/>

        <ImageButton
            android:id="@+id/btn_more_options"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_info"
            android:tint="@color/white"
            android:scaleType="center"
            android:padding="10dp"
            android:background="@drawable/bg_media_viewer_toolbtn"
            android:contentDescription="More options"/>
    </LinearLayout>

    <!-- #1 fix — selection-mode toolbar: shown instead of ll_top_bar while
         the user has long-pressed into multi-select mode inside the gallery.
         Lets them forward/delete/star several images/videos from the group
         together, instead of only ever acting on one at a time. -->
    <LinearLayout
        android:id="@+id/ll_select_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_gravity="top"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_select_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back"
            android:tint="@color/white"
            android:scaleType="center"
            android:padding="10dp"
            android:background="@drawable/bg_media_viewer_toolbtn"
            android:contentDescription="Cancel selection"/>

        <TextView
            android:id="@+id/tv_select_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:text="1 selected"/>

        <ImageButton
            android:id="@+id/btn_select_star"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:src="@android:drawable/btn_star_big_off"
            android:tint="@color/white"
            android:scaleType="center"
            android:padding="10dp"
            android:background="@drawable/bg_media_viewer_toolbtn"
            android:contentDescription="Star selected"/>

        <ImageButton
            android:id="@+id/btn_select_delete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="@color/white"
            android:scaleType="center"
            android:padding="10dp"
            android:background="@drawable/bg_media_viewer_toolbtn"
            android:contentDescription="Delete selected"/>

        <ImageButton
            android:id="@+id/btn_select_forward"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_send"
            android:tint="@color/white"
            android:scaleType="center"
            android:padding="10dp"
            android:background="@drawable/bg_media_viewer_toolbtn"
            android:contentDescription="Forward selected"/>
    </LinearLayout>

</FrameLayout>
