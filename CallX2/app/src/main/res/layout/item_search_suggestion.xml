<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="12dp">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/iv_suggestion_avatar"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@color/surface_input"
        android:src="@drawable/ic_person"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/iv_suggestion_kind"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_search_field"
        android:contentDescription="Search type"
        android:padding="12dp"
        android:src="@drawable/ic_history"
        android:tint="?attr/colorOnSurface" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_suggestion_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_suggestion_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_remove_search"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Remove recent search"
        android:src="@drawable/ic_close"
        android:tint="?attr/colorOnSurface"
        android:visibility="gone" />
</LinearLayout>