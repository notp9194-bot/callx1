<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="4dp">

        <!-- ══ Voice-note mini player ═════════════════════════════════════
             WhatsApp-style green strip that appears above the toolbar the
             moment a voice note is still playing (or paused-but-active)
             after the user has left the chat screen it was played from.
             Driven entirely by GlobalVoicePlaybackManager — see
             MainActivity#updateVoiceMiniPlayer(). Gone by default. -->
        <!-- v949: ViewStub — inflated by MainActivity.ensureMiniPlayer() only when a voice note is active. -->
        <ViewStub
            android:id="@+id/stub_voice_mini_player"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:inflatedId="@+id/banner_voice_mini_player"
            android:layout="@layout/layout_voice_mini_player"/>

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/transparent"
            app:title="CallX"
            app:titleTextColor="?attr/colorOnSurface">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="8dp">

                <ImageButton
                    android:id="@+id/btn_search_toolbar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_search"
                    android:tint="?attr/colorOnSurface"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Search"/>

                <!-- Notification bell with badge -->
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp">

                    <ImageButton
                        android:id="@+id/btn_notifications_toolbar"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_notifications"
                        android:tint="?attr/colorOnSurface"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Notifications"/>

                    <TextView
                        android:id="@+id/tv_notif_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:minWidth="16dp"
                        android:minHeight="16dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:gravity="center"
                        android:background="@drawable/bg_unread_badge"
                        android:visibility="gone"/>
                </FrameLayout>

                <!-- v244: avatar removed — tap-to-open-Settings moved to the
                     3-dot overflow menu (action_settings, see MainActivity). -->
            </LinearLayout>

            <!-- v241: old toolbar X / YouTube / Games entry strips removed —
                 replaced by the card-style quick-access row on the Chats tab. -->
        </androidx.appcompat.widget.Toolbar>

        <!-- ══ Feature 1: Return to Call Banner ══════════════════════════════
             WhatsApp-style green strip jo tab dikhta hai jab call chal rahi ho
             aur user doosri screen pe chala gaya ho.
             Tap karo → CallActivity wapas khul jaata hai.
             Gone by default — onResume() mein show/hide hota hai.
        ════════════════════════════════════════════════════════════════════ -->
        <!-- v949: ViewStub — inflated by MainActivity.ensureReturnBanner() only when a call is running. -->
        <ViewStub
            android:id="@+id/stub_return_to_call"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:inflatedId="@+id/banner_return_to_call"
            android:layout="@layout/layout_return_to_call_banner"/>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="58dp"/>

    <!-- Bottom nav -->
    <FrameLayout
        android:id="@+id/nav_container"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurface"
        android:elevation="8dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:layout_gravity="center"
            android:minWidth="260dp"
            android:maxWidth="380dp"
            android:background="@color/transparent"
            app:itemIconTint="@color/bottom_nav_item_color"
            app:itemTextColor="@color/bottom_nav_item_color"
            app:itemIconSize="22dp"
            app:menu="@menu/bottom_nav_menu"
            app:labelVisibilityMode="labeled"/>
    </FrameLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="72dp"
        android:src="@drawable/ic_status_add"
        android:contentDescription="Action"
        app:backgroundTint="@color/brand_primary"
        app:tint="@color/white"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
