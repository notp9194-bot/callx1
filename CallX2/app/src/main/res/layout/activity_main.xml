<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@color/transparent"
            app:contentInsetStart="16dp"
            app:contentInsetEnd="12dp"
            app:titleTextColor="@color/bar_on_background">

            <!-- Brand block: app icon + "CallX" + tagline (replaces plain app:title) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@mipmap/ic_launcher_round"
                    android:contentDescription="CallX"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CallX"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chat • Connect • Share"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Action icons: search, new chat, notifications, avatar -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btn_search_toolbar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/text_primary"
                    android:background="@drawable/bg_circle_white"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Search"/>

                <!-- New: quick "start new chat" entry point (same destination as the
                     Chats-tab FAB) — additive, doesn't replace any existing action. -->
                <ImageButton
                    android:id="@+id/btn_add_contact_toolbar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_person_add"
                    android:tint="@color/text_primary"
                    android:background="@drawable/bg_circle_white"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="New chat"/>

                <!-- Notification bell with badge -->
                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="10dp">

                    <ImageButton
                        android:id="@+id/btn_notifications_toolbar"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:padding="8dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_notifications"
                        android:tint="@color/text_primary"
                        android:background="@drawable/bg_circle_white"
                        android:contentDescription="Notifications"/>

                    <TextView
                        android:id="@+id/tv_notif_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:minWidth="16dp"
                        android:minHeight="16dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:gravity="center"
                        android:background="@drawable/bg_unread_badge"
                        android:visibility="gone"/>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/iv_avatar_menu"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_person"
                        app:civ_border_width="2dp"
                        app:civ_border_color="@color/brand_primary"/>

                    <View
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_online_dot"/>
                </FrameLayout>
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- ══ Modern quick-action row ═══════════════════════════════════════
             WhatsApp/Instagram-style story cards: Add story, then the existing
             X / YouTube / Games module entry points (same avatars, badges and
             slide-in animation logic as before — only their layouts were
             restyled into cards), plus a new "My status" shortcut.
        ════════════════════════════════════════════════════════════════════ -->
        <HorizontalScrollView
            android:id="@+id/hsv_quick_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:paddingTop="6dp"
            android:paddingBottom="10dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <!-- Add story -->
                <LinearLayout
                    android:id="@+id/card_add_story"
                    android:layout_width="76dp"
                    android:layout_height="94dp"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/bg_quickaction_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <View
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_add_story_dashed"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_status_add"
                            android:tint="@color/brand_primary"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Add story"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"/>
                </LinearLayout>

                <!-- X module entry — logic unchanged, view now rendered as a card -->
                <include
                    android:id="@+id/include_x_entry"
                    layout="@layout/layout_x_entry_button"/>

                <!-- YouTube module entry — logic unchanged, view now rendered as a card -->
                <include
                    android:id="@+id/include_yt_entry"
                    layout="@layout/layout_youtube_entry_button"/>

                <!-- My status -->
                <LinearLayout
                    android:id="@+id/card_my_status"
                    android:layout_width="76dp"
                    android:layout_height="94dp"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/bg_quickaction_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/iv_my_status_avatar"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:src="@drawable/ic_person"
                        app:civ_border_width="2.5dp"
                        app:civ_border_color="@color/brand_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="My status"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"/>
                </LinearLayout>

                <!-- Games module entry — logic unchanged, view now rendered as a card -->
                <include
                    android:id="@+id/include_games_entry"
                    layout="@layout/layout_games_entry_button"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- ══ Feature 1: Return to Call Banner ══════════════════════════════
             WhatsApp-style green strip jo tab dikhta hai jab call chal rahi ho
             aur user doosri screen pe chala gaya ho.
             Tap karo → CallActivity wapas khul jaata hai.
             Gone by default — onResume() mein show/hide hota hai.
        ════════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/banner_return_to_call"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#FF1FA855"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_phone"
                android:tint="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tv_return_to_call_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tap to return to call"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_return_to_call_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Return"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_unread_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="184dp"
        android:layout_marginBottom="58dp"/>

    <!-- Bottom nav -->
    <FrameLayout
        android:id="@+id/nav_container"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurface"
        android:elevation="8dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:layout_gravity="center"
            android:minWidth="260dp"
            android:maxWidth="380dp"
            android:background="@color/transparent"
            app:itemIconTint="@color/brand_primary"
            app:itemTextColor="@color/brand_primary"
            app:itemIconSize="22dp"
            app:menu="@menu/bottom_nav_menu"
            app:labelVisibilityMode="labeled"/>
    </FrameLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="72dp"
        android:src="@drawable/ic_status_add"
        android:contentDescription="Action"
        app:backgroundTint="@color/brand_primary"
        app:tint="@color/white"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
