<?xml version="1.0" encoding="utf-8"?>
<!--
    bottom_nav_item_color.xml — v246 (fix)

    v245 used flat @color/white for the unselected state — invisible in
    light mode since the bottom nav's own background is ?attr/colorSurface,
    which resolves to @color/white in the light theme (see themes.xml).
    White-on-white = inactive tabs disappear.

    Fix: @color/text_secondary instead — it's already a theme-aware pair
    (dark gray in values/colors.xml for light mode, light gray in
    values-night/colors.xml for dark mode), the same resource used
    elsewhere in the app for secondary/muted text. Visible against the
    surface color in both themes, exactly the WhatsApp look: active tab
    green, inactive tabs a muted gray that adapts to light/dark.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/brand_primary"  android:state_checked="true"/>
    <item android:color="@color/text_secondary" android:state_checked="false"/>
</selector>
