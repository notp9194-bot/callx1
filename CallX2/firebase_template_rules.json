{
  "_comment": "v743: merge these into the top-level \"rules\" object (already merged in firebase_security_rules_UPDATED_audio_v4_statusviewers_template.json). (1) statusTemplateUses = 'N used' counter. (2) status/$uid/$statusId and messages/$chatId/$msgId gain size validators for templateJson / templateFromUid / templateFromId / templateFromName (+ templateStickersJson on messages).",
  "rules": {
    "statusTemplateUses": {
      "_comment": "v742: statusTemplateUses/{templateOwnerUid}/{statusId}/{userUid} = server timestamp, written once by the user who made a status from that template (drives 'N used'). Only a live template (has templateJson, not deleted) can be used, never by its owner, never by someone the owner blocked, and a row can't be rewritten. The owner may wipe the whole counter (status deleted).",
      "$ownerUid": {
        "$statusId": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $ownerUid && !newData.exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() <= now + 5000 && $uid != $ownerUid && !data.exists() && root.child('blocks').child($ownerUid).child(auth.uid).val() != true && root.child('status').child($ownerUid).child($statusId).child('templateJson').exists() && root.child('status').child($ownerUid).child($statusId).child('deleted').val() != true)"
          }
        }
      }
    }
  },
  "status_child_validators": {
    "templateJson": {
      ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 60000)"
    },
    "templateFromUid": {
      ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)"
    },
    "templateFromId": {
      ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)"
    },
    "templateFromName": {
      ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)"
    }
  },
  "messages_child_validators": {
    "templateJson": {
      ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 60000)"
    },
    "templateStickersJson": {
      ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 60000)"
    },
    "templateFromUid": {
      ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)"
    },
    "templateFromId": {
      ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)"
    },
    "templateFromName": {
      ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)"
    }
  }
}