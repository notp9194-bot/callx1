<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/vr_bg_sheet"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/vr_bg_handle"/>

    <TextView
        android:id="@+id/vr_more_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp"
        android:textColor="@color/vr_text"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <LinearLayout
        android:id="@+id/vr_more_people"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
        android:importantForAccessibility="no"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/vr_bg_circle_soft"
            android:padding="10dp"
            android:src="@drawable/ic_group"
            app:tint="@color/vr_primary"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/vr_people_in_this_room"
            android:textColor="@color/vr_text"
            android:textSize="16sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/vr_more_share"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
        android:importantForAccessibility="no"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/vr_bg_circle_soft"
            android:padding="10dp"
            android:src="@drawable/ic_share_reel"
            app:tint="@color/vr_primary"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/vr_share_room_link"
            android:textColor="@color/vr_text"
            android:textSize="16sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/vr_more_mute"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
        android:importantForAccessibility="no"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/vr_bg_circle_soft"
            android:padding="10dp"
            android:src="@drawable/ic_volume_off"
            app:tint="@color/vr_primary"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/vr_mute_room_audio"
            android:textColor="@color/vr_text"
            android:textSize="16sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/vr_more_role"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/vr_bg_circle_soft"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_person"
            app:tint="@color/vr_primary"/>

        <TextView
            android:id="@+id/vr_more_role_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:textColor="@color/vr_text"
            android:textSize="16sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/vr_more_leave"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
        android:importantForAccessibility="no"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/vr_bg_circle_soft"
            android:padding="10dp"
            android:src="@drawable/ic_logout"
            app:tint="@color/vr_danger"/>

        <TextView
            android:id="@+id/vr_more_leave_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/vr_leave_quietly"
            android:textColor="@color/vr_danger"
            android:textSize="16sp"/>
    </LinearLayout>
</LinearLayout>
