<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/vr_bg_sheet"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/vr_bg_handle"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:text="Start a poll"
        android:textColor="@color/vr_text"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/vr_poll_question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/vr_bg_edit"
        android:hint="Ask a question"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="3"
        android:minHeight="52dp"
        android:padding="14dp"
        android:textColor="@color/vr_text"
        android:textColorHint="@color/vr_text_sub"
        android:textSize="16sp"/>

    <LinearLayout
        android:id="@+id/vr_poll_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>

    <TextView
        android:id="@+id/vr_poll_add_option"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="sans-serif-medium"
        android:padding="8dp"
        android:text="+ Add option"
        android:textColor="@color/vr_primary"
        android:textSize="15sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="20dp"
        android:text="Duration"
        android:textColor="@color/vr_text_sub"
        android:textSize="13sp"/>

    <LinearLayout
        android:id="@+id/vr_poll_durations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"/>

    <TextView
        android:id="@+id/vr_poll_start"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/vr_bg_btn_primary"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="Start poll"
        android:textColor="@color/vr_white"
        android:textSize="16sp"/>
</LinearLayout>
