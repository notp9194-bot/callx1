<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/vr_bg_sheet"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/vr_bg_handle"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:text="@string/vr_start_a_room"
        android:textColor="@color/vr_text"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/vr_create_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/vr_bg_edit"
        android:hint="@string/vr_room_name"
        android:inputType="textCapSentences"
        android:maxLength="40"
        android:maxLines="1"
        android:minHeight="52dp"
        android:padding="14dp"
        android:textColor="@color/vr_text"
        android:textColorHint="@color/vr_text_sub"
        android:textSize="16sp"/>

    <EditText
        android:id="@+id/vr_create_topic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/vr_bg_edit"
        android:hint="@string/vr_what_will_you_talk"
        android:inputType="textCapSentences"
        android:maxLength="60"
        android:maxLines="1"
        android:minHeight="52dp"
        android:padding="14dp"
        android:textColor="@color/vr_text"
        android:textColorHint="@color/vr_text_sub"
        android:textSize="16sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:text="@string/vr_category"
        android:textColor="@color/vr_text_sub"
        android:textSize="13sp"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/vr_create_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"/>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vr_anyone_can_request_to"
            android:textColor="@color/vr_text"
            android:textSize="16sp"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/vr_create_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"/>
    </LinearLayout>

    <TextView
        android:id="@+id/vr_create_start"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/vr_bg_btn_primary"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/vr_go_live"
        android:textColor="@color/vr_white"
        android:textSize="16sp"/>
</LinearLayout>
