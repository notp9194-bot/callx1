<?xml version="1.0" encoding="utf-8"?>
<!-- Host: speaker request row (Accept / Decline) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/vr_rq_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/vr_rq_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/vr_text"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vr_wants_to_speak"
            android:textColor="@color/vr_text_sub"
            android:textSize="13sp"/>
    </LinearLayout>

    <ImageView
        android:contentDescription="@string/vr_decline_request"
        android:id="@+id/vr_rq_decline"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/vr_bg_circle_soft"
        android:padding="11dp"
        android:src="@drawable/ic_close"
        app:tint="@color/vr_text_sub"/>

    <ImageView
        android:contentDescription="@string/vr_accept_request"
        android:id="@+id/vr_rq_accept"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/vr_bg_btn_accept"
        android:padding="10dp"
        android:src="@drawable/ic_mic"
        app:tint="@color/vr_white"/>
</LinearLayout>
