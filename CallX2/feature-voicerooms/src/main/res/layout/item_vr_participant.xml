<?xml version="1.0" encoding="utf-8"?>
<!-- People sheet row -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="50dp"
        android:layout_height="50dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/vr_pp_avatar"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"/>

        <View
            android:id="@+id/vr_pp_online"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/vr_bg_online_dot"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/vr_pp_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/vr_text"
                android:textSize="16sp"/>

            <ImageView
        android:importantForAccessibility="no"
                android:id="@+id/vr_pp_verified"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_verified"
                android:visibility="gone"/>
        </LinearLayout>

        <TextView
            android:id="@+id/vr_pp_role"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/vr_text_sub"
            android:textSize="13sp"/>
    </LinearLayout>

    <ImageView
        android:importantForAccessibility="no"
        android:id="@+id/vr_pp_mic"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/vr_bg_circle_soft"
        android:padding="8dp"
        android:src="@drawable/ic_mic"
        app:tint="@color/vr_primary"/>
</LinearLayout>
