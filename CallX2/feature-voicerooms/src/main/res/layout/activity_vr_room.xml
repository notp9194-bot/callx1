<?xml version="1.0" encoding="utf-8"?>
<!--
  Voice Room screen (screenshot jaisa): top bar → scrollable content
  (banner, topic, speakers, audience, pinned, chat) → fixed bottom
  (input row + action bar).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vr_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


    <!-- ── Top bar (Home screen jaisa hi — consistent navigation) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
        android:contentDescription="@string/vr_minimize_room"
            android:id="@+id/vr_btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/vr_text"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/vr_voice_rooms"
            android:textColor="@color/vr_text"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <ImageView
        android:contentDescription="@string/vr_search_people"
            android:id="@+id/vr_btn_search"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:src="@drawable/ic_search"
            app:tint="@color/vr_text"/>

        <ImageView
        android:contentDescription="@string/vr_more_options"
            android:id="@+id/vr_btn_more_top"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:rotation="90"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/vr_text"/>
    </LinearLayout>

    <!-- ── Content: collapsible header + real chat list ── -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/vr_appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/vr_bg"
            android:clipChildren="false"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <LinearLayout
                android:id="@+id/vr_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp"
                app:layout_scrollFlags="scroll">

            <!-- Banner -->
            <FrameLayout
                android:id="@+id/vr_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/vr_bg_banner"
                android:minHeight="156dp">

                <!-- Premium mic illustration (Canvas) -->
                <com.callx.app.voicerooms.VrMicView
                    android:id="@+id/vr_banner_mic"
                    android:layout_width="124dp"
                    android:layout_height="130dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="124dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:background="@drawable/vr_bg_chip_live"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingEnd="12dp">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/vr_bg_dot_white"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/vr_live"
                                android:textColor="@color/vr_white"
                                android:textSize="14sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/vr_bg_chip_glass"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingEnd="12dp">

                            <ImageView
        android:importantForAccessibility="no"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_group"
                                app:tint="@color/vr_white"/>

                            <TextView
                                android:id="@+id/vr_banner_listeners"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/vr_white"
                                android:textSize="14sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/vr_banner_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:maxLines="2"
                        android:textColor="@color/vr_white"
                        android:textSize="26sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/vr_banner_topic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.92"
                        android:textColor="@color/vr_white"
                        android:textSize="16sp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/vr_bg_chip_glass"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp">

                        <ImageView
        android:importantForAccessibility="no"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_waveform_mini"
                            app:tint="@color/vr_white"/>

                        <TextView
                            android:id="@+id/vr_banner_host"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/vr_white"
                            android:textSize="15sp"/>

                        <ImageView
        android:contentDescription="@string/vr_verified"
                            android:id="@+id/vr_banner_verified"
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_marginStart="5dp"
                            android:src="@drawable/ic_verified_pink"/>
                    </LinearLayout>
                </LinearLayout>

                <ImageView
        android:contentDescription="@string/vr_collapse_banner"
                    android:id="@+id/vr_banner_close"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/vr_bg_circle_glass"
                    android:padding="9dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/vr_white"/>
            </FrameLayout>

            <!-- Topic row -->
            <LinearLayout
                android:id="@+id/vr_topic_row"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/vr_bg_pill_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
        android:importantForAccessibility="no"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_waveform_mini"
                    app:tint="@color/vr_primary"/>

                <TextView
                    android:id="@+id/vr_topic_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/vr_let_s_talk_about"
                    android:textColor="@color/vr_text"
                    android:textSize="16sp"/>

                <ImageView
        android:importantForAccessibility="no"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/vr_primary"/>
            </LinearLayout>

            <!-- Speakers header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
        android:importantForAccessibility="no"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_waveform_mini"
                    app:tint="@color/vr_primary"/>

                <TextView
                    android:id="@+id/vr_speakers_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:textColor="@color/vr_text"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:id="@+id/vr_speakers_see_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/vr_see_all"
                        android:textColor="@color/vr_primary"
                        android:textSize="15sp"/>

                    <ImageView
        android:importantForAccessibility="no"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/vr_primary"/>
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vr_rv_speakers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"/>

            <!-- Audience header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
        android:importantForAccessibility="no"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_group"
                    app:tint="@color/vr_primary"/>

                <TextView
                    android:id="@+id/vr_audience_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/vr_text"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vr_rv_audience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:overScrollMode="never"/>

            <TextView
                android:id="@+id/vr_audience_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/vr_no_listeners_yet_invite"
                android:textColor="@color/vr_text_sub"
                android:textSize="14sp"
                android:visibility="gone"/>

            </LinearLayout>

            <!-- Pinned message -->
            <LinearLayout
                android:id="@+id/vr_pinned_bar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/vr_bg_pill_soft"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="8dp">

                <ImageView
        android:importantForAccessibility="no"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_pin"
                    app:tint="@color/vr_primary"/>

                <TextView
                    android:id="@+id/vr_pinned_by"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/vr_text"
                    android:textSize="15sp"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/vr_surface_stroke"/>

                <TextView
                    android:id="@+id/vr_pinned_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/vr_welcome_to_the_voice"
                    android:textColor="@color/vr_primary"
                    android:textSize="15sp"/>

                <ImageView
        android:contentDescription="@string/vr_dismiss_pinned_message"
                    android:id="@+id/vr_pinned_close"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/vr_primary"/>
            </LinearLayout>

            <!-- Live poll bar (host poll banata hai; tap => vote / results) -->
            <LinearLayout
                android:id="@+id/vr_poll_bar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/vr_bg_pill_soft"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/vr_poll_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:textColor="@color/vr_text"
                    android:textSize="15sp"/>

                <TextView
                    android:id="@+id/vr_poll_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/vr_primary"
                    android:textSize="14sp"/>
            </LinearLayout>
            
        </com.google.android.material.appbar.AppBarLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vr_rv_chat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"/>

            <!-- Chat empty state -->
            <LinearLayout
                android:id="@+id/vr_chat_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="28dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💬"
                    android:textSize="36sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/vr_no_messages_yet_say"
                    android:textColor="@color/vr_text_sub"
                    android:textSize="15sp"/>
            </LinearLayout>
        </FrameLayout>

        <!-- "New messages" pill -->
        <TextView
            android:id="@+id/vr_new_msgs"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/vr_bg_new_msgs"
            android:elevation="6dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/vr_white"
            android:textSize="14sp"
            android:visibility="gone"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- ── Fixed bottom: input row + action bar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vr_bg"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
        android:contentDescription="@string/vr_send_a_gift"
                android:id="@+id/vr_btn_gift"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/vr_bg_circle_primary"
                android:padding="13dp"
                android:src="@drawable/ic_gift"
                app:tint="@color/vr_white"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/vr_bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="8dp">

                <EditText
                    android:id="@+id/vr_et_message"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/vr_say_something"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textColor="@color/vr_text"
                    android:textColorHint="@color/vr_text_sub"
                    android:textSize="16sp"/>

                <ImageView
        android:contentDescription="@string/vr_cd_emoji"
                    android:id="@+id/vr_btn_emoji_send"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@drawable/ic_emoji"
                    app:tint="@color/vr_text"/>
            </LinearLayout>

            <ImageView
        android:contentDescription="@string/vr_cd_mic_mute"
                android:id="@+id/vr_btn_mic"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/vr_bg_circle_primary"
                android:padding="15dp"
                android:src="@drawable/ic_mic"
                app:tint="@color/vr_white"/>
        </LinearLayout>

        <!-- Action bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/vr_bg_bottom_bar"
            android:elevation="6dp"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <LinearLayout
                android:id="@+id/vr_act_raise"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <ImageView
        android:importantForAccessibility="no"
                    android:id="@+id/vr_raise_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/vr_ic_hand"
                    app:tint="@color/vr_text"/>

                <TextView
                    android:id="@+id/vr_raise_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/vr_raise_nhand"
                    android:textColor="@color/vr_text"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/vr_act_poll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <ImageView
        android:importantForAccessibility="no"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_poll"
                    app:tint="@color/vr_text"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/vr_poll"
                    android:textColor="@color/vr_text"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/vr_act_music"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <ImageView
        android:importantForAccessibility="no"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_music_note"
                    app:tint="@color/vr_text"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/vr_music"
                    android:textColor="@color/vr_text"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/vr_act_share"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <ImageView
        android:importantForAccessibility="no"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_share_reel"
                    app:tint="@color/vr_text"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/vr_share"
                    android:textColor="@color/vr_text"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/vr_act_more"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <ImageView
        android:importantForAccessibility="no"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:rotation="90"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/vr_text"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/vr_more"
                    android:textColor="@color/vr_text"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

    <!-- FX overlay: floating hearts / gift burst (touch nahi rokta) -->
    <FrameLayout
        android:id="@+id/vr_fx_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"/>
</FrameLayout>
