<?xml version="1.0" encoding="utf-8"?>
<!-- Ek speaker: purple ring avatar + mic badge + (Host pill) + naam (+ crown) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="84dp"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:clipChildren="false"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:clipChildren="false">

        <!-- speaking pulse (peeche phailta circle) -->
        <View
            android:id="@+id/vr_sp_pulse"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:alpha="0"
            android:background="@drawable/vr_bg_pulse"
            android:visibility="invisible"/>

        <!-- ring (speaking => thicker + glow) -->
        <FrameLayout
            android:id="@+id/vr_sp_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/vr_bg_ring">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/vr_sp_avatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"/>
        </FrameLayout>

        <TextView
            android:id="@+id/vr_sp_host_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/vr_bg_host_pill"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="10dp"
            android:paddingBottom="2dp"
            android:text="@string/vr_host"
            android:textColor="@color/vr_white"
            android:textSize="12sp"
            android:visibility="gone"/>

        <ImageView
        android:importantForAccessibility="no"
            android:id="@+id/vr_sp_mic"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/vr_bg_mic_badge"
            android:padding="6dp"
            android:src="@drawable/ic_mic"
            app:tint="@color/vr_white"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/vr_sp_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxEms="6"
            android:singleLine="true"
            android:textColor="@color/vr_text"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/vr_sp_crown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="👑"
            android:textSize="13sp"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
