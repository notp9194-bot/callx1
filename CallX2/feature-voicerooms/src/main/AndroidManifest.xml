<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application>

        <!-- Voice Rooms home — live rooms list + "Start a room" -->
        <activity
            android:name="com.callx.app.voicerooms.VoiceRoomsHomeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.VoiceRoom"/>

        <!-- Single voice room screen (speakers / audience / chat) -->
        <activity
            android:name="com.callx.app.voicerooms.VoiceRoomActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.VoiceRoom">
            <!-- Room share link: callx://room/{id}  &  https://callx-server.onrender.com/room/{id} -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="callx" android:host="room"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="callx-server.onrender.com"
                      android:pathPrefix="/room/"/>
            </intent-filter>
        </activity>

        <!-- Foreground service: minimize / background me bhi audio + mic chalta rahe -->
        <service
            android:name="com.callx.app.voicerooms.VoiceRoomService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback"/>

    </application>
</manifest>
