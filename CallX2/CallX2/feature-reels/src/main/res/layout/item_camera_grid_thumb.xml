<?xml version="1.0" encoding="utf-8"?>
<!--
    item_camera_grid_thumb.xml
    4-column grid cell in the expanded camera media sheet.
    1dp gap between cells via the 1dp border on the FrameLayout.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#22FFFFFF">

    <ImageView
        android:id="@+id/grid_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:background="#2A2A2A"
        android:scaleType="centerCrop"/>

    <!-- Video duration badge -->
    <TextView
        android:id="@+id/grid_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="4dp"
        android:background="@drawable/bg_video_duration_pill"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:visibility="gone"/>

</FrameLayout>
