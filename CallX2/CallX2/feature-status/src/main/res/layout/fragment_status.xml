<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Search bar row (v51) — modern pill search field + privacy shortcut icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp">

            <!-- Search bar (v50) — modern pill-shaped field, matches the search bar
                 style used across Reels/Chat/X (bg_search_field rounded surface,
                 leading icon, inline clear button) instead of the old boxed
                 Material outline. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_search_field">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="14dp"
                    android:src="@drawable/ic_search"
                    android:alpha="0.6"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:contentDescription="Search"/>

                <EditText
                    android:id="@+id/et_status_search"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="44dp"
                    android:paddingEnd="40dp"
                    android:hint="Search statuses…"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textSize="15sp"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textColor="?attr/colorOnSurface"
                    android:background="@null"/>

                <ImageButton
                    android:id="@+id/btn_status_search_clear"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_close"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:visibility="gone"
                    android:contentDescription="Clear search"/>
            </FrameLayout>

            <!-- Status privacy shortcut (v51) — was only reachable from inside
                 NewStatusActivity before; now one tap from the Status tab too. -->
            <ImageButton
                android:id="@+id/btn_status_privacy"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_shield"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="Who can see my status"/>

        </LinearLayout>

        <!-- Status list (v51) — wrapped in SwipeRefreshLayout for pull-to-refresh -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_status_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_status"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="80dp"/>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <!-- FAB stack: WhatsApp-style — small pencil (edit/text status) above a larger camera FAB -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:gravity="end">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_edit_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_status_edit_pencil"
            app:backgroundTint="@android:color/white"
            app:tint="#4A4A4A"
            app:elevation="3dp"
            android:contentDescription="Text status"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_camera_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_status_camera"
            app:backgroundTint="#25D366"
            app:tint="@android:color/white"
            app:elevation="4dp"
            android:contentDescription="Camera status"/>

    </LinearLayout>

    <!-- Archive shortcut: subtle icon-only, WhatsApp keeps this understated -->
    <ImageButton
        android:id="@+id/btn_status_archive"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:src="@drawable/ic_status_archive"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:tint="?attr/colorOnSurfaceVariant"
        android:contentDescription="Archive"
        android:visibility="visible"/>

    <!-- Scheduled statuses shortcut: sits right next to the Archive icon -->
    <ImageButton
        android:id="@+id/btn_status_scheduled"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="64dp"
        android:layout_margin="16dp"
        android:src="@drawable/ic_schedule"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:tint="?attr/colorOnSurfaceVariant"
        android:contentDescription="Scheduled statuses"
        android:visibility="visible"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
