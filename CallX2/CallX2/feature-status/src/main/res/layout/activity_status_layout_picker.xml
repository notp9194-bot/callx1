<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_status_layout_picker.xml — Screen 1 of the WhatsApp-level Layout
    Picker for Status: pure multi-photo selection, matching the reference
    "Start layout" screen exactly (title + subtitle + Recents dropdown +
    gallery grid). No preview / layout-style row here anymore — tapping
    "Next" now hands off to a genuinely separate screen
    (activity_status_layout_adjust.xml / StatusLayoutAdjustActivity) for
    arranging the collage, instead of the preview appearing inline on this
    same screen.

    Structure:
      ┌──────────────────────────────────────────┐
      │  ← toolbar                       Next    │
      ├──────────────────────────────────────────┤
      │  "Start layout" title / subtitle          │
      ├──────────────────────────────────────────┤
      │  Recents ▾  (folder selector header)      │
      ├──────────────────────────────────────────┤
      │  3-column gallery grid (RecyclerView)     │
      └──────────────────────────────────────────┘
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/layout_picker_root"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ── Toolbar ─────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layout_picker_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:background="#000000">

        <ImageView
            android:id="@+id/btn_layout_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"/>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tv_layout_picker_done"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Next"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_layout_done_btn"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- ── Main vertical layout ────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="56dp">

        <!-- Title subtitle -->
        <TextView
            android:id="@+id/tv_layout_picker_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start layout"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose up to 6 photos for your layout."
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingBottom="12dp"/>

        <!-- ── Recents header with working folder dropdown ─────────────── -->
        <LinearLayout
            android:id="@+id/row_layout_recents"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tv_layout_recents_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recents"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_arrow_right"
                android:rotation="90"
                android:tint="#AAAAAA"
                android:contentDescription="Dropdown"/>

        </LinearLayout>

        <!-- ── Gallery grid ────────────────────────────────────────────── -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_layout_media_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
