<?xml version="1.0" encoding="utf-8"?>
<!--
    item_layout_picker_media.xml — Single cell in the layout picker media grid.
    Shows thumbnail + WhatsApp-style circle checkbox at top-right + selection
    order number + selection dim overlay.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginBottom="1dp"
    android:layout_marginEnd="1dp">

    <!--
        Root height is 0dp on purpose — MediaGridAdapter#onCreateViewHolder
        (StatusLayoutPickerActivity.java) sets an explicit square pixel
        height right after inflate (screenWidth / 3, matching the 3-column
        GridLayoutManager). A plain RecyclerView cell has no LinearLayout
        weight mechanism, so leaving this at 0dp without that code-side
        override — as an earlier version of this file did — renders every
        cell at 0px tall and no thumbnail is ever visible, even though the
        MediaStore query and Glide load both succeed.
    -->

    <ImageView
        android:id="@+id/iv_layout_media_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="#1A1A1A"/>

    <!-- Selection dim overlay -->
    <View
        android:id="@+id/layout_selection_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone"/>

    <!-- Circle checkbox (top-right) -->
    <FrameLayout
        android:id="@+id/fl_layout_check_circle"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp">

        <!-- order number shown when selected -->
        <TextView
            android:id="@+id/tv_layout_selection_order"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"/>

    </FrameLayout>

</FrameLayout>
