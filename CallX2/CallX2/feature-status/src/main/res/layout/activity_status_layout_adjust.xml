<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_status_layout_adjust.xml — Screen 2 of the WhatsApp-level Layout
    Picker for Status: arranging the collage. Reached only after ≥1 photo is
    picked on the "Start layout" selection screen (activity_status_layout_picker.xml)
    and "Next" is tapped — matching the reference app's own two-step flow
    (select screen, then a genuinely separate adjust screen) instead of the
    old behaviour where the preview popped up inline under the same grid.

    BUG FIX: this screen used to duplicate screen 1's whole gallery grid +
    "Recents ▾" dropdown below the preview — but media is already chosen on
    screen 1, so that second selection grid was pure redundant clutter (and
    ate space the preview needed). This screen is layout-only now: pick a
    style, then pinch/pan-adjust each photo in a preview that finally has
    room to breathe. Per-slot photo swapping is still possible — long-press
    any filled cell for a "Replace with Photo / Replace with Video / Delete"
    menu (see StatusLayoutAdjustActivity#showSlotOptionsMenu), and the "+"
    on an empty cell still opens the system picker directly.

    Structure:
      ┌──────────────────────────────────────────┐
      │  ← toolbar                       Done     │
      ├──────────────────────────────────────────┤
      │  "Choose layout" subtitle                 │
      ├──────────────────────────────────────────┤
      │                                            │
      │  StatusLayoutPreviewView  (fills space)   │
      │  long-press a photo → replace/delete      │
      │                                            │
      ├──────────────────────────────────────────┤
      │  ────────────────────────────────────── │
      │  [■] [■│■] [■ ■] [■▬] [■│■] [■]  ←6btns│
      └──────────────────────────────────────────┘
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/layout_adjust_root"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ── Toolbar ─────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layout_adjust_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:background="#000000">

        <ImageView
            android:id="@+id/btn_layout_adjust_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"/>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tv_layout_adjust_done"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Done"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_layout_done_btn"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- ── Main vertical layout ────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="56dp">

        <!-- Title subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose layout"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"/>

        <!-- ── Layout preview — now takes all the space the old gallery
             grid used to occupy, so pinch/pan photo adjustment has real
             room instead of being squeezed into a fixed 220dp strip. ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.callx.app.compose.StatusLayoutPreviewView
                android:id="@+id/layout_preview_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="8dp"/>

            <!-- Small drag handle separator -->
            <View
                android:layout_width="32dp"
                android:layout_height="3dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_drag_handle"
                android:layout_marginBottom="6dp"/>

        </LinearLayout>

        <!-- ── Divider above layout style row ──────────────────────────── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A2A"/>

        <!-- ── Layout style selector row ───────────────────────────────── -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_layout_styles"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
