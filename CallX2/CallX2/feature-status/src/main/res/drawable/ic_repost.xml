<?xml version="1.0" encoding="utf-8"?>
<!--
  Repost / Reshare icon — two circular arrows forming a cycle.
  Matches the "Allow sharing" / repost icon seen in status viewers
  (WhatsApp-style two-arrow recycling symbol).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Top-left arrow: curves from bottom-left to top-right -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M17,1 L21,5 L17,9"/>
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3,11 L3,9 A9,9 0 0,1 21,9"/>

    <!-- Bottom-right arrow: curves from top-right to bottom-left -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M7,23 L3,19 L7,15"/>
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M21,13 L21,15 A9,9 0 0,1 3,15"/>

</vector>
