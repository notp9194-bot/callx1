<?xml version="1.0" encoding="utf-8"?>
<!-- RecyclerView fast-scroller thumb (Recents grid). Pressed = wider/brighter.
     Used for both vertical and horizontal slots: RecyclerView requires all four. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#CC1FA855"/>
            <corners android:radius="4dp"/>
            <size android:width="8dp" android:height="48dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/attach_fast_scroll_thumb"/>
            <corners android:radius="2dp"/>
            <size android:width="4dp" android:height="48dp"/>
        </shape>
    </item>
</selector>
