<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted-glass circle behind the header's trailing icon buttons
     (video call / voice call / more options) — see reference screenshot.
     Ripple gives touch feedback on top of the static translucent fill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="oval">
            <solid android:color="#26FFFFFF"/>
        </shape>
    </item>
</ripple>
