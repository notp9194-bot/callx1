<?xml version="1.0" encoding="utf-8"?>
<!-- WhatsApp-style received bubble: simple solid shape, zero GPU rasterization -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient android:angle="315" android:startColor="@color/chat_bubble_received_start"
        android:endColor="@color/chat_bubble_received_end"/>
    <corners android:topLeftRadius="4dp" android:topRightRadius="18dp"
        android:bottomLeftRadius="18dp" android:bottomRightRadius="18dp"/>
</shape>
