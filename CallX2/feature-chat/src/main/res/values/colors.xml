<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Alias so code can reference R.color.colorPrimary directly (theme attr @/?attr/colorPrimary
         isn't a resolvable resource id at compile time). Keep in sync with core's brand_primary. -->
    <color name="colorPrimary">#0F4C3A</color>

    <!-- v31 Community: tint for the like button once the user has reacted. -->
    <color name="community_like_active">#E91E63</color>

    <!-- v241: Chats-tab quick-access card header — flat solid colors only
         (no gradients/elevation, matches app's existing GPU-perf pattern). -->
    <color name="qa_card_x">#000000</color>
    <color name="qa_card_youtube">#E62117</color>
    <color name="qa_card_games">#6C3CF7</color>
    <color name="qa_card_light">#FFFFFF</color>
    <color name="qa_ring_status">#25D366</color>
</resources>
