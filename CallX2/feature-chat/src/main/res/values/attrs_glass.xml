<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- GlassHeaderLayout: id of the sibling view whose pixels sit behind the header
         (the chat content FrameLayout: wallpaper + messages). Blurred live. -->
    <declare-styleable name="GlassHeaderLayout">
        <attr name="glassSource" format="reference"/>
    </declare-styleable>
    <!-- GlassImageButton: per-button glass look. -->
    <declare-styleable name="GlassImageButton">
        <!-- Full ARGB tint laid over the blurred backdrop (coloured glass). Unset = neutral white glass. -->
        <attr name="glassTint" format="color"/>
        <!-- Corner radius. Unset = perfect circle/pill. -->
        <attr name="glassCornerRadius" format="dimension"/>
        <!-- Shrinks the glass plate inside the view bounds. -->
        <attr name="glassInset" format="dimension"/>
    </declare-styleable>
</resources>
