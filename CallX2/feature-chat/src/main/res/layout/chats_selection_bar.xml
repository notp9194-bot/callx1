<?xml version="1.0" encoding="utf-8"?>
<!-- v949: inflated lazily by ChatsFragment.ensureSelectionBar() (ViewStub) — only needed in selection mode. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_selection_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/brand_primary"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:gravity="center_vertical"
    android:visibility="gone">

    <!-- Cancel button -->
    <TextView
        android:id="@+id/btn_cancel_selection_chats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✕"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:paddingStart="4dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Selected count -->
    <TextView
        android:id="@+id/tv_selected_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:text="0 selected"/>

    <!-- Select All -->
    <TextView
        android:id="@+id/btn_select_all_chats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="All"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Pin/Unpin selected -->
    <TextView
        android:id="@+id/btn_pin_selected_chats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pin"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Mute/unmute selected groups -->
    <TextView
        android:id="@+id/btn_mute_selected_chats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mute"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Archive/unarchive selected groups -->
    <TextView
        android:id="@+id/btn_archive_selected_chats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Archive"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Delete selected -->
    <ImageView
        android:id="@+id/btn_delete_selected_chats"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_delete"
        android:tint="#FFCDD2"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Delete selected"/>

</LinearLayout>
