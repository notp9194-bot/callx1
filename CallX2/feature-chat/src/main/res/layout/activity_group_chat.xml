<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_group_chat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_group_chat"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_scrollFlags="scroll|enterAlways"/>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.callx.app.chat.performance.FastFlingRecyclerView
            android:id="@+id/rv_group_messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp"/>

        <!-- Scheduled send indicator -->
        <View
            android:id="@+id/layout_scheduled_send_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <!-- Input bar -->
        <LinearLayout
            android:id="@+id/layout_input_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <EditText
                android:id="@+id/et_group_message_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Message…"
                android:maxLines="5"
                android:imeOptions="actionSend"/>

            <ImageButton
                android:id="@+id/btn_group_send"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_send"
                android:background="?attr/selectableItemBackgroundBorderless"/>

        </LinearLayout>

        <!-- WHATSAPP-LEVEL FIX: shown instead of the input bar when this
             group's "Send Messages" permission is Admins Only and the
             current user isn't an admin — see
             GroupChatActivity#updateInputLockState(). -->
        <LinearLayout
            android:id="@+id/layout_send_locked_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="14dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_shield"
                android:tint="@color/text_muted"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Only admins can send messages to this group"
                android:textColor="@color/text_muted"
                android:textSize="13sp"/>

        </LinearLayout>

    </LinearLayout>


    <com.google.android.material.button.MaterialButton android:id="@+id/btn_post_anonymous"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Post Anonymously" android:visibility="gone"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
