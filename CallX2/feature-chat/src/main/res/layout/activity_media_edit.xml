<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen chat media editor — comprehensive production-level layout.

  Structure (back to front):
   - mediaContainer: photo/video preview + sticker layer + draw overlay
   - topToolbar: Close / Download / HD / Rotate / Crop / Sticker / Aa / Pencil / [Trim for videos]
   - drawToolsRow: color swatches + brush size slider + Undo + Done
   - emojiRow: (legacy quick-row, kept hidden; main picker is ChatStickerPickerActivity)
   - tvSwipeHint: "Swipe up for filters" hint
   - bottomBar: delete + thumb strip / caption + send
   - filterPanel: slides up from below when filter carousel is open
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootMediaEdit"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="false">

    <!-- ── Photo / Video + overlay layers ───────────────────────────── -->
    <FrameLayout
        android:id="@+id/mediaContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            tools:src="@android:color/darker_gray"/>

        <!-- Video play badge — shown for video items -->
        <ImageView
            android:id="@+id/ivVideoPlayBadge"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:padding="16dp"
            android:background="@drawable/bg_media_edit_video_badge"
            android:src="@drawable/ic_media_edit_send"
            android:visibility="gone"
            android:contentDescription="@null"/>

        <!-- Sticker / text overlay layer -->
        <FrameLayout
            android:id="@+id/stickerLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- Freehand draw overlay -->
        <com.callx.app.conversation.controllers.DrawOverlayView
            android:id="@+id/drawOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- Teardrop brush-width slider (screenshot 2) — overlays the right edge
             of the canvas, shown only while draw mode is active. Drag up = thicker. -->
        <com.callx.app.conversation.controllers.TeardropWidthSlider
            android:id="@+id/drawWidthSlider"
            android:layout_width="46dp"
            android:layout_height="190dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="10dp"
            android:visibility="gone"/>
    </FrameLayout>

    <!-- ── Top toolbar ─────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="10dp"
        android:paddingTop="36dp"
        android:paddingBottom="10dp">

        <!-- Close -->
        <ImageButton
            android:id="@+id/btnEditClose"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_media_edit_toolbtn"
            android:src="@drawable/ic_media_edit_close"
            android:scaleType="center"
            android:padding="9dp"
            android:contentDescription="Close"/>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <!-- Download -->
        <ImageButton
            android:id="@+id/btnEditDownload"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_media_edit_toolbtn"
            android:src="@drawable/ic_media_edit_download"
            android:scaleType="center"
            android:padding="10dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="Save to gallery"/>

        <!-- HD toggle -->
        <TextView
            android:id="@+id/btnEditHd"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="HD"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_hd_toggle_inactive"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Rotate (image only) -->
        <ImageButton
            android:id="@+id/btnEditRotate"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_media_edit_toolbtn"
            android:src="@drawable/ic_media_edit_rotate"
            android:scaleType="center"
            android:padding="9dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="Rotate"/>

        <!-- Flip/mirror (image only) — tap: horizontal, long-press: vertical -->
        <ImageButton
            android:id="@+id/btnEditFlip"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_media_edit_toolbtn"
            android:src="@drawable/ic_media_edit_flip"
            android:scaleType="center"
            android:padding="9dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="Flip"/>

        <!-- Crop (image only) -->
        <ImageButton
            android:id="@+id/btnEditCrop"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_media_edit_toolbtn"
            android:src="@drawable/ic_media_edit_crop"
            android:scaleType="center"
            android:padding="9dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="Crop"/>

        <!-- Adjust — manual Brightness/Contrast/Saturation/Exposure (image only) -->
        <ImageButton
            android:id="@+id/btnEditAdjust"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_media_edit_toolbtn"
            android:src="@drawable/ic_media_edit_adjust"
            android:scaleType="center"
            android:padding="9dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="Adjust"/>

        <!-- Trim (video only — toggled via visibility in code) -->
        <TextView
            android:id="@+id/btnEditTrim"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="✂ Trim"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_hd_toggle_inactive"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Overlay layer ordering for the currently selected sticker/text -->
        <TextView
            android:id="@+id/btnEditLayers"
            android:layout_width="52dp"
            android:layout_height="32dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_media_edit_toolbtn"
            android:gravity="center"
            android:text="Layers"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Arrange overlay layers"/>

    </LinearLayout>

    <!-- ── Emoji quick-row (legacy / hidden) ────────────────────────── -->
    <HorizontalScrollView
        android:id="@+id/emojiRow"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="120dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/emojiRowContent"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center_vertical"/>
    </HorizontalScrollView>

    <!-- ══════════════════════════════════════════════════════════════════
         Draw tools panel — slides up from BOTTOM, fully replaces bottomBar
         while pencil/draw mode is active. Contains:
           Row 1 : color palette (horizontal scroll of circles)
           Row 2 : eraser toggle | brush size label | SeekBar | brush preview dot
           Row 3 : Undo  ·  spacer  ·  Done
         All rows are always visible — no marginBottom hack needed because
         bottomBar is hidden programmatically when this panel shows.
         ══════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/drawToolsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#EE111111"
        android:paddingBottom="20dp"
        android:elevation="8dp"
        android:visibility="gone">

        <!-- ── Row 0: thin top drag handle indicator ── -->
        <View
            android:layout_width="36dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            android:background="#55FFFFFF"/>

        <!-- ── Row 1: Brush tool row (screenshot 1) — color picker circle +
             6 brush types (Pen / Highlighter / Ink / Crayon / Neon / Marker)
             + a "more" button, horizontal scroll ── -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:scrollbars="none"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/drawToolRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Color circle — tap opens the shared rainbow color sheet (core) -->
                <com.callx.app.conversation.controllers.RainbowColorDotView
                    android:id="@+id/btnDrawColorPicker"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Choose color"/>

                <ImageButton
                    android:id="@+id/btnBrushPen"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_brush_pen"
                    android:background="@drawable/bg_media_edit_brush_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Pen"/>

                <ImageButton
                    android:id="@+id/btnBrushHighlighter"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_brush_highlighter"
                    android:background="@drawable/bg_media_edit_toolbtn"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Highlighter"/>

                <ImageButton
                    android:id="@+id/btnBrushInk"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_brush_ink"
                    android:background="@drawable/bg_media_edit_toolbtn"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Ink"/>

                <ImageButton
                    android:id="@+id/btnBrushCrayon"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_brush_crayon"
                    android:background="@drawable/bg_media_edit_toolbtn"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Crayon"/>

                <ImageButton
                    android:id="@+id/btnBrushNeon"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_brush_neon"
                    android:background="@drawable/bg_media_edit_toolbtn"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Neon"/>

                <ImageButton
                    android:id="@+id/btnBrushMarker"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_brush_marker"
                    android:background="@drawable/bg_media_edit_toolbtn"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Marker"/>

                <ImageButton
                    android:id="@+id/btnBrushMore"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_media_edit_plus_tool"
                    android:background="@drawable/bg_media_edit_toolbtn"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="More brushes"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ── Row 1b: Shape tool row — Freehand toggle + Line / Arrow /
             Rectangle / Circle. Selecting a shape draws a straight-edged
             primitive by dragging from start to end point instead of a
             freehand path; tapping Freehand again returns to normal
             drawing. ── -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:scrollbars="none"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/shapeToolRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnShapeFreehand"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_shape_freehand"
                    android:background="@drawable/bg_media_edit_brush_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Freehand"/>

                <ImageButton
                    android:id="@+id/btnShapeLine"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_shape_line"
                    android:background="@drawable/bg_media_edit_toolbtn"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Line"/>

                <ImageButton
                    android:id="@+id/btnShapeArrow"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_shape_arrow"
                    android:background="@drawable/bg_media_edit_toolbtn"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Arrow"/>

                <ImageButton
                    android:id="@+id/btnShapeRect"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_shape_rect"
                    android:background="@drawable/bg_media_edit_toolbtn"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Rectangle"/>

                <ImageButton
                    android:id="@+id/btnShapeCircle"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_shape_circle"
                    android:background="@drawable/bg_media_edit_toolbtn"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Circle"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ── Row 2: Eraser toggle (brush width now lives in the teardrop
             slider overlaid on the canvas edge — screenshot 2) ── -->
        <LinearLayout
            android:id="@+id/brushSizeRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginTop="4dp">

            <!-- Eraser toggle -->
            <ImageButton
                android:id="@+id/btnDrawEraser"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_media_edit_eraser"
                android:scaleType="center"
                android:padding="7dp"
                android:background="@drawable/bg_media_edit_toolbtn"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Eraser"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Drag the slider on the canvas edge to resize the brush"
                android:textColor="#88FFFFFF"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- ── Row 3: Undo · Eraser hint · Done ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="2dp">

            <!-- Undo button -->
            <LinearLayout
                android:id="@+id/btnDrawUndo"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_media_edit_toolbtn"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↩"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_marginEnd="5dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Undo"
                    android:textColor="#DDDDDD"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- Redo button -->
            <LinearLayout
                android:id="@+id/btnDrawRedo"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_media_edit_toolbtn"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↪"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_marginEnd="5dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Redo"
                    android:textColor="#DDDDDD"
                    android:textSize="13sp"/>
            </LinearLayout>

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

            <!-- Clear all strokes -->
            <TextView
                android:id="@+id/btnDrawClear"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Clear"
                android:textColor="#FF6666"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_media_edit_toolbtn"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Done drawing -->
            <TextView
                android:id="@+id/btnDrawDone"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Done"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#40C060"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

    </LinearLayout>

    <!-- ── Bottom bar (delete + thumbs / caption + send) ────────────── -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#EE000000">

        <!-- Top row: delete button + thumbnail strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Delete current item -->
            <ImageButton
                android:id="@+id/btnEditDelete"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_delete"
                android:scaleType="center"
                android:padding="10dp"
                android:background="@drawable/circle_media_edit_delete"
                android:contentDescription="Delete"/>

            <!-- Thumbnail scroll strip -->
            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/thumbStripContent"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"/>
            </HorizontalScrollView>

        </LinearLayout>

        <!-- Bottom row: caption + send -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="16dp">

            <!-- Caption input -->
            <EditText
                android:id="@+id/etCaption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_media_edit_caption_pill"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:hint="Add a caption…"
                android:textColorHint="#77FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:maxLines="3"
                android:inputType="text|textMultiLine"
                android:imeOptions="actionDone"/>

            <!-- Freehand draw -->
            <ImageButton
                android:id="@+id/btnEditDrawBottom"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_media_edit_toolbtn"
                android:src="@drawable/ic_media_edit_draw"
                android:scaleType="center"
                android:padding="9dp"
                android:alpha="0.7"
                android:contentDescription="Draw"/>

            <!-- Sticker picker -->
            <ImageButton
                android:id="@+id/btnEditSticker"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_media_edit_toolbtn"
                android:src="@drawable/ic_media_edit_sticker"
                android:scaleType="center"
                android:padding="9dp"
                android:contentDescription="Add sticker"/>

            <!-- Text overlay -->
            <ImageButton
                android:id="@+id/btnEditText"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_media_edit_toolbtn"
                android:src="@drawable/ic_media_edit_text"
                android:scaleType="center"
                android:padding="9dp"
                android:contentDescription="Add text"/>

            <!-- Send button -->
            <ImageButton
                android:id="@+id/btnEditSend"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_send"
                android:scaleType="center"
                android:padding="10dp"
                android:background="@drawable/bg_media_edit_send_btn"
                android:contentDescription="Send"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ── Swipe-up-for-filters hint chip ───────────────────────────────
         Declared AFTER bottomBar so it draws IN FRONT of it — previously
         this lived before bottomBar in the tree, so bottomBar's own
         near-opaque background (#EE000000, ~142dp tall) painted right
         over it and nobody ever saw the hint. Positioned with enough
         bottom margin to float clear above the bar instead of behind it,
         and gets a one-shot bounce animation (see showCurrentItem()/
         playSwipeHintAttentionBounce()) the first time a photo is shown
         so first-time users actually notice the feature. -->
    <LinearLayout
        android:id="@+id/tvSwipeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="158dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_media_edit_swipe_hint"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/ivSwipeHintArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="↑"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Swipe up for filters"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- ── Filter panel (slides up from below) ──────────────────────── -->
    <LinearLayout
        android:id="@+id/filterPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#EE111111"
        android:visibility="gone">

        <!-- Collapse handle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnFilterCollapse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↓ Filters"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Filter strip -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:scrollbars="none"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:id="@+id/filterStripContent"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp"/>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- ── Adjust panel (Brightness / Contrast / Saturation / Exposure) ──
         Slides up from below, mirrors filterPanel's structure. Each slider
         is centered at 0 (progress 100 of 0..200) so users can push a value
         up or down from "no change". ─────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/adjustPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#EE111111"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <!-- Collapse handle + Reset -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/btnAdjustCollapse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↓ Adjust"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true"/>

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

            <TextView
                android:id="@+id/btnAdjustReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset"
                android:textColor="#FF6666"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Brightness -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <TextView
                android:layout_width="86dp"
                android:layout_height="wrap_content"
                android:text="Brightness"
                android:textColor="#DDDDDD"
                android:textSize="13sp"/>

            <SeekBar
                android:id="@+id/sbAdjustBrightness"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="200"
                android:progress="100"/>

            <TextView
                android:id="@+id/tvAdjustBrightness"
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:gravity="end"/>
        </LinearLayout>

        <!-- Contrast -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <TextView
                android:layout_width="86dp"
                android:layout_height="wrap_content"
                android:text="Contrast"
                android:textColor="#DDDDDD"
                android:textSize="13sp"/>

            <SeekBar
                android:id="@+id/sbAdjustContrast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="200"
                android:progress="100"/>

            <TextView
                android:id="@+id/tvAdjustContrast"
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:gravity="end"/>
        </LinearLayout>

        <!-- Saturation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <TextView
                android:layout_width="86dp"
                android:layout_height="wrap_content"
                android:text="Saturation"
                android:textColor="#DDDDDD"
                android:textSize="13sp"/>

            <SeekBar
                android:id="@+id/sbAdjustSaturation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="200"
                android:progress="100"/>

            <TextView
                android:id="@+id/tvAdjustSaturation"
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:gravity="end"/>
        </LinearLayout>

        <!-- Exposure -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <TextView
                android:layout_width="86dp"
                android:layout_height="wrap_content"
                android:text="Exposure"
                android:textColor="#DDDDDD"
                android:textSize="13sp"/>

            <SeekBar
                android:id="@+id/sbAdjustExposure"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="200"
                android:progress="100"/>

            <TextView
                android:id="@+id/tvAdjustExposure"
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:gravity="end"/>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
