<?xml version="1.0" encoding="utf-8"?>
<!-- Pinned message banner.
     PERF: extracted out of activity_chat.xml and lazily inflated via
     ViewStub (stub_pinned_banner) — only needed once a message is
     actually pinned in this chat; most chats never pin anything. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_pinned_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/bar_background"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:gravity="center_vertical">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📌 Pinned Message"
            android:textColor="#E65100"
            android:textSize="11sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/tv_pinned_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#555555"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>
    <ImageButton
        android:id="@+id/btn_unpin"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Unpin"/>
</LinearLayout>
