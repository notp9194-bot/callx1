<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">
    <!-- Avatar + story ring — same reused pattern as chat header
         (StoryRingGradientDrawable: shared pre-rasterized bitmap, no
         per-frame cost) and dedupe-guarded per-row in ContactsAdapter. -->
    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_person"/>

        <!-- GONE by default — see ContactsAdapter#onBindViewHolder ring logic. -->
        <ImageView
            android:id="@+id/iv_avatar_ring"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:contentDescription="@null"/>
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">
        <TextView
            android:id="@+id/tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>
    <CheckBox
        android:id="@+id/cb_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"/>
</LinearLayout>
