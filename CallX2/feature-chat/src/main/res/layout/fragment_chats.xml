<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Selection action bar (visible on long-press) -->
        <LinearLayout
            android:id="@+id/ll_selection_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/brand_primary"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <!-- Cancel button -->
            <TextView
                android:id="@+id/btn_cancel_selection_chats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:paddingStart="4dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Selected count -->
            <TextView
                android:id="@+id/tv_selected_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="0 selected"/>

            <!-- Select All -->
            <TextView
                android:id="@+id/btn_select_all_chats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Delete selected -->
            <ImageView
                android:id="@+id/btn_delete_selected_chats"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_delete"
                android:tint="#FFCDD2"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Delete selected"/>

        </LinearLayout>

        <!-- Request banner (hidden by default) -->
        <LinearLayout
            android:id="@+id/banner_requests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_request_banner"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_person_add"
                android:padding="8dp"
                android:background="@drawable/bg_circle_white"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_request_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Naye contact requests"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_request_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap karke dekho"
                    android:textColor="#E0E7FF"
                    android:textSize="12sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_request_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="28dp"
                android:gravity="center"
                android:padding="6dp"
                android:textColor="@color/brand_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:background="@drawable/bg_circle_white"/>
        </LinearLayout>

        <!-- v241: Quick-access card header — Add Story / X / YouTube / My Status / Games.
             Flat solid-color cards (no elevation, no gradient — same GPU-perf rule already
             used across the app) inside a plain HorizontalScrollView, so there is no
             RecyclerView/adapter overhead for this fixed 5-item row. The whole container
             gets a single one-shot fade+slide entrance animation from ChatsFragment
             (setupQuickAccessHeader()) — cheap alpha+translationY, no shadows, runs once. -->
        <LinearLayout
            android:id="@+id/header_quick_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <!-- Add Story -->
                    <LinearLayout
                        android:id="@+id/card_add_story"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_qa_card_light">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_status_add"
                                android:tint="@color/brand_primary"/>
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Add story"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:maxLines="1"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- X -->
                    <LinearLayout
                        android:id="@+id/card_x"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_qa_card_x">

                            <ImageView
                                android:id="@+id/iv_qa_x_icon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_x_logo"
                                android:tint="@color/white"
                                android:contentDescription="X"/>

                            <TextView
                                android:id="@+id/tv_qa_x_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:layout_margin="4dp"
                                android:minWidth="14dp"
                                android:minHeight="14dp"
                                android:paddingStart="3dp"
                                android:paddingEnd="3dp"
                                android:textColor="@color/white"
                                android:textSize="8sp"
                                android:gravity="center"
                                android:background="@drawable/bg_unread_badge"
                                android:visibility="gone"/>
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="X"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:maxLines="1"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- YouTube -->
                    <LinearLayout
                        android:id="@+id/card_youtube"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_qa_card_youtube">

                            <ImageView
                                android:id="@+id/iv_qa_yt_icon"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_youtube_logo"
                                android:contentDescription="YouTube"/>

                            <TextView
                                android:id="@+id/tv_qa_yt_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:layout_margin="4dp"
                                android:minWidth="14dp"
                                android:minHeight="14dp"
                                android:paddingStart="3dp"
                                android:paddingEnd="3dp"
                                android:textColor="@color/white"
                                android:textSize="8sp"
                                android:gravity="center"
                                android:background="@drawable/bg_unread_badge"
                                android:visibility="gone"/>
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="YouTube"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:maxLines="1"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- My Status -->
                    <LinearLayout
                        android:id="@+id/card_my_status"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_qa_card_light">

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/iv_qa_mystatus_avatar"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_person"
                                app:civ_border_width="2dp"
                                app:civ_border_color="@color/qa_ring_status"/>
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="My status"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:maxLines="1"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Games -->
                    <LinearLayout
                        android:id="@+id/card_games"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_qa_card_games">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="🎮"
                                android:textSize="22sp"/>
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Games"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:maxLines="1"
                            android:gravity="center"/>
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Feature 1: Chat Folders horizontal chip row.
             Shown only when the user has at least one folder (gone by default).
             "All Chats" chip is always added first programmatically.
             Chips are built/rebuilt in ChatsFragment.setupFolderTabs(). -->
        <HorizontalScrollView
            android:id="@+id/hsv_folders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/ll_folder_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center_vertical"/>

        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chats"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:clipToPadding="false"/>

        <!-- v92: pagination footer — shown briefly while an older page of
             chats loads after the user scrolls near the bottom of the list. -->
        <ProgressBar
            android:id="@+id/pb_loading_more_chats"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Abhi koi chat nahi hai"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Niche FAB se naye contact ko search karke jodo"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

</FrameLayout>
