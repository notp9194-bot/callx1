<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- v949: selection action bar is a ViewStub (7 views + 6 listeners no longer built on every tab open);
             inflated on the first long-press. Layout: chats_selection_bar.xml -->
        <ViewStub
            android:id="@+id/vs_selection_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inflatedId="@+id/ll_selection_bar"
            android:layout="@layout/chats_selection_bar"/>

        <!-- Premium chat/message search — matches the Status tab search field. -->
        <FrameLayout
            android:id="@+id/chat_search_container"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_search_field">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="14dp"
                android:src="@drawable/ic_search"
                android:alpha="0.6"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="Search chats and messages"/>

            <EditText
                android:id="@+id/et_chat_search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="44dp"
                android:paddingEnd="40dp"
                android:hint="Search chats and messages…"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textSize="15sp"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textColor="?attr/colorOnSurface"
                android:background="@null"/>

            <ImageButton
                android:id="@+id/btn_chat_search_clear"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_close"
                android:tint="?attr/colorOnSurfaceVariant"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:visibility="gone"
                android:contentDescription="Clear chat search"/>
        </FrameLayout>

        <!-- v251: Quick-access card header (Add Story / My Status / Games)
             removed — moved to 3-dot overflow menu (MainActivity, X/YouTube/
             Games only; Add Story and My Status dropped per user request).
             See setupQuickAccessHeader() removal in ChatsFragment.java. -->

        <!-- Unified list filter chips: All / Unread / Groups / Archived.
             Groups used to be a separate tab — they now live in this list
             and this row is how the user narrows to just groups.
             Built in ChatsFragment.setupChatFilterChips(). -->
        <HorizontalScrollView
            android:id="@+id/hsv_chat_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingTop="6dp"
            android:paddingBottom="2dp"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/ll_chat_filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center_vertical"/>

        </HorizontalScrollView>

        <!-- Feature 1: Chat Folders horizontal chip row.
             Shown only when the user has at least one folder (gone by default).
             "All Chats" chip is always added first programmatically.
             Chips are built/rebuilt in ChatsFragment.setupFolderTabs(). -->
        <HorizontalScrollView
            android:id="@+id/hsv_folders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/ll_folder_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center_vertical"/>

        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chats"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:clipToPadding="false"/>

        <TextView
            android:id="@+id/tv_chat_search_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:text="Koi chat ya message nahi mila"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone"/>

        <!-- v92: pagination footer — shown briefly while an older page of
             chats loads after the user scrolls near the bottom of the list. -->
        <ViewStub
            android:id="@+id/vs_loading_more_chats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:inflatedId="@+id/pb_loading_more_chats"
            android:layout="@layout/chats_loading_more"/>

    </LinearLayout>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Abhi koi chat nahi hai"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Niche FAB se naye contact ko search karke jodo"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

</FrameLayout>
