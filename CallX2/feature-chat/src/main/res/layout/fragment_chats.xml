<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Selection action bar (visible on long-press) -->
        <LinearLayout
            android:id="@+id/ll_selection_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/brand_primary"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <!-- Cancel button -->
            <TextView
                android:id="@+id/btn_cancel_selection_chats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:paddingStart="4dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Selected count -->
            <TextView
                android:id="@+id/tv_selected_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="0 selected"/>

            <!-- Select All -->
            <TextView
                android:id="@+id/btn_select_all_chats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Delete selected -->
            <ImageView
                android:id="@+id/btn_delete_selected_chats"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_delete"
                android:tint="#FFCDD2"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Delete selected"/>

        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════════════════
             NEW v241: Modern Chats header — UI ONLY for now.
             Wiring (click listeners, real avatar/name, live counts on the
             quick-filter chips) will be hooked up in a follow-up pass.
             Nothing below this block was touched — all existing ids,
             features and logic (selection bar, folders, pagination,
             empty state) are unchanged.
        ══════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/header_chats_modern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <!-- Logo mark -->
            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_header_logo_circle">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_callx_logo_mark"
                    android:contentDescription="CallX"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CallX"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chat • Connect • Share"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_search_chats_modern"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_search"
                android:tint="@color/text_primary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Search"/>

            <ImageButton
                android:id="@+id/btn_add_contact_chats_modern"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_person_add"
                android:tint="@color/text_primary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Add contact"/>

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/iv_avatar_chats_modern"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    app:civ_border_width="1.5dp"
                    app:civ_border_color="@color/brand_primary"/>

                <View
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_online_dot"/>
            </FrameLayout>

        </LinearLayout>

        <!-- Shortcuts row: Add story / X / YouTube / My status / Games.
             New ids, self-contained — not wired to click logic yet. -->
        <HorizontalScrollView
            android:id="@+id/hsv_shortcuts_chats_modern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <!-- Add story -->
                <LinearLayout
                    android:id="@+id/shortcut_add_story_modern"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_dashed_circle_green">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_status_add"
                            android:tint="@color/brand_primary"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Add story"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>

                <!-- X -->
                <LinearLayout
                    android:id="@+id/shortcut_x_modern"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_shortcut_x">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_x_logo"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="X"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>

                <!-- YouTube -->
                <LinearLayout
                    android:id="@+id/shortcut_youtube_modern"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_shortcut_youtube">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_youtube_logo"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="YouTube"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>

                <!-- My status -->
                <LinearLayout
                    android:id="@+id/shortcut_my_status_modern"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/iv_my_status_avatar_modern"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/ic_person"
                            app:civ_border_width="2dp"
                            app:civ_border_color="@color/brand_primary"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="My status"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>

                <!-- Games -->
                <LinearLayout
                    android:id="@+id/shortcut_games_modern"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_shortcut_games">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🎮"
                            android:textSize="22sp"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Games"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Quick-filter chips row: All Chats / Unread / Groups / Favorites + filter icon.
             New, always-visible — separate from the existing hsv_folders custom-folder
             bar below (that one stays gone-by-default, untouched). UI only for now:
             counts are static placeholders until wired to real data. -->
        <HorizontalScrollView
            android:id="@+id/hsv_quick_filters_modern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/chip_all_chats_modern"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All Chats  8"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@color/brand_primary"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chip_unread_modern"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unread  3"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:background="@drawable/bg_filter_chip_unselected"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chip_groups_modern"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Groups  1"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:background="@drawable/bg_filter_chip_unselected"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chip_favorites_modern"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="♡ Favorites"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:background="@drawable/bg_filter_chip_unselected"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <ImageButton
                    android:id="@+id/btn_filter_chats_modern"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_filter"
                    android:tint="@color/text_secondary"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Filter"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Request banner (hidden by default) -->
        <LinearLayout
            android:id="@+id/banner_requests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_request_banner"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_person_add"
                android:padding="8dp"
                android:background="@drawable/bg_circle_white"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_request_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Naye contact requests"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_request_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap karke dekho"
                    android:textColor="#E0E7FF"
                    android:textSize="12sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_request_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="28dp"
                android:gravity="center"
                android:padding="6dp"
                android:textColor="@color/brand_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:background="@drawable/bg_circle_white"/>
        </LinearLayout>

        <!-- Feature 1: Chat Folders horizontal chip row.
             Shown only when the user has at least one folder (gone by default).
             "All Chats" chip is always added first programmatically.
             Chips are built/rebuilt in ChatsFragment.setupFolderTabs(). -->
        <HorizontalScrollView
            android:id="@+id/hsv_folders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/ll_folder_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center_vertical"/>

        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chats"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:clipToPadding="false"/>

        <!-- v92: pagination footer — shown briefly while an older page of
             chats loads after the user scrolls near the bottom of the list. -->
        <ProgressBar
            android:id="@+id/pb_loading_more_chats"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Abhi koi chat nahi hai"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Niche FAB se naye contact ko search karke jodo"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

</FrameLayout>
