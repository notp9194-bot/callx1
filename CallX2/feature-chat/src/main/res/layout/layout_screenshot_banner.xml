<?xml version="1.0" encoding="utf-8"?>
<!-- ══════════════════════════════════════════════════════════════
     SCREENSHOT BANNER — Snapchat-style red pill that slides in
     from the top when the partner takes a screenshot of this chat.
     Shows: [avatar] "Rahul ne screenshot liya 📸"
     Auto-hides after 3 s with a slide-up + fade-out.
     Driven by ChatScreenshotNotifier#showScreenshotBanner.
     PERF: extracted out of activity_chat.xml and lazily inflated via
     ViewStub (stub_screenshot_banner) — most chat sessions never see
     a screenshot event, so this never inflates on a normal chat open.
     ══════════════════════════════════════════════════════════════ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_screenshot_banner"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="top|center_horizontal"
    android:layout_marginTop="76dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_screenshot_banner"
    android:elevation="16dp"
    android:translationZ="16dp"
    android:paddingStart="8dp"
    android:paddingEnd="16dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/iv_screenshot_avatar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_person"
        app:civ_border_width="1.5dp"
        app:civ_border_color="#FFCCCC"/>

    <!-- Camera flash icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:text="📸"
        android:textSize="13sp"
        android:importantForAccessibility="no"/>

    <TextView
        android:id="@+id/tv_screenshot_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:maxWidth="200dp"
        android:text="ne screenshot liya"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"/>

</LinearLayout>
