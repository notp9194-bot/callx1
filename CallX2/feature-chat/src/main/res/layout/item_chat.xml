<?xml version="1.0" encoding="utf-8"?>
<!--
    item_chat.xml — v947 flat row (10 views -> 5)

    BEFORE (v946):  FrameLayout(bg_chat_row) → LinearLayout → [ FrameLayout(58dp) → {StoryRingView, CircleImageView,
                    ViewStub}, ChatRowContentView, LinearLayout(ll_meta_normal) → {UnreadBadgeView, CallButtonsView} ]
    AFTER  (v947):  FrameLayout → LinearLayout → [ ChatRowAvatarView, ChatRowContentView, ChatRowMetaView ]

      • ChatRowAvatarView — story ring + avatar bitmap + border + selection scrim/check, ONE canvas view (no
        CircleImageView / Glide target / ViewStub per row).
      • ChatRowMetaView   — unread pill + voice/video call strip, ONE canvas view (no wrapper LinearLayout).
      • No android:background on the root: the old bg_chat_row drawable was replaced by a ColorDrawable on the first
        bind of EVERY row anyway (a wasted drawable + invalidate). The row tint (selected / special request) is now
        a single per-ViewHolder ColorDrawable attached only while a tint is active (ChatListAdapter.applyRowBg).
      • Foreground ripple unchanged (independent of the tint).

    Geometry is identical to v946 (padding 14dp, avatar box 58dp, content marginStart 14dp, meta marginStart 8dp),
    so ChatListTextPrecompute's width math is unchanged.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:foreground="@drawable/fg_chat_row_ripple">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <com.callx.app.chatlist.canvas.ChatRowAvatarView
            android:id="@+id/view_avatar"
            android:layout_width="58dp"
            android:layout_height="58dp"/>

        <com.callx.app.chatlist.canvas.ChatRowContentView
            android:id="@+id/view_row_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"/>

        <com.callx.app.chatlist.canvas.ChatRowMetaView
            android:id="@+id/view_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>

    </LinearLayout>
</FrameLayout>
