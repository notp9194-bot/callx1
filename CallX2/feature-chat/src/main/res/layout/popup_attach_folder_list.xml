<?xml version="1.0" encoding="utf-8"?>
<!--
    Content view for the "Recents ▾" dropdown PopupWindow (see
    AttachSheetFolderPicker). A rounded white card, elevated above the
    sheet, listing every on-device folder — same look as the reference
    screenshot's Recents/Camera/Videos/Screenshots/Downloads/WhatsApp
    dropdown. Height is capped at runtime (see AttachSheetFolderPicker)
    to roughly 60% of the sheet so it never runs off-screen on short
    folder lists or overflows on long ones — the RecyclerView itself
    scrolls internally past that cap.

    MaterialCardView instead of androidx.cardview.widget.CardView since
    feature-chat already depends on com.google.android.material (which
    ships MaterialCardView) and doesn't otherwise pull in the separate
    androidx.cardview artifact.

    BUG FIX: cardBackgroundColor was "?attr/colorSurface" — resolving that
    attr requires the inflating Context's theme to actually define it
    (only Theme.CallX does; several activities in this module, e.g.
    MediaEditActivity/ChatVideoTrimActivity/MediaCropActivity(core)/
    ChatStickerPickerActivity, are manifest-themed as plain
    Theme.AppCompat.NoActionBar, which has no colorSurface at all). If this
    popup is ever inflated against one of those Contexts, MaterialCardView's
    constructor crashes with UnsupportedOperationException while resolving
    the attr. Switched to the concrete @color/surface_card resource — same
    white/black day/night values colorSurface already points to, but
    resolved directly instead of through the current theme, so this card
    renders correctly no matter which Activity's Context inflated it.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="18dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="@color/surface_card"
    app:strokeWidth="0dp">

    <com.callx.app.conversation.controllers.MaxHeightRecyclerView
        android:id="@+id/folder_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:overScrollMode="never"
        android:clipToPadding="false"/>

</com.google.android.material.card.MaterialCardView>
