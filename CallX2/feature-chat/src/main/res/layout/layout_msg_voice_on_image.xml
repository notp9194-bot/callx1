<?xml version="1.0" encoding="utf-8"?>
<!--
  layout_msg_voice_on_image.xml (v425) — lazily inflated legacy caption overlay for
  the View-based image bubble (v849: the old voice play-badge was removed —
  image+voice is Canvas-only: photo + static waveform strip) (item_message_sent/received).
  Root is a match_parent FrameLayout so the children keep the exact same
  bottom|start / bottom gravity geometry they had as direct children of
  content_frame. Non-clickable root => touches fall through to the photo.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
        Feature: Voice Caption on Photo — WhatsApp-style caption strip
        for the legacy image bubble (used whenever m.voiceUrl is set,
        see MessagePagingAdapter's "image" bind case / isCanvasEligible).
        Mirrors MediaGroupLayoutHelper's group-caption pattern: a
        bottom-pinned gradient scrim + white text, OVERLAPPING the
        photo rather than a separate row below it. Both gone by
        default; bindImageCaptionOnLegacyBubble() shows them only
        when m.caption is non-empty.
    -->
    <View
        android:id="@+id/view_image_caption_scrim"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_image_caption_scrim"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tv_image_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="6dp"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:maxLines="3"
        android:ellipsize="end"
        android:visibility="gone"/>

</FrameLayout>
