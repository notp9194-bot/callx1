<?xml version="1.0" encoding="utf-8"?>
<!-- Scheduled messages banner — shows count of pending scheduled sends.
     PERF: extracted out of activity_chat.xml and lazily inflated via
     ViewStub (stub_scheduled_banner) — only needed once a message is
     actually scheduled in this chat; most chats never use scheduled
     send. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_scheduled_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/bar_background"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱ Scheduled"
            android:textColor="#1565C0"
            android:textSize="11sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/tv_scheduled_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#555555"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_timer"
        app:tint="#1565C0"/>
</LinearLayout>
