<?xml version="1.0" encoding="utf-8"?>
<com.callx.app.chat.ui.ReplyBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_reply_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/chat_reply_bar_desc"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_chat_reply_card"
        android:clipToOutline="true">

        <View
            android:id="@+id/view_reply_accent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/brand_primary"/>

        <LinearLayout
            android:id="@+id/ll_reply_bar_texts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="32dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tv_reply_bar_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/brand_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_reply_bar_type"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    android:importantForAccessibility="no"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tv_reply_bar_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:maxLines="3"
                    android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_reply_bar_thumb"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            android:visibility="gone"/>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_cancel_reply"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:paddingStart="21dp"
        android:paddingBottom="21dp"
        android:paddingTop="11dp"
        android:paddingEnd="11dp"
        android:src="@drawable/ic_close"
        android:scaleType="fitCenter"
        android:background="@null"
        app:tint="@color/text_secondary"
        android:contentDescription="@string/chat_reply_cancel"/>
</com.callx.app.chat.ui.ReplyBarLayout>
