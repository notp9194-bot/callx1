<?xml version="1.0" encoding="utf-8"?>
<!--
    layout_msg_reel_share.xml — Compact bubbleless reel card (Instagram/WhatsApp style).

    • No bubble background — ll_bubble bg is set to null at runtime for reel_share type.
    • 165dp wide × 293dp tall — 9:16 vertical aspect ratio for proper mobile reel format.
    • Mini video player card (165×294dp, 40% smaller than peek player) displayed above the reel thumbnail card.
    • NO blur background, NO popup — inline player embedded directly in message.
    • Rounded corners (12dp) via bg_media_card + clipToOutline.
    • Timestamp + tick overlays from the parent ll_msg_footer (bottom|end in FrameLayout).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_reel_share"
    android:layout_width="165dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true">

    <!-- Mini video player card — 40% smaller than peek player (165×294dp vs 331×475dp) -->
    <!-- Hidden by default, shown when reel is tapped (no blur background, inline in message) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_mini_player"
        android:layout_width="165dp"
        android:layout_height="294dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#000000"
        app:cardPreventCornerOverlap="true"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- ExoPlayer/Media3 PlayerView — use generic FrameLayout as placeholder -->
            <!-- Actual PlayerView will be inflated dynamically in code -->
            <FrameLayout
                android:id="@+id/mini_player_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000">
                
                <!-- Loading indicator -->
                <ProgressBar
                    android:id="@+id/mini_player_loading"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="#FFFFFF"
                    android:visibility="gone"/>
            </FrameLayout>

            <!-- Mute status badge (top-left corner) -->
            <ImageView
                android:id="@+id/mini_mute_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:src="@drawable/ic_volume_off"
                android:tint="#FFFFFF"
                android:visibility="gone"
                android:contentDescription="Muted"/>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Main reel share thumbnail card with 9:16 aspect ratio -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="293dp"
        android:background="@drawable/bg_media_card"
        android:clipToOutline="true">

        <!-- Thumbnail -->
        <ImageView
            android:id="@+id/iv_reel_share_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#1A1A1A"/>

        <!-- Top gradient — fades thumbnail so avatar/username is readable -->
        <View
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="top"
            android:background="@drawable/gradient_reel_top"/>

        <!-- Bottom gradient — fades thumbnail so caption/label is readable -->
        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_reel_bottom"/>

        <!-- Header: avatar + username -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="7dp">

            <!-- Circular avatar -->
            <ImageView
                android:id="@+id/iv_reel_share_avatar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_circle_avatar_placeholder"
                android:clipToOutline="true"
                android:outlineProvider="bounds"/>

            <TextView
                android:id="@+id/tv_reel_share_username"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="username"
                android:shadowColor="#AA000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"/>

        </LinearLayout>

        <!-- Play icon — centered, no background box -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="▶"
            android:textSize="28sp"
            android:textColor="#DDFFFFFF"
            android:shadowColor="#AA000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"/>

        <!-- Bottom: caption + Reels label -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="36dp"
            android:paddingBottom="7dp">

            <TextView
                android:id="@+id/tv_reel_share_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#EEFFFFFF"
                android:textSize="10sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone"
                android:shadowColor="#AA000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="⬡  Reels"
                android:textColor="#CCFFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:shadowColor="#AA000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"/>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
