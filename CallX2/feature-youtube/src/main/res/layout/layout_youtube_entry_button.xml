<?xml version="1.0" encoding="utf-8"?>
<!--
  YouTube Entry Button — now rendered as a quick-action card (icon circle +
  label), matching the other cards in the header row. Same view IDs as before
  (iv_yt_entry_avatar / ll_yt_entry_strip / tv_yt_entry_badge) so
  MainActivity's existing avatar-load / badge / slide-in-animation logic
  keeps working unchanged.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/yt_entry_root"
    android:layout_width="76dp"
    android:layout_height="94dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_quickaction_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp">

            <!-- Red brand circle with the YouTube play logo -->
            <View
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_yt_brand"/>

            <ImageView
                android:id="@+id/iv_yt_entry_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_youtube_logo"
                android:contentDescription="YouTube"/>

            <!--
              Animated element — previously slid the strip out; now wraps the
              small channel-avatar preview badge and still gets the same
              translationX slide-in on load.
            -->
            <FrameLayout
                android:id="@+id/ll_yt_entry_strip"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/iv_yt_entry_avatar"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:elevation="4dp"
                    android:src="@drawable/ic_person"
                    app:civ_border_width="2dp"
                    app:civ_border_color="@android:color/white"/>
            </FrameLayout>

            <!-- Notification badge — shows unread YouTube notification count -->
            <TextView
                android:id="@+id/tv_yt_entry_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginEnd="-4dp"
                android:layout_marginTop="-4dp"
                android:minWidth="16dp"
                android:minHeight="16dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:gravity="center"
                android:elevation="6dp"
                android:background="@drawable/bg_yt_badge"
                android:visibility="gone"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="YouTube"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
    </LinearLayout>

</FrameLayout>
